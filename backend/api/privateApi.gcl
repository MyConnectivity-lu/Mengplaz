@expose
@permission("admin")
fn promoteRecord(record: node<POIRecordProvider>, streetIdx: String) {
    var ts = Traffic_Service::start(promoteRecord);

    if (record->getLinkedGolden() != null) {
        throw "This record is already linked to a golden Record";
    }
    record->promoteToGolden(streetIdx);
    ts.end();
}

@expose
@permission("admin")
fn linkRecords(nGolden: node<POIRecordProvider>, nOther: node<POIRecordProvider>) {
    var ts = Traffic_Service::start(linkRecords);

    var golden = *nGolden;
    if (golden is GoldenPointOfInterest) {
        if (golden.linkedRecords.index_of(nOther) == -1) {
            golden.linkedRecords.add(nOther);
        }
    }

    var other = *nOther;
    other.linkToGolden(nGolden as node<GoldenPointOfInterest>);
    ts.end();
}

@expose
@permission("admin")
fn linkAllRecords(goldens: Array<node<POIRecordProvider>>, others: Array<node<POIRecordProvider>>) {
    var ts = Traffic_Service::start(linkAllRecords);

    for (i, nGolden in goldens) {
        linkRecords(nGolden, others[i]);
    }
    ts.end();
}

@expose
@permission("admin")
fn unlinkRecord(nOther: node<POIRecordProvider>) {
    var ts = Traffic_Service::start(unlinkRecord);

    var other = *nOther;
    other.unlinkGolden(nOther);
    ts.end();
}

@expose
@permission("admin")
fn mergePositionsToGolden(others: Array<node<POIRecordProvider>>) {
    var ts = Traffic_Service::start(mergePositionsToGolden);

    for (_, nOther in others) {
        var nGolden = nOther->getLinkedGolden();
        if (nGolden != null && nGolden->primaryLocation == null) {
            var g = nOther->toMengplazRecord().primaryLocation;
            if (g != null) {
                golden_pois_by_geo.set(g, nGolden);
                nGolden->primaryLocation = g;
            }
        }
    }
    ts.end();
}
