@expose
@permission("admin")
fn promoteRecord(sourceRecord: node<AddressRecordProvider>, streetIdx: String) {
    if (sourceRecord->getLinkedGolden() != null) {
        throw "This record is already linked to a golden Record";
    }
    var nGolden = sourceRecord->promoteToGolden(streetIdx);
    sourceRecord->linkToGolden(nGolden);

    var geoScore: float?;
    if (sourceRecord->toSearchItem().coordinates != null) {
        geoScore = 1.0;
    }
    var reconScore = node<ReconciliationCandidateScore> {
        ReconciliationCandidateScore {
            cityScore: 1.0,
            geoScore: geoScore,
            numberScore: 1.0,
            overallScore: 1.0,
            postcodeScore: 1.0,
            streetScore: 1.0
        }
    };

    nGolden->linkedRecords.add(LinkedRecordEntry { record: sourceRecord, score: 1.0, detailedScore: reconScore });

    var newQuality = GoldenServices::computeQuality(nGolden->linkedRecords);
    nGolden->quality.setAt(time::now(), QualityEvent {
        score: newQuality,
        sourceRecord: sourceRecord,
        eventType: QualityEventType::link
    });

    var source = sourceRecord->getSource();
    source->reconciliationReport->unlinked.remove(sourceRecord);

    source->reconciliationReport->linked.set(sourceRecord, ReconciliationCandidate {
        candidateRecord: nGolden,
        detailedScore: reconScore
    });
}

@volatile
type LinkParameters {
    addCityAlias: bool;
    addStreetAlias: bool;
    updateSimilarStreetMismatch: bool?;
}

@expose
@permission("admin")
fn linkRecords(
    sourceRecord: node<AddressRecordProvider>,
    candidateRecord: node<AddressRecordProvider>,
    params: LinkParameters?
) {
    var source = sourceRecord->getSource();
    var candidates = source->reconciliationReport->unlinked.get(sourceRecord);
    var score: float = 1.0;
    var reconScore: node<ReconciliationCandidateScore>?;
    var foundCandidate = false;
    for (_, candidate in candidates?) {
        if (candidate.candidateRecord == candidateRecord) {
            var cCandidate = clone(candidate);
            if (candidate.score != null) {
                reconScore = node<ReconciliationCandidateScore> { clone(candidate.score) };
                cCandidate.detailedScore = reconScore;
            }
            source->reconciliationReport->linked.set(sourceRecord, cCandidate);
            score = candidate.score?.overallScore ?? 1.0;
            foundCandidate = true;
            break;
        }
    }

    // The record came from a search rather than a reconciliation, so it carries no score.
    if (foundCandidate == false) {
        var searchParams = SearchParameters::default();
        var item = sourceRecord->toSearchItem();
        var nCandidate = candidateRecord as node<GoldenAddress>;
        var cityScore = 0.0;
        var streetScore = 0.0;
        if (nCandidate->street != null) {
            cityScore = GoldenServices::computeCityScore(item.city, nCandidate->street->city);
            streetScore = GoldenServices::computeStreetScore(item.street, nCandidate->street->name);
        }
        var geoScore = GoldenServices::computeGeoScore(
            item.coordinates,
            nCandidate->primaryLocation,
            searchParams.geoParams
        )
            ?? 0.0;
        var postcodeScore = GoldenServices::computePostcodeScore(
            item.postcode,
            nCandidate->postcode,
            searchParams.postcodeMaxDistance
        );
        var numberScore = GoldenServices::computeNumberScore(
            item.number,
            item.multipleCode,
            nCandidate->number,
            nCandidate->multipleCode
        );
        var overallScore = GoldenServices::computeOverallScore(
            cityScore,
            streetScore,
            numberScore,
            postcodeScore,
            geoScore,
            searchParams.weights
        );
        reconScore = node<ReconciliationCandidateScore> {
            ReconciliationCandidateScore {
                cityScore: cityScore,
                streetScore: streetScore,
                numberScore: numberScore,
                postcodeScore: postcodeScore,
                geoScore: geoScore,
                overallScore: overallScore,
            }
        };
        score = overallScore;
        source->reconciliationReport->linked.set(sourceRecord, ReconciliationCandidate {
            candidateRecord: candidateRecord,
            detailedScore: reconScore
        });
    }

    source->reconciliationReport->unlinked.remove(sourceRecord);

    sourceRecord->linkToGolden(candidateRecord as node<GoldenAddress>);

    var golden = *candidateRecord;
    if (golden is GoldenAddress) {
        var found = false;
        for (_, entry in golden.linkedRecords) {
            if (entry.record == sourceRecord) {
                found = true;
                break;
            }
        }

        if (!found) {
            golden.linkedRecords.add(LinkedRecordEntry {
                record: sourceRecord,
                score: score,
                detailedScore: reconScore
            });

            if (params?.addStreetAlias == true) {
                var street = sourceRecord->getStreet();
                if (street != null) {
                    golden.addStreetAlias(street);
                }
            }
            if (params?.addCityAlias == true) {
                var city = sourceRecord->getCity();
                if (city != null) {
                    golden.addCityAlias(city);
                }
            }

            var newQuality = GoldenServices::computeQuality(golden.linkedRecords);
            golden.quality.setAt(time::now(), QualityEvent {
                score: newQuality,
                sourceRecord: sourceRecord,
                eventType: QualityEventType::link
            });
        }
    }

    if (params?.updateSimilarStreetMismatch == true) {
        var tmpMap = Map<node<AddressRecordProvider>, ReconciliationCandidate> {};
        var sStreet = sourceRecord->getStreet();
        var gStreet = golden.getStreet();
        for (s, candidates in source->reconciliationReport->unlinked) {
            if (s->getStreet() == sStreet) {
                for (_, c in candidates) {
                    if (c.candidateRecord->getStreet() == gStreet) {
                        tmpMap.set(s, clone(c));
                        break;
                    }
                }
            }
        }
        for (key, value in tmpMap) {
            value.mismatch = null;
            source->reconciliationReport->unlinked.set(key, Array<ReconciliationCandidate> { value });
        }
    }
}

@expose
@permission("admin")
fn unlinkRecord(sourceRecord: node<AddressRecordProvider>) {
    var nGolden = sourceRecord->getLinkedGolden();
    if (nGolden != null) {
        // TODO Should the aliases be removed? That needs tracking which linked record added
        // the alias.
        for (i, entry in nGolden->linkedRecords) {
            if (entry.record == sourceRecord) {
                nGolden->linkedRecords.remove(i);
                break;
            }
        }

        var newQuality = GoldenServices::computeQuality(nGolden->linkedRecords);
        nGolden->quality.setAt(time::now(), QualityEvent {
            score: newQuality,
            sourceRecord: sourceRecord,
            eventType: QualityEventType::unlink
        });
    }

    sourceRecord->unlinkGolden();
    var source = sourceRecord->getSource();
    //TODO? removes it from the linked but we dont add it to the unlinked, It will require a new recompute to get it back, maybe we should ?
    source->reconciliationReport->linked.remove(sourceRecord);
}

@expose
@permission("admin")
fn linkAllFullMatched(source: node<DataSource>, recordIds: Array<String>) {
    var report = source->reconciliationReport;
    var index = source->getIndex();
    for (_, recordId in recordIds) {
        var sourceRecord = index.get(recordId);
        if (sourceRecord == null) {
            continue;
        }
        var candidates = report->unlinked.get(sourceRecord);
        if (candidates?.size() == 1) {
            // TODO? We assume that since this function only gets called if 100% match no need to link aliases
            linkRecords(sourceRecord, candidates!![0].candidateRecord, LinkParameters {
                addCityAlias: false,
                addStreetAlias: false
            });
        }
    }
}

/// Batch links reconciled records to their best Golden candidate based on score rules.
/// All scores are expressed on a 0-100 scale.
///  - links every unlinked record whose best candidate overall score is >= `globalScore`;
///  - each optional per-field score (`geoScore`, `cityScore`, `streetScore`, `numberScore`,
///    `postcodeScore`), when provided, adds a further constraint: the best candidate's matching
///    field score must be >= the given value. Pass null to ignore that field.
/// `globalScore` cannot be lower than 80. Returns the number of records linked.
@expose
@permission("admin")
fn batchLinkByScore(
    source: node<DataSource>,
    globalScore: float,
    geoScore: float?,
    cityScore: float?,
    streetScore: float?,
    numberScore: float?,
    postcodeScore: float?
): int {
    if (globalScore < 80.0) {
        throw "globalScore cannot be lower than 80";
    }
    var threshold = globalScore / 100.0;

    var report = source->reconciliationReport;

    // Collect first to avoid mutating the unlinked map while iterating it.
    var toLink = Map<node<AddressRecordProvider>, node<AddressRecordProvider>> {};
    for (record, candidates in report->unlinked) {
        var bestCandidate: ReconciliationCandidate?;
        var bestScore = 0.0;
        for (_, candidate in candidates) {
            var s = candidate.score?.overallScore;
            if (s != null && s >= bestScore) {
                bestScore = s;
                bestCandidate = candidate;
            }
        }
        if (bestCandidate != null && bestScore >= threshold) {
            var sc = bestCandidate.score;
            var ok = true;
            if (ok && geoScore != null) {
                var g = sc?.geoScore;
                ok = g != null && g >= geoScore / 100.0;
            }
            if (ok && cityScore != null) {
                ok = sc != null && sc.cityScore >= cityScore / 100.0;
            }
            if (ok && streetScore != null) {
                ok = sc != null && sc.streetScore >= streetScore / 100.0;
            }
            if (ok && numberScore != null) {
                ok = sc != null && sc.numberScore >= numberScore / 100.0;
            }
            if (ok && postcodeScore != null) {
                ok = sc != null && sc.postcodeScore >= postcodeScore / 100.0;
            }
            if (ok) {
                toLink.set(record, bestCandidate.candidateRecord);
            }
        }
    }

    var count = 0;
    for (record, candidate in toLink) {
        linkRecords(record, candidate, LinkParameters { addCityAlias: false, addStreetAlias: false });
        count = count + 1;
    }

    return count;
}

@expose
@permission("admin")
fn mergePositionsToGolden() {
    GoldenServices::mergeAllLinkedPositions();
}

@expose
@permission("admin")
fn lockSource(source: String) {
    var nSource = sources_by_name.get(source);
    if (nSource == null) {
        throw "Source with name ${source} not Found";
    }
    if (nSource->isReconciling?.resolve() == true) {
        throw "Source ${source} has a reconciling in progress";
    }
    nSource->setIsReconciling();
}

@expose
@permission("admin")
fn reconcile(source: String, params: SearchParameters?): ReconciliationReport? {
    var nSource = sources_by_name.get(source);
    if (nSource == null) {
        throw "Source with name ${source} not Found";
    }

    try {
        var report = DataSource::reconcile(nSource, params, null);
        nSource->clearIsReconciling();
        return report;
    } catch (err) {
        nSource->clearIsReconciling();
        error(err);
    }
}

@expose
@permission("admin")
fn reconcileAddresses(source: String, poiIds: Array<String>, params: SearchParameters?): ReconciliationReport? {
    var nSource = sources_by_name.get(source);
    if (nSource == null) {
        throw "Source with name ${source} not Found";
    }

    try {
        var index = nSource->getIndex();
        var pois = Array<node<AddressRecordProvider>> {};
        for (_, poiId in poiIds) {
            var poi = index.get(poiId);
            if (poi != null) {
                pois.add(poi);
            }
        }
        var report = DataSource::reconcile(nSource, params, pois);
        nSource->clearIsReconciling();
        return report;
    } catch (err) {
        nSource->clearIsReconciling();
        error(err);
    }
}

@volatile
type ReconciliationReportMatchView {
    score: float?;
    id: String;
}

@volatile
type ReconciliationReportView {
    date: time;
    linked: Array<String>;
    fullMatch: Array<String>;
    multipleMatch: Array<String>;
    partialMatch: Array<ReconciliationReportMatchView>;
    noMatch: Array<String>;
    source: node<DataSource>;
}

@expose
@permission("admin")
fn getReconciliationReport(source: node<DataSource>, city: String?, municipality: String?): ReconciliationReportView? {
    var report = source->getReconciliationReport();
    if (report == null) {
        throw "Report not Found";
    }

    var fullMatch = Array<String> {};
    var multipleMatch = Array<String> {};
    var partialMatch = Array<ReconciliationReportMatchView> {};
    var noMatch = Array<String> {};
    for (record, candidates in report.unlinked) {
        if (municipality != null && record->getMunicipality() != municipality) {
            continue;
        }
        if (city != null && record->getCity() != city) {
            continue;
        }
        if (candidates.size() == 1 && candidates[0].mismatch == null) {
            fullMatch.add(record->getId());
        } else if (candidates.size() == 0) {
            noMatch.add(record->getId());
        } else if (candidates[0].mismatch == MengplazMismatch::MULTIPLE_MATCHES) {
            multipleMatch.add(record->getId());
        } else {
            partialMatch.add(ReconciliationReportMatchView {
                id: record->getId(),
                score: candidates[0].score?.overallScore
            });
        }
    }
    partialMatch.sort_by(ReconciliationReportMatchView::score, SortOrder::desc);
    var linked = Array<String> {};
    for (key, _ in report.linked) {
        if (municipality != null && key->getMunicipality() != municipality) {
            continue;
        }
        if (city != null && key->getCity() != city) {
            continue;
        }
        linked.add(key->getId());
    }

    return ReconciliationReportView {
        date: report.date,
        linked: linked,
        fullMatch: fullMatch,
        multipleMatch: multipleMatch,
        partialMatch: partialMatch,
        noMatch: noMatch,
        source: source
    };
}

@volatile
type RecordTabResult {
    tab: String;
    score: float?;
}

@expose
@permission("admin")
fn getRecordTab(source: node<DataSource>, recordId: String): RecordTabResult {
    var index = source->getIndex();
    var nRecord = index.get(recordId);
    if (nRecord == null) {
        throw "Record not found: ${recordId}";
    }

    var report = source->reconciliationReport;

    if (report->linked.get(nRecord) != null) {
        return RecordTabResult { tab: "Linked" };
    }

    var candidates = report->unlinked.get(nRecord);
    if (candidates == null || candidates.size() == 0) {
        return RecordTabResult { tab: "NoMatch" };
    }

    if (candidates.size() == 1 && candidates[0].mismatch == null) {
        return RecordTabResult { tab: "Matched" };
    }

    if (candidates[0].mismatch == MengplazMismatch::MULTIPLE_MATCHES) {
        return RecordTabResult { tab: "MultipleMatch" };
    }

    return RecordTabResult { tab: "Mismatched", score: candidates[0].score?.overallScore };
}

@volatile
type SourceRef {
    ref: node<DataSource>;
    name: String;
    locked: bool?;
}

@expose
@permission("admin")
fn getSources(): Array<SourceRef> {
    var res = Array<SourceRef> {};
    for (name, nSource in sources_by_name) {
        res.add(SourceRef { ref: nSource, name: name, locked: nSource->isReconciling?.resolve() });
    }
    return res;
}

@volatile
type MatchedCandidateDetail {
    ref: node<AddressRecordProvider>;
    numberScore: float;
    streetScore: float;
    cityScore: float;
    postcodeScore: float;
    geoScore: float?;
    overallScore: float;
    record: any;
}

@volatile
type ComparisonViewData {
    sourceRecord: AddressFullRecordRef;
    candidates: Array<MatchedCandidateDetail>;
}

@expose
@permission("admin")
fn getComparisonViewData(source: node<DataSource>, recordId: String): ComparisonViewData {
    var nSourceRecord = source->getIndex().get(recordId);
    if (nSourceRecord == null) {
        throw "Record not found: ${recordId}";
    }
    var candidates = source->reconciliationReport->unlinked.get(nSourceRecord);

    var candidateDetails = Array<MatchedCandidateDetail> {};
    for (_, candidate in candidates?) {
        var basicRecord = candidate.candidateRecord->toAddressRecord();
        var details = MatchedCandidateDetail {
            ref: candidate.candidateRecord,
            numberScore: trunc((candidate.score?.numberScore ?? 1.0) * 100),
            streetScore: trunc((candidate.score?.streetScore ?? 1.0) * 100),
            cityScore: trunc((candidate.score?.cityScore ?? 1.0) * 100),
            overallScore: trunc((candidate.score?.overallScore ?? 1.0) * 100),
            postcodeScore: trunc((candidate.score?.postcodeScore ?? 1.0) * 100),
            record: basicRecord,
        };
        if (candidate.score?.geoScore != null) {
            details.geoScore = trunc((candidate.score.geoScore) * 100);
        }
        candidateDetails.add(details);
    }
    candidateDetails.sort_by(MatchedCandidateDetail::overallScore, SortOrder::desc);

    return ComparisonViewData {
        sourceRecord: AddressFullRecordRef {
            ref: nSourceRecord,
            id: nSourceRecord->getId(),
            record: nSourceRecord->toFullRecord(),
        },
        candidates: candidateDetails,
    };
}

@expose
@permission("admin")
fn getLinkedComparisonViewData(source: node<DataSource>, recordId: String): ComparisonViewData {
    var nSourceRecord = source->getIndex().get(recordId);
    if (nSourceRecord == null) {
        throw "Record not found: ${recordId}";
    }
    var candidate = source->reconciliationReport->linked.get(nSourceRecord);

    var candidateDetails = Array<MatchedCandidateDetail> {};
    var basicRecord = candidate?.candidateRecord->toFullRecord();
    if (candidate != null && basicRecord != null) {
        var score = candidate.detailedScore?.resolve();
        var details = MatchedCandidateDetail {
            ref: candidate.candidateRecord,
            numberScore: trunc((score?.numberScore ?? 1.0) * 100),
            streetScore: trunc((score?.streetScore ?? 1.0) * 100),
            cityScore: trunc((score?.cityScore ?? 1.0) * 100),
            overallScore: trunc((score?.overallScore ?? 1.0) * 100),
            postcodeScore: trunc((score?.postcodeScore ?? 1.0) * 100),
            record: basicRecord,
        };
        if (score?.geoScore != null) {
            details.geoScore = trunc(score.geoScore * 100);
        }
        candidateDetails.add(details);
    }

    return ComparisonViewData {
        sourceRecord: AddressFullRecordRef {
            ref: nSourceRecord,
            id: nSourceRecord->getId(),
            record: nSourceRecord->toFullRecord(),
        },
        candidates: candidateDetails,
    };
}

@volatile
type GlobalQualityEntry {
    timestamp: time;
    averageQuality: float;
}

@volatile
type GoldenRecordScore {
    uid: String;
    number: String;
    street: String?;
    city: String?;
    postcode: String;
    linkedCount: int;
    quality: float;
}

@volatile
type GlobalQualityHistory {
    current: float;
    history: Array<GlobalQualityEntry>;
}

/// `active` and `linked` are null until the source's first snapshot: counting them live
/// walks the whole index, which a public endpoint must not do per request.
@volatile
type SourceStatsRow {
    source: String;
    total: int;
    active: int?;
    linked: int?;
    share: float;
    lastUpdate: time?;
    asOf: time?;
}

@volatile
type SourceCountPoint {
    timestamp: time;
    total: int;
    active: int;
}

@volatile
type SourceCountSeries {
    source: String;
    points: Array<SourceCountPoint>;
}

@volatile
type SourceStats {
    rows: Array<SourceStatsRow>;
    series: Array<SourceCountSeries>;
}

/// The golden index runs to six figures, so the scores table is read a page at a time.
@volatile
type GoldenRecordPage {
    total: int;
    offset: int;
    limit: int;
    rows: Array<GoldenRecordScore>;

    static MAX_PAGE: int = 1000;
}

/// Walks every golden POI; call periodically to extend the global quality history.
@expose
@permission("admin")
fn computeGlobalQuality() {
    GoldenServices::computeAndRecordGlobalQuality();
    var nGolden = sources_by_name.get(GoldenSource::NAME);
    if (nGolden != null) {
        DataSource::recordCounts(nGolden, DataSource::countRecords(nGolden));
    }
}

@expose
@permission("admin")
fn unlockSource(source: String) {
    var nSource = sources_by_name.get(source);
    if (nSource == null) {
        throw "Source with name ${source} not Found";
    }
    nSource->clearIsReconciling();
}

// ------------------------------------------------------------------ operations
//
// Data loads, index rebuilds and backup are admin-only maintenance. The work lives in
// `backend/services` and `backend/edi`; these are the HTTP surface for it.

@expose
@permission("admin")
fn updateCACLR() {
    UpdateService::caclr();
}

@expose
@permission("admin")
fn updateBDA() {
    UpdateService::bda();
}

@expose
@permission("admin")
fn updateOSM() {
    UpdateService::osm();
}

