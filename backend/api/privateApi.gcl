@expose
@permission("admin")
fn promoteRecord(record: node<POIRecordProvider>, streetIdx: String) {
    var ts = Traffic_Service::start(promoteRecord);

    if (record->getLinkedGolden() != null) {
        throw "This record is already linked to a golden Record";
    }
    record->promoteToGolden(streetIdx);
    ts.end();
}

@expose
@permission("admin")
fn linkRecords(nGolden: node<POIRecordProvider>, nOther: node<POIRecordProvider>) {
    var ts = Traffic_Service::start(linkRecords);

    var golden = *nGolden;
    if (golden is GoldenPointOfInterest) {
        if (golden.linkedRecords.index_of(nOther) == -1) {
            golden.linkedRecords.add(nOther);
        }
    }

    var other = *nOther;
    other.linkToGolden(nGolden as node<GoldenPointOfInterest>);
    ts.end();
}

@expose
@permission("admin")
fn linkAllRecords(goldens: Array<node<POIRecordProvider>>, others: Array<node<POIRecordProvider>>) {
    var ts = Traffic_Service::start(linkAllRecords);

    for (i, nGolden in goldens) {
        linkRecords(nGolden, others[i]);
    }
    ts.end();
}

@expose
@permission("admin")
fn unlinkRecord(nOther: node<POIRecordProvider>) {
    var ts = Traffic_Service::start(unlinkRecord);

    var other = *nOther;
    other.unlinkGolden(nOther);
    ts.end();
}

@expose
@permission("admin")
fn mergePositionsToGolden(others: Array<node<POIRecordProvider>>) {
    var ts = Traffic_Service::start(mergePositionsToGolden);

    for (_, nOther in others) {
        var nGolden = nOther->getLinkedGolden();
        if (nGolden != null && nGolden->primaryLocation == null) {
            var g = nOther->toMengplazRecord().primaryLocation;
            if (g != null) {
                golden_pois_by_geo.set(g, nGolden);
                nGolden->primaryLocation = g;
            }
        }
    }
    ts.end();
}

@expose
@permission("admin")
fn reconcile(source: node<DataSource>): ReconciliationReport {
    var ts = Traffic_Service::start(reconcile);
    var progress = ProgressTracker {
        start: time::now(),
    };
    var recRes = clone(*source).reconcile();
    progress.total = recRes.totalProcessed;
    progress.update(recRes.totalProcessed);
    ts.end();
    return recRes;
}

@expose
@permission("admin")
fn getReconciliationReport(source: node<DataSource>): ReconciliationReport? {
    var ts = Traffic_Service::start(getReconciliationReport).end();
    return source->getReconciliationReport();
}



@volatile
type SourceRef {
    ref: node<DataSource>;
    name: String;
}

@expose
@permission("admin")
fn getSources(): Array<SourceRef> {
    var ts = Traffic_Service::start(getSources);
    var res = Array<SourceRef> {};
    for (name, nSource in sources_by_name) {
        res.add(SourceRef { ref: nSource, name: name });
    }
    ts.end();
    return res;
}


@volatile
type MatchCandidateDetail {
    ref: node<POIRecordProvider>;
    numberScore: float;
    streetScore: float;
    cityScore: float;
    overallScore: float;
    postcodeScore: float;
    uid: String?;
    number: String?;
    street: String?;
    postcode: String?;
    city: String?;
    primaryLocation: geo?;
}

@expose
@permission("admin")
fn getMatchCandidateDetails(elements: Array<CandidateMatch<node<POIRecordProvider>>>): Array<MatchCandidateDetail> {
    var ts = Traffic_Service::start(getMatchCandidateDetails);
    var res = Array<MatchCandidateDetail> {};
    for (i, e in elements) {
        var record = e.elem->toMengplazRecord();

        res.add(
            MatchCandidateDetail {
                ref: e.elem,
                numberScore: trunc(e.numberScore * 100),
                streetScore: trunc(e.streetScore * 100),
                cityScore: trunc(e.cityScore * 100),
                overallScore: trunc(e.overallScore * 100),
                postcodeScore: trunc(e.postcodeScore * 100),
                uid: record.uid,
                number: record.number,
                street: record.street,
                postcode: record.postcode,
                city: record.city,
                primaryLocation: record.primaryLocation,
            }
        );
    }
    ts.end();
    return res;
}