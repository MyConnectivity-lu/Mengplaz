/// Dumps the whole graph to `files/backup/` (plus the golden dump in `files/dump/`).
@expose
@permission("admin")
fn backupGraph() {
    BackupExporter::exportAll();
}

/// Restores the whole graph from `files/backup/`.
@expose
@permission("admin")
fn restoreGraph() {
    BackupImporter::importAll();
}
