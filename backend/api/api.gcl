/// A `node<T>` argument is a raw graph pointer and the runtime does not check its referent,
/// so a public endpoint takes the street's id and resolves it itself.
@expose
@permission("public")
@tag("openapi")
fn getPoisInStreet(streetId: String): Array<AddressRecordRef> {
    var nStreet = golden_streets_by_id.get(streetId);
    if (nStreet == null) {
        throw "Street with id ${streetId} not found";
    }
    return nStreet->getAddresses();
}

@expose
@permission("public")
fn searchStreet(e: String): Array<StreetRecordRef> {
    // What the search page is willing to render.
    var maxResults = 30;

    var res = Array<StreetRecordRef> {};
    var query = e.trim();

    if (query.size() > 0) {
        // The index is rebuild-only, so an unbuilt one degrades to "No matching streets".
        var idx = GoldenStreetSearch::ready();
        if (idx == null) {
            warn("searchStreet: golden street index not built - run `greycat run buildGoldenStreetIndex`");
        } else {
            for (_, hit in GoldenStreetSearch::search(idx, query, maxResults)) {
                var nStreet = GoldenStreetSearch::resolveOne(hit);
                if (nStreet != null) {
                    res.add(StreetRecordRef {
                        ref: nStreet,
                        id: nStreet->id,
                        record: nStreet->toRecord(),
                        score: hit.score
                    });
                }
            }
        }
    }

    return res;
}

@volatile
type AddressFeatures {
    coords: geo;
    number: String;
}

@expose
@permission("public")
fn getPois(): Array<AddressFeatures> {
    var feats = Array<AddressFeatures> {};
    feats.set_capacity(golden_addresses_by_geo.size());
    for (key, value in golden_addresses_by_geo) {
        feats.add(AddressFeatures { coords: key, number: "${value->number}${value->multipleCode}" });
    }
    return feats;
}

@expose
@permission("public")
fn getPoisByGeo(coords: geo): AddressRecordRef? {
    var poi = golden_addresses_by_geo.get(coords);
    if (poi != null) {
        return AddressRecordRef {
            ref: poi,
            record: poi->toAddressRecord(),
        };
    }
}

@volatile
type GoldenRecordDetails {
    golden: AddressRecordRef;
    associated: Array<AddressFullRecordRef>;
}

@expose
@permission("public")
fn getGoldenRecordDetails(uid: String): GoldenRecordDetails {
    var ref = golden_addresses_by_id.get(uid);
    if (ref == null) {
        throw "Record not found";
    }
    var linked: Array<AddressFullRecordRef> = Array<AddressFullRecordRef> {};
    for (_, l in ref->linkedRecords) {
        linked.add(AddressFullRecordRef {
            ref: l.record,
            id: l.record->getId(),
            record: l.record->toFullRecord(),
            matchScore: l.detailedScore?.resolve().overallScore
        });
    }

    return GoldenRecordDetails {
        golden: AddressRecordRef {
            ref: ref,
            record: ref->toAddressRecord(),
        },
        associated: linked,
    };
}

/// Returns the Golden POI associated with the given uid
@expose
@permission("public")
@tag("openapi")
fn getGoldenRecordRefByUid(uid: String): AddressRecordRef? {
    var nGolden = golden_addresses_by_id.get(uid);
    if (nGolden != null) {
        return AddressRecordRef {
            ref: nGolden,
            record: nGolden->toAddressRecord(),
        };
    }
    return null;
}

/// Returns the Golden address associated with the given geoportail id
@expose
@permission("public")
@tag("openapi")
fn getRecordByGeoportailID(id: String): AddressRecordRef? {
    var record = bda_addresses_by_geoportail_id.get(id);
    if (record != null) {
        var nGolden = record->getLinkedGolden();
        if (nGolden != null) {
            return AddressRecordRef {
                ref: nGolden,
                record: nGolden->toAddressRecord(),
            };
        }
    }
    return null;
}

@volatile
type GoldenIndex {
    id: String;
    name: String;
}

/// Returns all the localities in the Golden collection. Provides the localityId to be used with getGoldenStreetsByLocalityId
@expose
@permission("public")
@tag("openapi")
fn getGoldenLocalities(communeName: String?): Array<GoldenIndex> {
    var cities = Array<GoldenIndex> {};
    for (id, nCity in golden_cities_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        if (communeName != null && nCity->municipality->name != communeName) {
            continue;
        }
        cities.add(GoldenIndex { id: id, name: nCity->name });
    }
    cities.sort_by(GoldenIndex::name, SortOrder::asc);
    return cities;
}

/// Returns all the communes in the Golden collection. `name` is what `getGoldenLocalities`
/// filters on - its `id` is the CACLR key, and no endpoint takes it.
@expose
@permission("public")
@tag("openapi")
fn getGoldenCommunes(): Array<GoldenIndex> {
    var municipalities = Array<GoldenIndex> {};
    for (id, nCommune in golden_municipalities_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        municipalities.add(GoldenIndex { id: id, name: nCommune->name });
    }
    municipalities.sort_by(GoldenIndex::name, SortOrder::asc);
    return municipalities;
}

/// Returns all the streets in the city referenced by this cityId. Provides the streetId to be used with getGoldenNumbersByStreetId
@expose
@permission("public")
@tag("openapi")
fn getGoldenStreetsByLocalityId(localityId: String): Array<GoldenIndex> {
    var nCity = golden_cities_by_id.get(localityId);
    if (nCity == null) {
        throw "City with id ${localityId} not found";
    }
    var streets = Array<GoldenIndex> {};
    for (id, nStreet in nCity->streets_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        streets.add(GoldenIndex { id: id, name: nStreet->name });
    }
    streets.sort_by(GoldenIndex::name, SortOrder::asc);
    return streets;
}

/// Returns all the numbers in the street referenced by this streetId
@expose
@permission("public")
@tag("openapi")
fn getGoldenNumbersByStreetId(streetId: String): Array<GoldenIndex> {
    var nStreet = golden_streets_by_id.get(streetId);
    if (nStreet == null) {
        throw "Street with id ${streetId} not found";
    }
    var numbers = Array<GoldenIndex> {};
    for (id, nGoldenAddress in nStreet->addresses_by_id) {
        numbers.add(GoldenIndex {
            id: id,
            name: "${nGoldenAddress->number} ${nGoldenAddress->multipleCode}",
        });
    }
    numbers.sort_by(GoldenIndex::name, SortOrder::asc);
    return numbers;
}

/// The whole golden set is far too large for one response, so every listing endpoint is
/// paged against the same bounds.
@volatile
type GoldenRecordsPage {
    total: int;
    offset: int;
    limit: int;
    rows: Array<AddressRecord>;

    static MAX_PAGE: int = 1000;
}

private fn clampOffset(offset: int): int {
    if (offset < 0) {
        return 0;
    }
    return offset;
}

private fn clampLimit(limit: int): int {
    if (limit > GoldenRecordsPage::MAX_PAGE) {
        return GoldenRecordsPage::MAX_PAGE;
    }
    if (limit < 0) {
        return 0;
    }
    return limit;
}

/// One page of the Points Of Interest (POIs) in the Golden collection
@expose
@permission("public")
@tag("openapi")
fn getGoldenRecords(offset: int, limit: int): GoldenRecordsPage {
    var start = clampOffset(offset);
    var size = clampLimit(limit);

    var records = Array<AddressRecord> {};
    var seen = 0;
    for (_, nGoldenAddress in golden_addresses_by_id) {
        if (seen >= start) {
            if (records.size() >= size) {
                break;
            }
            records.add(nGoldenAddress->toAddressRecord());
        }
        seen++;
    }
    return GoldenRecordsPage { total: golden_addresses_by_id.size(), offset: start, limit: size, rows: records };
}

@volatile
type GeoJSON {
    type: String;
    features: Array<GeoJSONFeature>;
}

@volatile
type GeoJSONFeature {
    type: String;
    geometry: GeoJSONGeometry;
    properties: Map<String, any>;
}

@volatile
type GeoJSONGeometry {
    type: String;
    coordinates: Array<float>;
}


@expose
@permission("public")
@tag("openapi")
fn getGoldenRecordsGeoJson(): GeoJSON {
    var features = Array<GeoJSONFeature> {};
    for (coords, nGoldenAddress in golden_addresses_by_geo) {
        var externalIds = Map<String, any> {};
        for (_, linkedRecord in nGoldenAddress->linkedRecords) {
            externalIds.set(linkedRecord.record->getSourceName(), linkedRecord.record->getId());
        }

        features.add(GeoJSONFeature { type: "Feature", geometry: GeoJSONGeometry {
            type: "Point",
            coordinates: Array<float> { coords.lat(), coords.lng() }
        }, properties: Map<String, any> { "goldenRecordId": nGoldenAddress->uid, "externalIds": externalIds } });
    }
    return GeoJSON { type: "FeatureCollection", features: features };
}

@volatile
type DataAttribution {
    /// Required notice for the data served by this API.
    notice: String;
    /// Per-source credit lines.
    sources: Array<String>;
}

/// Attribution notice for the data exposed by this API. The address data derives in part
/// from OpenStreetMap, so this notice is what satisfies the ODbL attribution requirement.
@expose
@permission("public")
@tag("openapi")
fn attribution(): DataAttribution {
    return DataAttribution {
        notice: "Address data © OpenStreetMap contributors, licensed under the ODbL (https://opendatacommons.org/licenses/odbl/1-0/). See https://www.openstreetmap.org/copyright.",
        sources: Array<String> {
            "OpenStreetMap contributors — ODbL (https://www.openstreetmap.org/copyright)",
            "CACLR — Administration du cadastre et de la topographie (CC0)",
        },
    };
}

@expose
@permission("public")
fn openapi(): runtime::OpenApiV3 {
    var oa = OpenApi::v3();
    oa.info.title = "MengPlaz — Address data © OpenStreetMap contributors (ODbL), see /attribution";
    oa.info.version = Runtime::info().program_version ?? "";
    return oa;
}

@expose
@permission("public")
fn getGlobalQualityHistory(from: time?, to: time?): GlobalQualityHistory {
    var nSource = sources_by_name.get(GoldenSource::NAME);
    if (nSource == null) {
        throw "Golden source not found";
    }

    var source = *nSource;
    if (!(source is GoldenSource)) {
        throw "Invalid source type";
    }

    var history = Array<GlobalQualityEntry> {};

    // Down-sampled to a bounded number of points; column 1 holds the value.
    var samples = nodeTime::sample(Array<nodeTime> {
        source.qualityHistory
    }, from, to, 100, SamplingMode::adaptative, null, null);
    for (var row = 0; row < samples.rows(); row++) {
        var avgQuality = samples.get_cell(row, 1);
        if (avgQuality == null) {
            continue;
        }
        history.add(GlobalQualityEntry {
            timestamp: samples.get_cell(row, 0) as time,
            averageQuality: (avgQuality as float) * 100,
        });
    }

    var latest = source.qualityHistory.last();
    var currentValue = 0.0;
    if (latest != null) {
        currentValue = latest;
    }

    return GlobalQualityHistory { current: currentValue, history: history };
}

/// Ranking on these rather than on whole `GoldenRecordScore`s keeps a sorted page from
/// resolving every record's street and locality.
@volatile
private type RankedGoldenRecord {
    record: node<GoldenAddress>;
    value: float;
}

/// One page of the golden records with their scores. `sortKey` is `"quality"`,
/// `"linkedCount"`, or null for the index's own order (by uid); `sortDir` is `"asc"` or
/// `"desc"` (default ascending).
///
/// The ranking is computed live over the whole index, so page N continues page N-1's order
/// even as records change; only the returned rows have their addresses resolved.
@expose
@permission("public")
fn getGoldenRecordScores(offset: int, limit: int, sortKey: String?, sortDir: String?): GoldenRecordPage {
    var order = SortOrder::asc;
    if (sortDir != null && sortDir != "asc") {
        if (sortDir != "desc") {
            throw "Unknown sort direction: ${sortDir}";
        }
        order = SortOrder::desc;
    }
    if (sortKey != null && sortKey != "" && sortKey != "quality" && sortKey != "linkedCount") {
        throw "Unknown sort key: ${sortKey}";
    }

    var start = offset;
    if (start < 0) {
        start = 0;
    }
    var size = limit;
    if (size > GoldenRecordPage::MAX_PAGE) {
        size = GoldenRecordPage::MAX_PAGE;
    }
    if (size < 0) {
        size = 0;
    }

    var rows = Array<GoldenRecordScore> {};

    if (sortKey == null || sortKey == "") {
        // Index order: walk to the offset without touching a record, then project the page.
        var seen = 0;
        for (_, nGolden in golden_addresses_by_id) {
            if (seen >= start) {
                if (rows.size() >= size) {
                    break;
                }
                rows.add(goldenRecordScore(nGolden));
            }
            seen = seen + 1;
        }
    } else {
        var ranked = Array<RankedGoldenRecord> {};
        for (_, nGolden in golden_addresses_by_id) {
            var value = 0.0;
            if (sortKey == "quality") {
                value = nGolden->quality.last()?.score ?? 0.0;
            } else {
                value = nGolden->linkedRecords.size() as float;
            }
            ranked.add(RankedGoldenRecord { record: nGolden, value: value });
        }
        ranked.sort_by(RankedGoldenRecord::value, order);

        var end = start + size;
        if (end > ranked.size()) {
            end = ranked.size();
        }
        for (var i = start; i < end; i++) {
            rows.add(goldenRecordScore(ranked[i].record));
        }
    }

    return GoldenRecordPage { total: golden_addresses_by_id.size(), offset: start, limit: size, rows: rows };
}

/// The scores table's view of one golden record.
private fn goldenRecordScore(nGolden: node<GoldenAddress>): GoldenRecordScore {
    var quality = nGolden->quality.last();
    return GoldenRecordScore {
        uid: nGolden->uid,
        number: "${nGolden->number}${nGolden->multipleCode}",
        street: nGolden->street?->name,
        city: nGolden->street?->city->name,
        postcode: nGolden->postcode,
        linkedCount: nGolden->linkedRecords.size(),
        quality: (quality?.score ?? 0.0),
    };
}

@expose
@permission("public")
fn appInfo(): RuntimeInfo {
    return Runtime::info();
}

@expose
@permission("public")
fn searchAddress(addr: String, max: int?, source: String?): Array<AddressRecordRef> {
    if (max == null) {
        max = 6;
    }

    var srcName = source ?? GoldenSource::NAME;
    var nSource = sources_by_name.get(srcName);
    if (nSource == null) {
        throw "Unknown source: ${srcName}";
    }

    var pois = Array<node<AddressRecordProvider>> {};
    var results = Array<AddressRecordRef> {};

    // Both indexes are rebuild-only, so an unbuilt one degrades to "No results" rather
    // than erroring.
    if (srcName == GoldenSource::NAME) {
        var idx = GoldenTextSearch::ready();
        if (idx == null) {
            warn("searchAddress: golden text index not built - run `greycat run buildGoldenTextIndex`");
        } else {
            var hits = GoldenTextSearch::search(idx, addr, max);
            for (_, nGolden in GoldenTextSearch::resolve(idx, hits)) {
                var nPoi = nGolden as node<AddressRecordProvider>;
                pois.add(nPoi);
                results.add(AddressRecordRef { ref: nPoi, record: nGolden->toAddressRecord() });
            }
        }
    } else {
        var idx = SourceTextSearch::ready(srcName);
        if (idx == null) {
            warn("searchAddress: ${srcName} text index not built - run `greycat run buildSourceTextIndexes`");
        } else {
            var hits = SourceTextSearch::search(idx, addr, max);
            for (_, nRecord in SourceTextSearch::resolve(nSource, idx, hits)) {
                pois.add(nRecord);
                results.add(AddressRecordRef { ref: nRecord, record: nRecord->toAddressRecord() });
            }
        }
    }

    return results;
}

@volatile
type GoldenWithLinkedRecords {
    golden: AddressRecord;
    osm: Array<LinkedRecordDetails<OsmAddressFullRecord>>;
    caclr: Array<LinkedRecordDetails<CaclrAddressFullRecord>>;
    bda: Array<LinkedRecordDetails<BdaAddressFullRecord>>;
}

@volatile
type LinkedRecordDetails<T> {
    score: ReconciliationCandidateScore?;
    record: T;
}

@expose
@permission("public")
@tag("openapi")
fn getGoldenWithLinkedRecords(addr: String): GoldenWithLinkedRecords? {
    var g = searchAddress(addr, 1, null);
    if (g.size() == 0) {
        return null;
    }
    var golden = g.get(0).ref as node<GoldenAddress>;
    var osm = Array<LinkedRecordDetails<OsmAddressFullRecord>> {};
    var caclr = Array<LinkedRecordDetails<CaclrAddressFullRecord>> {};
    var bda = Array<LinkedRecordDetails<BdaAddressFullRecord>> {};

    for (_, l in golden->linkedRecords) {
        var r = l.record.resolve();
        if (r is BdaAddress) {
            bda.add(LinkedRecordDetails<BdaAddressFullRecord> {
                record: r.toFullRecord(),
                score: l.detailedScore?.resolve()
            });
        } else if (r is OsmAddress) {
            osm.add(LinkedRecordDetails<OsmAddressFullRecord> {
                record: r.toFullRecord(),
                score: l.detailedScore?.resolve()
            });
        } else if (r is CaclrAddress) {
            caclr.add(LinkedRecordDetails<CaclrAddressFullRecord> {
                record: r.toFullRecord(),
                score: l.detailedScore?.resolve()
            });
        }
    }

    var r = GoldenWithLinkedRecords { golden: golden->toAddressRecord(), osm: osm, bda: bda, caclr: caclr };

    return r;
}

@expose
@permission("public")
fn getSourceStats(from: time?, to: time?): SourceStats {
    var stats = StatsService::build(from, to);
    return stats;
}

/// A null `asOf` means the row was counted live, because the source has no snapshot yet.
@volatile
type DeprecatedCountRow {
    source: String;
    total: int;
    deprecated: int;
    asOf: time?;
}

@volatile
type DeprecatedCounts {
    rows: Array<DeprecatedCountRow>;
    total: int;
    deprecated: int;
}

/// How many addresses each source has stopped publishing. A record is deprecated once a
/// successful load no longer sees it; it stays in the graph and heals if the source
/// publishes it again. Pass a source name (CACLR, BDA, OSM, Golden) or null for all of them.
@expose
@permission("public")
@tag("openapi", "mcp")
fn getDeprecatedCounts(source: String?): DeprecatedCounts {
    if (source != null && sources_by_name.get(source) == null) {
        throw "Unknown source: ${source}";
    }
    return StatsService::deprecatedCounts(source);
}
