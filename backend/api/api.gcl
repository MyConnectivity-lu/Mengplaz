@expose
@permission("public")
fn getPoisInStreet(e: node<StreetRecordProvider>): Array<POIRecordRef> {
    var ts = Traffic_Service::start(getPoisInStreet);
    var pois = e->getPOIs();
    ts.end();
    return pois;
}


@expose
@permission("public")
fn searchStreet(e: String): Array<StreetRecordRef> {
    // What the search page is willing to render.
    var maxResults = 30;

    var ts = Traffic_Service::start(searchStreet);
    var res = Array<StreetRecordRef> {};
    var query = e.trim();

    if (query.size() > 0) {
        // Rebuild-only, so an unbuilt index warns and returns nothing rather than throwing -
        // the search page degrades to "No matching streets", as `searchAddress` does.
        var idx = GoldenStreetSearch::ready();
        if (idx == null) {
            warn("searchStreet: golden street index not built - run `greycat run buildGoldenStreetIndex`");
        } else {
            for (_, hit in GoldenStreetSearch::search(idx, query, maxResults)) {
                var nStreet = GoldenStreetSearch::resolveOne(hit);
                if (nStreet != null) {
                    res.add(StreetRecordRef { ref: nStreet, record: nStreet->toRecord(), score: hit.score });
                }
            }
        }
    }

    ts.end();
    return res;
}

@volatile
type POIFeatures {
    coords: geo;
    number: String;
}

@expose
@permission("public")
fn getPois(): Array<POIFeatures> {
    var ts = Traffic_Service::start(getPois);
    var feats = Array<POIFeatures> {};
    feats.set_capacity(golden_pois_by_geo.size());
    for (key, value in golden_pois_by_geo) {
        feats.add(POIFeatures { coords: key, number: "${value->number}${value->multipleCode}" });
    }
    ts.end();
    return feats;
}

@expose
@permission("public")
fn getPoisByGeo(coords: geo): POIRecordRef? {
    var ts = Traffic_Service::start(getPoisByGeo);
    var poi = golden_pois_by_geo.get(coords);
    ts.end();
    if (poi != null) {
        return POIRecordRef {
            ref: poi,
            record: poi->toMengplazRecord(),
        };
    }
}

@volatile
type GoldenRecordDetails {
    golden: POIRecordRef;
    associated: Array<POIFullRecordRef>;
}

@expose
fn getGoldenRecordDetails(uid: String): GoldenRecordDetails {
    var ts = Traffic_Service::start(getGoldenRecordDetails);
    var ref = golden_pois_by_id.get(uid);
    if (ref == null) {
        throw "Record not found";
    }
    var linked: Array<POIFullRecordRef> = Array<POIFullRecordRef> {};
    for (_, l in ref->linkedRecords) {
        linked.add(POIFullRecordRef {
            ref: l.record,
            id: l.record->getId(),
            record: l.record->toFullRecord(),
            matchScore: l.detailedScore?.resolve().overallScore
        });
    }

    ts.end();

    return GoldenRecordDetails {
        golden: POIRecordRef {
            ref: ref,
            record: ref->toMengplazRecord(),
        },
        associated: linked,
    };
}

/// Returns the Golden POI associated with the given uid
@expose
@tag("openapi")
fn getGoldenRecordRefByUid(uid: String): POIRecordRef? {
    var ts = Traffic_Service::start(getGoldenRecordRefByUid);
    var nGolden = golden_pois_by_id.get(uid);
    ts.end();
    if (nGolden != null) {
        return POIRecordRef {
            ref: nGolden,
            record: nGolden->toMengplazRecord(),
        };
    }
    return null;
}

/// Returns the Golden POI associated with the given geoportal_id
@expose
@permission("public")
@tag("openapi")
fn getRecordByGeoportailID(id: String): POIRecordRef? {
    var ts = Traffic_Service::start(getRecordByGeoportailID);
    var record = bda_address_by_geoportalid.get(id);
    ts.end();
    if (record != null) {
        var nGolden = record->getLinkedGolden();
        if (nGolden != null) {
            return POIRecordRef {
                ref: nGolden,
                record: nGolden->toMengplazRecord(),
            };
        }
    }
    return null;
}

@volatile
type GoldenIndex {
    id: String;
    name: String;
}

/// Returns all the localities in the Golden collection. Provides the localityId to be used with getGoldenStreetsByLocalityId
@expose
@permission("public")
@tag("openapi")
fn getGoldenLocalities(communeId: String?): Array<GoldenIndex> {
    var ts = Traffic_Service::start(getGoldenLocalities);
    var cities = Array<GoldenIndex> {};
    for (id, nCity in golden_cities_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        if (communeId != null && nCity->municipality->name != communeId) {
            continue;
        }
        cities.add(GoldenIndex { id: id, name: nCity->name });
    }
    cities.sort_by(GoldenIndex::name, SortOrder::asc);
    ts.end();
    return cities;
}

/// Returns all the communes in the Golden collection. Provides the communeId to be used with getGoldenLocalities
@expose
@permission("public")
@tag("openapi")
fn getGoldenCommunes(): Array<GoldenIndex> {
    var ts = Traffic_Service::start(getGoldenCommunes);
    var municipalities = Array<GoldenIndex> {};
    for (id, nCommune in golden_municipalities_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        municipalities.add(GoldenIndex { id: id, name: nCommune->name });
    }
    municipalities.sort_by(GoldenIndex::name, SortOrder::asc);
    ts.end();
    return municipalities;
}

/// Returns all the streets in the city referenced by this cityId. Provides the streetId to be used with getGoldenNumbersByStreetId
@expose
@permission("public")
@tag("openapi")
fn getGoldenStreetsByLocalityId(localityId: String): Array<GoldenIndex> {
    var ts = Traffic_Service::start(getGoldenStreetsByLocalityId);
    var nCity = golden_cities_by_id.get(localityId);
    if (nCity == null) {
        throw "City with id ${localityId} not found";
    }
    var streets = Array<GoldenIndex> {};
    for (id, nStreet in nCity->streets_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        streets.add(GoldenIndex { id: id, name: nStreet->name });
    }
    streets.sort_by(GoldenIndex::name, SortOrder::asc);
    ts.end();
    return streets;
}

/// Returns all the numbers in the street referenced by this streetId
@expose
@permission("public")
@tag("openapi")
fn getGoldenNumbersByStreetId(streetId: String): Array<GoldenIndex> {
    var ts = Traffic_Service::start(getGoldenNumbersByStreetId);
    var nStreet = golden_streets_by_id.get(streetId);
    if (nStreet == null) {
        throw "Street with id ${streetId} not found";
    }
    var numbers = Array<GoldenIndex> {};
    for (id, nPOI in nStreet->pois_by_id) {
        numbers.add(GoldenIndex {
            id: id,
            name: "${nPOI->number} ${nPOI->multipleCode}",
        });
    }
    numbers.sort_by(GoldenIndex::name, SortOrder::asc);
    ts.end();
    return numbers;
}

/// Returns all Points Of Interest (POIs) in the Golden collection
@expose
@permission("public")
@tag("openapi")
fn getGoldenRecords(): Array<POIRecord> {
    var ts = Traffic_Service::start(getGoldenRecords);
    var records = Array<POIRecord> {};
    for (_, nPOI in golden_pois_by_id) {
        records.add(nPOI->toMengplazRecord());
    }
    ts.end();
    return records;
}

@volatile
type GeoJSON {
    type: String;
    features: Array<GeoJSONFeature>;
}

@volatile
type GeoJSONFeature {
    type: String;
    geometry: GeoJSONGeometry;
    properties: Map<String, any>;
}

@volatile
type GeoJSONGeometry {
    type: String;
    coordinates: Array<float>;
}

/// Returns all Golden Points Of Interest (POIs) in a GeoJson Format
@expose
@permission("public")
@tag("openapi")
fn getGoldenRecordsGeoJson(): GeoJSON {
    var ts = Traffic_Service::start(getGoldenRecords);
    var features = Array<GeoJSONFeature> {};
    for (coords, nPOI in golden_pois_by_geo) {
        var externalIds = Map<String, any> {};
        for (_, linkedRecord in nPOI->linkedRecords) {
            externalIds.set(linkedRecord.record->getSource()->name(), linkedRecord.record->getId());
        }

        features.add(GeoJSONFeature { type: "Feature", geometry: GeoJSONGeometry {
            type: "Point",
            coordinates: Array<float> { coords.lat(), coords.lng() }
        }, properties: Map<String, any> { "goldenRecordId": nPOI->uid, "externalIds": externalIds } });
    }
    ts.end();
    return GeoJSON { type: "FeatureCollection", features: features };
}

@volatile
type DataAttribution {
    /// Required notice for the data served by this API.
    notice: String;
    /// Per-source credit lines.
    sources: Array<String>;
}

/// Attribution notice for the data exposed by this API.
///
/// The address data is derived in part from OpenStreetMap and is therefore subject to the
/// ODbL (Open Database License). This notice satisfies the ODbL attribution requirement for
/// data conveyed via the API.
@expose
@permission("public")
@tag("openapi")
fn attribution(): DataAttribution {
    return DataAttribution {
        notice: "Address data © OpenStreetMap contributors, licensed under the ODbL (https://opendatacommons.org/licenses/odbl/1-0/). See https://www.openstreetmap.org/copyright.",
        sources: Array<String> {
            "OpenStreetMap contributors — ODbL (https://www.openstreetmap.org/copyright)",
            "CACLR — Administration du cadastre et de la topographie (CC0)",
        },
    };
}

@expose
@permission("public")
fn openapi(): runtime::OpenApiV3 {
    var ts = Traffic_Service::start(openapi);
    var oa = OpenApi::v3();
    oa.info.title = "MengPlaz — Address data © OpenStreetMap contributors (ODbL), see /attribution";
    oa.info.version = Runtime::info().program_version ?? "";
    ts.end();
    return oa;
}

@expose
@permission("public")
fn getGlobalQualityHistory(from: time?, to: time?): GlobalQualityHistory {
    var ts = Traffic_Service::start(getGlobalQualityHistory);

    var nSource = sources_by_name.get(GoldenSource::NAME);
    if (nSource == null) {
        throw "Golden source not found";
    }

    var source = *nSource;
    if (!(source is GoldenSource)) {
        throw "Invalid source type";
    }

    var history = Array<GlobalQualityEntry> {};

    // Down-sample so the chart gets a bounded number of points whatever the requested
    // range. Column 0 holds the timestamp, column 1 the value of `qualityHistory`.
    var samples = nodeTime::sample(Array<nodeTime> {
        source.qualityHistory
    }, from, to, 100, SamplingMode::adaptative, null, null);
    for (var row = 0; row < samples.rows(); row++) {
        var avgQuality = samples.get_cell(row, 1);
        if (avgQuality == null) {
            continue;
        }
        history.add(GlobalQualityEntry {
            timestamp: samples.get_cell(row, 0) as time,
            averageQuality: (avgQuality as float) * 100,
        });
    }

    var latest = source.qualityHistory.last();
    var currentValue = 0.0;
    if (latest != null) {
        currentValue = latest;
    }

    ts.end();
    return GlobalQualityHistory { current: currentValue, history: history };
}

/// One golden record paired with the value the requested sort ranks it on. Ranking on
/// these rather than on whole `GoldenRecordScore`s is what keeps a sorted page from
/// resolving every record's street and locality.
@volatile
private type RankedGoldenRecord {
    record: node<GoldenPointOfInterest>;
    value: float;
}

/// One page of the golden records with their scores, at most `GoldenRecordPage::MAX_PAGE`
/// rows at a time. `sortKey` is `"quality"`, `"linkedCount"`, or null for the index's own
/// order (by uid); `sortDir` is `"asc"` or `"desc"` (default ascending).
///
/// The ranking is computed live, over the whole index, so a page is always current and
/// page N continues page N-1's order. A sorted call therefore walks every record for its
/// sort value, but resolves addresses only for the rows it is about to return.
@expose
@permission("public")
fn getGoldenRecordScores(offset: int, limit: int, sortKey: String?, sortDir: String?): GoldenRecordPage {
    var order = SortOrder::asc;
    if (sortDir != null && sortDir != "asc") {
        if (sortDir != "desc") {
            throw "Unknown sort direction: ${sortDir}";
        }
        order = SortOrder::desc;
    }
    if (sortKey != null && sortKey != "" && sortKey != "quality" && sortKey != "linkedCount") {
        throw "Unknown sort key: ${sortKey}";
    }

    var ts = Traffic_Service::start(getGoldenRecordScores);

    var start = offset;
    if (start < 0) {
        start = 0;
    }
    var size = limit;
    if (size > GoldenRecordPage::MAX_PAGE) {
        size = GoldenRecordPage::MAX_PAGE;
    }
    if (size < 0) {
        size = 0;
    }

    var rows = Array<GoldenRecordScore> {};

    if (sortKey == null || sortKey == "") {
        // Index order: walk to the offset without touching a record, then project the page.
        var seen = 0;
        for (_, nGolden in golden_pois_by_id) {
            if (seen >= start) {
                if (rows.size() >= size) {
                    break;
                }
                rows.add(goldenRecordScore(nGolden));
            }
            seen = seen + 1;
        }
    } else {
        var ranked = Array<RankedGoldenRecord> {};
        for (_, nGolden in golden_pois_by_id) {
            var value = 0.0;
            if (sortKey == "quality") {
                value = nGolden->quality.last()?.score ?? 0.0;
            } else {
                value = nGolden->linkedRecords.size() as float;
            }
            ranked.add(RankedGoldenRecord { record: nGolden, value: value });
        }
        ranked.sort_by(RankedGoldenRecord::value, order);

        var end = start + size;
        if (end > ranked.size()) {
            end = ranked.size();
        }
        for (var i = start; i < end; i++) {
            rows.add(goldenRecordScore(ranked[i].record));
        }
    }

    ts.end();
    return GoldenRecordPage { total: golden_pois_by_id.size(), offset: start, limit: size, rows: rows };
}

/// The scores table's view of one golden record: its address, how many source records are
/// linked to it, and its latest quality score.
private fn goldenRecordScore(nGolden: node<GoldenPointOfInterest>): GoldenRecordScore {
    var quality = nGolden->quality.last();
    return GoldenRecordScore {
        uid: nGolden->uid,
        number: "${nGolden->number}${nGolden->multipleCode}",
        street: nGolden->street?->name,
        city: nGolden->street?->city->name,
        postcode: nGolden->postCode,
        linkedCount: nGolden->linkedRecords.size(),
        quality: (quality?.score ?? 0.0),
    };
}

@expose
@permission("public")
fn appInfo(): RuntimeInfo {
    return Runtime::info();
}

@expose
fn searchAddress(addr: String, max: int?, source: String?): Array<POIRecordRef> {
    if (max == null) {
        max = 6;
    }

    var srcName = source ?? GoldenSource::NAME;
    var nSource = sources_by_name.get(srcName);
    if (nSource == null) {
        throw "Unknown source: ${srcName}";
    }

    var ts = Traffic_Service::start(searchAddress);

    var pois = Array<node<POIRecordProvider>> {};
    var results = Array<POIRecordRef> {};

    // Golden answers from its own index over the golden graph; every other source answers
    // from the per-source index `SourceTextSearch` builds over its own records. Both are
    // rebuild-only, so an unbuilt index warns and returns nothing rather than throwing —
    // the reconcile page degrades to "No results" instead of erroring.
    if (srcName == GoldenSource::NAME) {
        var idx = GoldenTextSearch::ready();
        if (idx == null) {
            warn("searchAddress: golden text index not built - run `greycat run buildGoldenTextIndex`");
        } else {
            var hits = GoldenTextSearch::search(idx, addr, max);
            for (_, nGolden in GoldenTextSearch::resolve(idx, hits)) {
                var nPoi = nGolden as node<POIRecordProvider>;
                pois.add(nPoi);
                results.add(POIRecordRef { ref: nPoi, record: nGolden->toMengplazRecord() });
            }
        }
    } else {
        var idx = SourceTextSearch::ready(srcName);
        if (idx == null) {
            warn("searchAddress: ${srcName} text index not built - run `greycat run buildSourceTextIndexes`");
        } else {
            var hits = SourceTextSearch::search(idx, addr, max);
            for (_, nRecord in SourceTextSearch::resolve(nSource, idx, hits)) {
                pois.add(nRecord);
                results.add(POIRecordRef { ref: nRecord, record: nRecord->toMengplazRecord() });
            }
        }
    }

    var _t = ts.end();
    // address_searches.setAt(time::now(), AddressSearchInput { input: addr, source: srcName, results: pois });
    return results;
}

@volatile
type GoldenWithLinkedRecords {
    golden: POIRecord;
    osm: Array<LinkedRecordDetails<OSMFullRecord>>;
    caclr: Array<LinkedRecordDetails<CaclrPOIFullRecord>>;
    bda: Array<LinkedRecordDetails<BDAddressFullRecord>>;
}

@volatile
type LinkedRecordDetails<T> {
    score: ReconciliationCandidateScore?;
    record: T;
}

@expose
@permission("public")
@tag("openapi")
fn getGoldenWithLinkedRecords(addr: String): GoldenWithLinkedRecords? {
    var g = searchAddress(addr, 1, null);
    if (g.size() == 0) {
        return null;
    }
    var golden = g.get(0).ref as node<GoldenPointOfInterest>;
    var osm = Array<LinkedRecordDetails<OSMFullRecord>> {};
    var caclr = Array<LinkedRecordDetails<CaclrPOIFullRecord>> {};
    var bda = Array<LinkedRecordDetails<BDAddressFullRecord>> {};

    for (_, l in golden->linkedRecords) {
        var r = l.record.resolve();
        if (r is BDAddress) {
            bda.add(LinkedRecordDetails<BDAddressFullRecord> {
                record: r.toFullRecord(),
                score: l.detailedScore?.resolve()
            });
        } else if (r is OsmAddress) {
            osm.add(LinkedRecordDetails<OSMFullRecord> { record: r.toFullRecord(), score: l.detailedScore?.resolve() });
        } else if (r is CaclrBuilding) {
            caclr.add(LinkedRecordDetails<CaclrPOIFullRecord> {
                record: r.toFullRecord(),
                score: l.detailedScore?.resolve()
            });
        }
    }

    var r = GoldenWithLinkedRecords { golden: golden->toMengplazRecord(), osm: osm, bda: bda, caclr: caclr };

    return r;
}

@expose
@permission("public")
fn publicStats() {}
