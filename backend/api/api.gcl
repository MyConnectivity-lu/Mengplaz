@expose
@permission("public")
fn getPoisInStreet(e: node<StreetRecordProvider>): Array<POIRecordRef> {
    var ts = Traffic_Service::start(getPoisInStreet);
    var pois = e->getPOIs();
    ts.end();
    return pois;
}

@expose
@permission("public")
fn searchStreet(e: String): Array<StreetRecordRef> {
    var ts = Traffic_Service::start(searchStreet);
    var threshold = 0.7;
    var searchResults = GoldenServices::searchStreet(e, threshold, null);
    var res = Array<StreetRecordRef> {};
    for (_, i in searchResults limit 50) {
        //pprint(i);
        res.add(StreetRecordRef {
                ref: i.elem,
                record: i.elem->toRecord(),
            });
    }
    ts.end();
    return res;
}

@volatile
type POIFeatures {
    coords: geo;
    number: String;
}

@expose
@permission("public")
fn getPois(): Array<POIFeatures> {
    var ts = Traffic_Service::start(getPois);
    var feats = Array<POIFeatures> {};
    feats.set_capacity(golden_pois_by_geo.size());
    for (key, value in golden_pois_by_geo) {
        feats.add(POIFeatures {
                coords: key,
                number: "${value->number}${value->multipleCode}"
            });
    }
    ts.end();
    return feats;
}

@expose
@permission("public")
fn getPoisByGeo(coords: geo): POIRecordRef? {
    var ts = Traffic_Service::start(getPoisByGeo);
    var poi = golden_pois_by_geo.get(coords);
    ts.end();
    if (poi != null) {
        return POIRecordRef {
            ref: poi,
            record: poi->toMengplazRecord(),
        };
    }
}

@volatile
type GoldenRecordDetails {
    golden: POIRecordRef;
    associated: Array<POIFullRecordRef>;
}

@expose
fn getGoldenRecordDetails(ref: node<GoldenPointOfInterest>): GoldenRecordDetails {
    var ts = Traffic_Service::start(getGoldenRecordDetails);

    var linked: Array<POIFullRecordRef> = Array<POIFullRecordRef> {};
    for (_, l in ref->linkedRecords) {
        linked.add(POIFullRecordRef {
                ref: l,
                record: l->toFullRecord(),
            });
    }

    ts.end();

    return GoldenRecordDetails {
        golden: POIRecordRef {
            ref: ref,
            record: ref->toMengplazRecord(),
        },
        associated: linked,
    };
}

@volatile
type LinkedRecordsDetails {
    golden: POIRecordRef;
    associated: POIFullRecordRef;
}

@expose
fn getLinkedRecordDetails(other: node<POIRecordProvider>): LinkedRecordsDetails? {
    var ts = Traffic_Service::start(getLinkedRecordDetails);
    var nGolden = other->getLinkedGolden();
    ts.end();
    if (nGolden == null) {
        return null;
    } else {
        return LinkedRecordsDetails {
            golden: POIRecordRef {
                ref: nGolden,
                record: nGolden->toMengplazRecord(),
            },
            associated: POIFullRecordRef {
                ref: other,
                record: other->toFullRecord(),
            },
        };
    }
}

@expose
fn getPoiRecordRef(ref: node<POIRecordProvider>): POIRecordRef {
    var ts = Traffic_Service::start(getPoiRecordRef);
    ts.end();
    return POIRecordRef {
        ref: ref,
        record: ref->toMengplazRecord(),
    };
}

@expose
fn getGoldenRecordRefByUid(uid: String): POIRecordRef? {
    var ts = Traffic_Service::start(getGoldenRecordRefByUid);
    var nGolden = golden_pois_by_id.get(uid);
    ts.end();
    if (nGolden != null) {
        return POIRecordRef {
            ref: nGolden,
            record: nGolden->toMengplazRecord(),
        };
    }
    return null;
}


@expose
fn searchByItem(item: SearchItem): mengplaz::SearchResult {
    var ts = Traffic_Service::start(searchByItem);
    var goldenSource = sources_by_name.get(GoldenSource::NAME)!!;
    var searchResult = goldenSource->search(
        SearchRequest {
            params: SearchParameters {
                citySimilarityThreshold: 0.7,
                streetSimilarityThreshold: 0.7,
                buildingSimilarityThreshold: 0.7,
                maxCandidatesPerItem: 20,
            },
            items: Array<SearchItem> { item },
        }
    );
    ts.end();
    return searchResult[0];
}

@expose
@permission("public")
fn getRecordByGeoportailID(id: String): POIRecordRef? {
    var ts = Traffic_Service::start(getRecordByGeoportailID);
    var record = bda_address_by_geoportalid.get(id);
    ts.end();
    if (record != null) {
        var nGolden = record->getLinkedGolden();
        if (nGolden != null) {
            return POIRecordRef {
                ref: nGolden,
                record: nGolden->toMengplazRecord(),
            };
        }
    }
    return null;
}

@volatile
type GoldenIndex {
    id: String;
    name: String;
}

@expose
@permission("public")
fn getGoldenCities(): Array<GoldenIndex> {
    var ts = Traffic_Service::start(getGoldenCities);
    var cities = Array<GoldenIndex> {};
    for (id, nCity in golden_cities_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        cities.add(GoldenIndex {
                id: id,
                name: nCity->name
            });
    }
    cities.sort_by(GoldenIndex::name, SortOrder::asc);
    ts.end();
    return cities;
}

@expose
@permission("public")
fn getGoldenStreetsByCityId(cityId: String): Array<GoldenIndex> {
    var ts = Traffic_Service::start(getGoldenStreetsByCityId);
    var nCity = golden_cities_by_id.get(cityId);
    if (nCity == null) {
        throw "City with id ${cityId} not found";
    }
    var streets = Array<GoldenIndex> {};
    for (id, nStreet in nCity->streets_by_id) {
        if (id == "UNKNOWN") {
            continue;
        }
        streets.add(GoldenIndex {
                id: id,
                name: nStreet->name
            });
    }
    streets.sort_by(GoldenIndex::name, SortOrder::asc);
    ts.end();
    return streets;
}

@expose
@permission("public")
fn getGoldenNumbersByStreetId(streetId: String): Array<GoldenIndex> {
    var ts = Traffic_Service::start(getGoldenNumbersByStreetId);
    var nStreet = golden_streets_by_id.get(streetId);
    if (nStreet == null) {
        throw "Street with id ${streetId} not found";
    }
    var numbers = Array<GoldenIndex> {};
    for (id, nPOI in nStreet->pois_by_id) {
        numbers.add(GoldenIndex {
                id: id,
                name: "${nPOI->number} ${nPOI->multipleCode}",
            });
    }
    numbers.sort_by(GoldenIndex::name, SortOrder::asc);
    ts.end();
    return numbers;
}

@expose
@permission("public")
fn getGoldenRecords(): Array<POIRecord> {
    var ts = Traffic_Service::start(getGoldenRecords);
    var records = Array<POIRecord> {};
    for (id, nPOI in golden_pois_by_id) {
        records.add(nPOI->toMengplazRecord());
    }
    ts.end();
    return records;
}

@expose
@permission("public")
fn openapi() {
    var ts = Traffic_Service::start(openapi);
    var oa = OpenApi::v3();
    oa.info.title = "MengPlaz";
    oa.info.version = "1.2.2";
    var tmpPaths = Map<String, runtime::PathItemObject> {};

    if (oa.paths?.contains("/api::getGoldenCities") == true) {
        var path = oa.paths.get("/api::getGoldenCities")!!;
        path.post.description = "Returns all the cities in the Golden collection.<br>Provides the *cityId* to be used with **getGoldenStreetsByCityId**";
        tmpPaths.set("/api::getGoldenCities", path);
    }
    if (oa.paths?.contains("/api::getGoldenStreetsByCityId") == true) {
        var path = oa.paths.get("/api::getGoldenStreetsByCityId")!!;
        path.post.description = "Returns all the streets in the city referenced by this *cityId*.<br>Provides the *streetId* to be used with **getGoldenNumbersByStreetId**";
        tmpPaths.set("/api::getGoldenStreetsByCityId", path);
    }
    if (oa.paths?.contains("/api::getGoldenNumbersByStreetId") == true) {
        var path = oa.paths.get("/api::getGoldenNumbersByStreetId")!!;
        path.post.description = "Returns all the numbers in the street referenced by this *streetId*.";
        tmpPaths.set("/api::getGoldenNumbersByStreetId", path);
    }

    if (oa.paths?.contains("/api::getGoldenRecords") == true) {
        var path = oa.paths.get("/api::getGoldenRecords")!!;
        path.post.description = "Returns all Points Of Interest (POIs) in the Golden collection.";
        tmpPaths.set("/api::getGoldenRecords", path);
    }

    if (oa.paths?.contains("/api::getRecordByGeoportailID") == true) {
        var path = oa.paths.get("/api::getRecordByGeoportailID")!!;
        path.post.description = "Returns the Golden POI associated with the given *geoportal_id*";
        tmpPaths.set("/api::getRecordByGeoportailID", path);
    }

    if (oa.paths?.contains("/api::getGoldenRecordRefByUid") == true) {
        var path = oa.paths.get("/api::getGoldenRecordRefByUid")!!;
        path.post.description = "Returns the Golden POI associated with the given *uid*";
        tmpPaths.set("/api::getGoldenRecordRefByUid", path);
    }
    

    oa.paths = tmpPaths;
    ts.end();
    return oa;
}
