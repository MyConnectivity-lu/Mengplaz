var golden_constituency_by_code: nodeIndex<String, node<GoldenConstituency>>;
var golden_cantons_by_id: nodeIndex<String, node<GoldenCanton>>;
var golden_municipalities_by_id: nodeIndex<String, node<GoldenMunicipality>>;
var golden_cities_by_id: nodeIndex<String, node<GoldenCity>>;
var golden_streets_by_id: nodeIndex<String, node<GoldenStreet>>;
var golden_pois_by_id: nodeIndex<String, node<GoldenPointOfInterest>>;

var golden_pois_by_geo: nodeGeo<node<GoldenPointOfInterest>>;

type GoldenSource extends DataSource {
    static NAME: String = "Golden";
    static WEIGHT: float = 0.0;

    qualityHistory: nodeTime<float>;

    static fn init() {
        //Declare the source
        var source = sources_by_name.get(GoldenSource::NAME);
        if (source == null) {
            var source = GoldenSource {
                reconciliationReport: node<ReconciliationReport> { ReconciliationReport::init() },
                qualityHistory: nodeTime<float> {}
            };
            sources_by_name.set(source.name(), node<DataSource> { source });
        }
    }

    fn name(): String {
        return GoldenSource::NAME;
    }

    fn getWeight(): float {
        return GoldenSource::WEIGHT;
    }

    fn getReconciliationReport(): ReconciliationReport? {
        return *this.reconciliationReport;
    }

    fn search(req: SearchRequest): Array<mengplaz::SearchResult> {
        return GoldenServices::search(req);
    }

    fn getIndex():nodeIndex<String, node<POIRecordProvider>> {
        return golden_pois_by_id;
    }
}

type GoldenConstituency {
    code: String;
    name: String;
    nameAliases: Array<Alias>;

    cantons_by_id: nodeIndex<String, node<GoldenCanton>>;
}

type GoldenCanton {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    constituency: node<GoldenConstituency>;
    municipalities_by_id: nodeIndex<String, node<GoldenMunicipality>>;
}

type GoldenMunicipality {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    canton: node<GoldenCanton>;
    cities_by_id: nodeIndex<String, node<GoldenCity>>;
}

type GoldenCity {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    municipality: node<GoldenMunicipality>;
    streets_by_id: nodeIndex<String, node<GoldenStreet>>;
}

type GoldenStreet extends StreetRecordProvider {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    city: node<GoldenCity>;
    pois_by_id: nodeIndex<String, node<GoldenPointOfInterest>>;

    fn toRecord(): StreetRecord {
        var record = StreetRecord {
            street: this.name,
            city: this.city->name,
        };
        if (this.nameAliases.size() > 0) {
            record.streetAliases = this.nameAliases;
        }
        if (this.city->nameAliases.size() > 0) {
            record.cityAliases = this.city->nameAliases;
        }
        return record;
    }

    fn getPOIs(): Array<POIRecordRef> {
        var arr = Array<POIRecordRef> {};
        for (_, ref in this.pois_by_id) {
            arr.add(POIRecordRef {
                    ref: ref,
                    record: ref->toMengplazRecord(),
                });
        }
        return arr;
    }
}

type GoldenPointOfInterest extends POIRecordProvider {
    uid: String;

    number: int;
    multipleCode: String;

    postCode: String;

    primaryLocation: geo?;

    secondaryLocations: Map<String, geo>;

    lastUpdate: time;

    street: node<GoldenStreet>?;

    linkedRecords: Array<LinkedRecordEntry>;

    quality: nodeTime<QualityEvent>;

    @permission("admin")
    fn linkToGolden(nGolden: node<GoldenPointOfInterest>) {
        //NOOP
    }

    @permission("admin")
    fn unlinkGolden() {
        //NOOP
    }

    fn getLinkedGolden(): node<GoldenPointOfInterest>? {
        return null;
    }

    fn toFullRecord(): any {
        return this.toMengplazRecord();
    }

    fn promoteToGolden(record: node<POIRecordProvider>) {
        throw "Record is already Golden, it can't be promoted";
    }

    fn toMengplazRecord(): POIRecord {
        var record = POIRecord {
            uid: this.uid,
            number: "${this.number}${this.multipleCode}",
            street: this.street?->name,
            postcode: this.postCode,
            locality: this.street?->city->name,
            primaryLocation: this.primaryLocation,
            secondaryLocations: this.secondaryLocations,
            sourceName: GoldenSource::NAME,
            quality: this.quality.last()?.score
        };
        if (this.street != null) {
            if (this.street->nameAliases.size() > 0) {
                record.streetAliases = this.street->nameAliases;
            }
            if (this.street->city->nameAliases.size() > 0) {
                record.cityAliases = this.street->city->nameAliases;
            }
        }
        return record;
    }

    fn getSource(): node<DataSource> {
        return sources_by_name.get(GoldenSource::NAME)!!;
    }

    fn getId(): String {
        return this.uid;
    }

    fn toSearchItem(){};

    fn getSourceName(): String {
        return GoldenSource::NAME;
    }

    fn addStreetAlias(name:String){
        if (this.street != null && name != this.street->name) {
            var found = false;
            for (_, alias in this.street->nameAliases) {
                if (alias.value == name) {
                    found = true;
                    break;
                }
            }
            if (found == false ) {
                this.street->nameAliases.add(Alias { value: name, id: ""});
            }
        }
    }    
    
    fn addCityAlias(name:String){
        var city = this.street?->city;
        if (city != null && name != city->name) {
            var found = false;
            for (_, alias in city->nameAliases) {
                if (alias.value == name) {
                    found = true;
                    break;
                }
            }
            if (found == false ) {
                city->nameAliases.add(Alias { value: name, id: ""});
            }
        }
    }

    fn removeStreetAlias(name: String) {
        if (this.street != null) {
            for (i, alias in this.street->nameAliases) {
                if (alias.value == name) {
                    this.street->nameAliases.remove(i);
                    break;
                }
            }
        }
    }

    fn removeCityAlias(name: String) {
        var city = this.street?->city;
        if (city != null) {
            for (i, alias in city->nameAliases) {
                if (alias.value == name) {
                    city->nameAliases.remove(i);
                    break;
                }
            }
        }
    }

    fn getStreet(): String? {
        return this.street?->name;
    }

    fn getCity(): String? {
        return this.street?->city->name;
    }
}
