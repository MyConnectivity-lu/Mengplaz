var golden_constituencies_by_code: nodeIndex<String, node<GoldenConstituency>>;
var golden_cantons_by_id: nodeIndex<String, node<GoldenCanton>>;
var golden_municipalities_by_id: nodeIndex<String, node<GoldenMunicipality>>;
var golden_cities_by_id: nodeIndex<String, node<GoldenCity>>;
var golden_streets_by_id: nodeIndex<String, node<GoldenStreet>>;
var golden_addresses_by_id: nodeIndex<String, node<GoldenAddress>>;

var golden_municipalities_by_name: nodeIndex<String, node<GoldenMunicipality>>;
var golden_cities_by_name: nodeIndex<String, Array<node<GoldenCity>>>;
var golden_streets_by_name: nodeIndex<String, Array<node<GoldenStreet>>>;

var golden_addresses_by_geo: nodeGeo<node<GoldenAddress>>;

type GoldenSource extends DataSource {
    static NAME: String = "Golden";
    static WEIGHT: float = 0.0;

    qualityHistory: nodeTime<float>;

    static fn init() {
        var source = sources_by_name.get(GoldenSource::NAME);
        if (source == null) {
            var source = GoldenSource {
                reconciliationReport: node<ReconciliationReport> { ReconciliationReport::init() },
                qualityHistory: nodeTime<float> {}
            };
            sources_by_name.set(source.name(), node<DataSource> { source });
        }
    }

    fn name(): String {
        return GoldenSource::NAME;
    }

    fn getWeight(): float {
        return GoldenSource::WEIGHT;
    }

    fn getReconciliationReport(): ReconciliationReport? {
        return *this.reconciliationReport;
    }

    fn getIndex(): nodeIndex<String, node<AddressRecordProvider>> {
        return golden_addresses_by_id;
    }
}

type GoldenConstituency {
    code: String;
    name: String;
    nameAliases: Array<Alias>;

    cantons_by_id: nodeIndex<String, node<GoldenCanton>>;

    caclrConstituency: node<CaclrConstituency>?;
}

type GoldenCanton {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    constituency: node<GoldenConstituency>;
    municipalities_by_id: nodeIndex<String, node<GoldenMunicipality>>;
    caclrCanton: node<CaclrCanton>?;
}

type GoldenMunicipality {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    canton: node<GoldenCanton>;
    cities_by_id: nodeIndex<String, node<GoldenCity>>;
    cities_by_name: nodeIndex<String, node<GoldenCity>>?;

    caclrMunicipality: node<CaclrMunicipality>?;

    fn indexing(self: node<GoldenMunicipality>) {
        var munKey = this.name.lowercase();

        if (this.cities_by_name == null) {
            this.cities_by_name = nodeIndex<String, node<GoldenCity>> {};
        }

        this.canton->municipalities_by_id.set(this.id, self);
        golden_municipalities_by_id.set(this.id, self);
        golden_municipalities_by_name.set(munKey, self);
    }
}

type GoldenCity {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    municipality: node<GoldenMunicipality>;
    streets_by_id: nodeIndex<String, node<GoldenStreet>>;
    streets_by_name: nodeIndex<String, node<GoldenStreet>>?;

    caclrCity: node<CaclrCity>?;

    fn indexing(self: node<GoldenCity>) {
        var cityKey = this.name.lowercase();
        var cities = golden_cities_by_name.get(cityKey);
        if (cities == null) {
            cities = Array<node<GoldenCity>> {};
        }
        cities.add(self);

        if (this.streets_by_name == null) {
            this.streets_by_name = nodeIndex<String, node<GoldenStreet>> {};
        }

        this.municipality->cities_by_id.set(this.id, self);
        this.municipality->cities_by_name?.set(cityKey, self);
        golden_cities_by_id.set(this.id, self);
        golden_cities_by_name.set(cityKey, cities);
    }
}

type GoldenStreet extends StreetRecordProvider {
    id: String;

    name: String;
    nameAliases: Array<Alias>;

    lastUpdate: time;

    city: node<GoldenCity>;
    addresses_by_id: nodeIndex<String, node<GoldenAddress>>;
    addresses_by_number: nodeIndex<String, node<GoldenAddress>>?;

    caclrStreet: node<CaclrStreet>?;

    fn toRecord(): StreetRecord {
        var record = StreetRecord {
            street: this.name,
            city: this.city->name,
        };
        if (this.nameAliases.size() > 0) {
            record.streetAliases = this.nameAliases;
        }
        if (this.city->nameAliases.size() > 0) {
            record.cityAliases = this.city->nameAliases;
        }
        return record;
    }

    fn getAddresses(): Array<AddressRecordRef> {
        var arr = Array<AddressRecordRef> {};
        for (_, ref in this.addresses_by_id) {
            arr.add(AddressRecordRef {
                ref: ref,
                record: ref->toAddressRecord(),
            });
        }
        return arr;
    }

    fn indexing(self: node<GoldenStreet>) {
        var streetKey = this.name.lowercase();
        var streets = golden_streets_by_name.get(streetKey);
        if (streets == null) {
            streets = Array<node<GoldenStreet>> {};
        }
        streets.add(self);

        if (this.addresses_by_number == null) {
            this.addresses_by_number = nodeIndex<String, node<GoldenAddress>> {};
        }

        golden_streets_by_name.set(streetKey, streets);
        golden_streets_by_id.set(this.id, self);
        this.city->streets_by_name?.set(streetKey, self);
        this.city->streets_by_id.set(this.id, self);
    }
}

type GoldenAddress extends AddressRecordProvider {
    uid: String;

    number: int;
    multipleCode: String;

    postcode: String;

    primaryLocation: geo?;

    secondaryLocations: Map<String, geo>;

    lastUpdate: time;

    createdAt: time?;

    /// True once every CaclrAddress backing this record is itself deprecated: the golden
    /// outlives its source data, but it is no longer an active address. Nullable only
    /// because the graph predates the field - null reads as active.
    deprecated: bool?;

    street: node<GoldenStreet>?;

    linkedRecords: Array<LinkedRecordEntry>;

    quality: nodeTime<QualityEvent>;

    fn linkToGolden(_nGolden: node<GoldenAddress>) {}

    fn unlinkGolden() {}

    fn getLinkedGolden(): node<GoldenAddress>? {
        return null;
    }

    fn isDeprecated(): bool {
        return this.deprecated ?? false;
    }

    fn isLinked(): bool {
        return this.linkedRecords.size() > 0;
    }

    fn toFullRecord(): any {
        return this.toAddressRecord();
    }

    fn promoteToGolden(_record: node<AddressRecordProvider>) {
        throw "Record is already Golden, it can't be promoted";
    }

    fn toAddressRecord(): AddressRecord {
        var record = AddressRecord {
            uid: this.uid,
            number: "${this.number} ${this.multipleCode}",
            street: this.street?->name,
            postcode: this.postcode,
            locality: this.street?->city->name,
            commune: this.street?->city->municipality->name,
            primaryLocation: this.primaryLocation,
            secondaryLocations: this.secondaryLocations,
            sourceName: GoldenSource::NAME,
            quality: this.quality.last()?.score,
            deprecated: this.deprecated
        };
        if (this.street != null) {
            if (this.street->nameAliases.size() > 0) {
                record.streetAliases = this.street->nameAliases;
            }
            if (this.street->city->nameAliases.size() > 0) {
                record.localityAliases = this.street->city->nameAliases;
            }
        }
        return record;
    }

    fn getSource(): node<DataSource> {
        return sources_by_name.get(GoldenSource::NAME)!!;
    }

    fn getId(): String {
        return this.uid;
    }

    fn toSearchItem() {}

    fn getSourceName(): String {
        return GoldenSource::NAME;
    }

    fn addStreetAlias(name: String) {
        if (this.street != null && name != this.street->name) {
            var found = false;
            for (_, alias in this.street->nameAliases) {
                if (alias.value == name) {
                    found = true;
                    break;
                }
            }
            if (found == false) {
                this.street->nameAliases.add(Alias { value: name, id: "" });
            }
        }
    }

    fn addCityAlias(name: String) {
        var city = this.street?->city;
        if (city != null && name != city->name) {
            var found = false;
            for (_, alias in city->nameAliases) {
                if (alias.value == name) {
                    found = true;
                    break;
                }
            }
            if (found == false) {
                city->nameAliases.add(Alias { value: name, id: "" });
            }
        }
    }

    fn removeStreetAlias(name: String) {
        if (this.street != null) {
            for (i, alias in this.street->nameAliases) {
                if (alias.value == name) {
                    this.street->nameAliases.remove(i);
                    break;
                }
            }
        }
    }

    fn getStreet(): String? {
        return this.street?->name;
    }

    fn getCity(): String? {
        return this.street?->city->name;
    }

    fn getMunicipality(): String? {
        return this.street?->city->municipality->name;
    }

    fn getPostcode(): String? {
        return this.postcode;
    }

    fn indexing(self: node<GoldenAddress>) {
        var nStreet = this.street;
        if (nStreet != null) {
            var numKey = "${this.number}${this.multipleCode}";
            nStreet->addresses_by_number?.set(numKey, self);
            nStreet->addresses_by_id.set(this.uid, self);
        }

        golden_addresses_by_id.set(this.uid, self);

        if (this.primaryLocation != null) {
            golden_addresses_by_geo.set(this.primaryLocation, self);
        }

        // The text index is deliberately NOT updated here: `indexing()` also runs for every
        // POI of a backup restore, and one post-build append costs O(docs). `promoteToGolden`
        // appends a newly created POI instead.
    }
}

var golden_addresses_geo_recompute: nodeList<node<GoldenAddress>>;
