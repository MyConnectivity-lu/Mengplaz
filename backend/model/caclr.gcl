var caclr_consistuency_by_code: nodeIndex<String, node<CaclrConstituency>>;
var caclr_cantons_by_id: nodeIndex<String, node<CaclrCanton>>;
var caclr_municipalities_by_id: nodeIndex<String, node<CaclrMunicipality>>;
var caclr_cities_by_id: nodeIndex<String, node<CaclrCity>>;
var caclr_streets_by_id: nodeIndex<String, node<CaclrStreet>>;
var caclr_buildings_by_id: nodeIndex<String, node<CaclrBuilding>>;

var caclr_municipalities_by_name: nodeIndex<String, node<CaclrMunicipality>>;
var caclr_cities_by_name: nodeIndex<String, Array<node<CaclrCity>>>;
var caclr_streets_by_name: nodeIndex<String, Array<node<CaclrStreet>>>;

var caclr_buildings_by_geo: nodeGeo<node<CaclrBuilding>>;

enum CaclrDataStatus {
    ACTIVE("active");
    HISTORIC("historic");
    ALL("all");
}

enum CaclrAdminStatus {
    OFFICIAL("official");
}

type CaclrEurostatsIds {
    nuts3: String;
    lau1: String;
    lau2: String;
}

type CaclrConstituency {
    code: String;
    name: String;
    cantons_by_id: nodeIndex<String, node<CaclrCanton>>;
    goldenConstituency: node<GoldenConstituency>?;
}

type CaclrCanton {
    id: String;
    code: String;
    name: String;
    lastUpdate: time;

    constituency: node<CaclrConstituency>;
    municipalities_by_id: nodeIndex<String, node<CaclrMunicipality>>;
    goldenCanton: node<GoldenCanton>?;
}

type CaclrMunicipality {
    id: String;
    code: String;
    coficomCode: String;
    compoundCode: String;

    name: String;
    nameUpperCase: String;
    nameLu: String;

    status: CaclrDataStatus;
    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    eurostats: CaclrEurostatsIds;

    canton: node<CaclrCanton>;

    cities_by_id: nodeIndex<String, node<CaclrCity>>;
    cities_by_name: nodeIndex<String, node<CaclrCity>>?;

    goldenMunicipality: node<GoldenMunicipality>?;

    fn indexing(self: node<CaclrMunicipality>) {
        var munKey = this.name.lowercase();

        if (this.cities_by_name == null) {
            this.cities_by_name = nodeIndex<String, node<CaclrCity>> {};
        }

        this.canton->municipalities_by_id.set(this.id, self);
        caclr_municipalities_by_id.set(this.id, self);
        caclr_municipalities_by_name.set(munKey, self);
    }
}

type CaclrCity {
    id: String;
    code: String;
    compoundCode: String;

    name: String;
    nameUpperCase: String;
    aliases: Array<Alias>;

    isTown: bool;

    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    municipality: node<CaclrMunicipality>;
    streets_by_id: nodeIndex<String, node<CaclrStreet>>;
    streets_by_name: nodeIndex<String, node<CaclrStreet>>?;

    goldenCity: node<GoldenCity>?;

    fn indexing(self: node<CaclrCity>) {
        var cityKey = this.name.lowercase();
        var cities = caclr_cities_by_name.get(cityKey);
        if (cities == null) {
            cities = Array<node<CaclrCity>> {};
        }
        cities.add(self);

        if (this.streets_by_name == null) {
            this.streets_by_name = nodeIndex<String, node<CaclrStreet>> {};
        }

        this.municipality->cities_by_id.set(this.id, self);
        this.municipality->cities_by_name?.set(cityKey, self);
        caclr_cities_by_id.set(this.id, self);
        caclr_cities_by_name.set(cityKey, cities);
    }
}

type CaclrStreet {
    id: String;
    name: String;
    nameUpperCase: String;
    keyWord: String;

    aliases: Array<Alias>;

    administrativeStatus: CaclrAdminStatus;

    isPlace: bool;

    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    city: node<CaclrCity>;

    buildings_by_id: nodeIndex<String, node<CaclrBuilding>>;
    buildings_by_number: nodeIndex<String, node<CaclrBuilding>>?;

    goldenStreet: node<GoldenStreet>?;

    fn indexing(self: node<CaclrStreet>) {
        var streetKey = this.name.lowercase();
        var streets = caclr_streets_by_name.get(streetKey);
        if (streets == null) {
            streets = Array<node<CaclrStreet>> {};
        }
        streets.add(self);

        if (this.buildings_by_number == null) {
            this.buildings_by_number = nodeIndex<String, node<CaclrBuilding>> {};
        }

        caclr_streets_by_name.set(streetKey, streets);
        caclr_streets_by_id.set(this.id, self);
        this.city->streets_by_name?.set(streetKey, self);
        this.city->streets_by_id.set(this.id, self);
    }
}

@volatile
type CaclrPOIFullRecord {
    id: String;
    number: int;
    multipleCode: String;
    postalCode: String;
    street: String?;
    streetAliases: Array<Alias>?;
    locality: String?;
    localityAliases: Array<Alias>?;
    commune: String?;
    canton: String?;
    constituency: String?;

    primaryLocation: geo?;

    administrativeStatus: CaclrAdminStatus;

    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    sourceName: String;
    goldenRef: node<GoldenPointOfInterest>?;
}

type CaclrBuilding extends POIRecordProvider {
    private id: String;
    private number: int;
    private isNumberUndefined: bool;

    private postalCode: String;
    private multipleCode: String;

    private position: geo?;

    private administrativeStatus: CaclrAdminStatus;

    private validityStartDate: time;
    private validityEndDate: time?;
    private lastUpdate: time;

    private street: node<CaclrStreet>?;

    private goldenRef: node<GoldenPointOfInterest>?;

    lastSeenAt: time?;

    fn linkToGolden(nGolden: node<GoldenPointOfInterest>) {
        this.goldenRef = nGolden;
    }

    fn unlinkGolden() {
        this.goldenRef = null;
    }

    fn getLinkedGolden(): node<GoldenPointOfInterest>? {
        return this.goldenRef;
    }

    fn promoteToGolden(streetIdx: String): node<GoldenPointOfInterest> {
        if (this.goldenRef != null) {
            throw "Record is linked to Golden";
        }
        var nGoldenStreet = golden_streets_by_id.get(streetIdx);
        if (nGoldenStreet == null) {
            throw "Could not find street";
        }

        var newUID: String;
        do {
            newUID = GoldenServices::generateUID();
        } while (golden_pois_by_id.get(newUID) != null);

        var ref = caclr_buildings_by_id.get(this.id)!!;

        var nGoldenPOI = node<GoldenPointOfInterest> {
            GoldenPointOfInterest {
                uid: newUID,
                number: this.number,
                multipleCode: this.multipleCode,
                postCode: this.postalCode,
                primaryLocation: this.position,
                secondaryLocations: Map<String, geo> {},
                lastUpdate: this.lastUpdate,
                linkedRecords: Array<LinkedRecordEntry> {},
                street: nGoldenStreet,
                quality: nodeTime<QualityEvent> {}
            }
        };
        nGoldenPOI->indexing(nGoldenPOI);

        return nGoldenPOI;
    }

    fn toFullRecord(): any {
        var record = CaclrPOIFullRecord {
            id: this.id,
            number: this.number,
            multipleCode: this.multipleCode,
            street: this.street?->name,
            postalCode: this.postalCode,
            locality: this.street?->city->name,
            commune: this.street?->city->municipality->name,
            canton: this.street?->city->municipality->canton->name,
            constituency: this.street?->city->municipality->canton->constituency->name,
            administrativeStatus: this.administrativeStatus,
            validityStartDate: this.validityStartDate,
            validityEndDate: this.validityEndDate,
            lastUpdate: this.lastUpdate,
            sourceName: CaclrSource::NAME,
            goldenRef: this.goldenRef,
            primaryLocation: this.position
        };

        if (this.street != null) {
            if (this.street->aliases.size() > 0) {
                record.streetAliases = this.street->aliases;
            }
            if (this.street->city->aliases.size() > 0) {
                record.localityAliases = this.street->city->aliases;
            }
        }

        return record;
    }

    fn toMengplazRecord(): POIRecord {
        var record = POIRecord {
            uid: this.id,
            number: "${this.number}${this.multipleCode}",
            street: this.street?->name,
            postcode: this.postalCode,
            locality: this.street?->city->name,
            commune: this.street?->city->municipality->name,
            primaryLocation: this.position,
            sourceName: CaclrSource::NAME,
            goldenRef: this.goldenRef,
        };

        if (this.street != null) {
            if (this.street->aliases.size() > 0) {
                record.streetAliases = this.street->aliases;
            }
            if (this.street->city->aliases.size() > 0) {
                record.localityAliases = this.street->city->aliases;
            }
        }
        return record;
    }

    fn getSource(): node<DataSource> {
        return sources_by_name.get(CaclrSource::NAME)!!;
    }

    fn getId(): String {
        return this.id;
    }

    fn getSourceName(): String {
        return CaclrSource::NAME;
    }

    fn toSearchItem(): SearchItem {
        return SearchItem {
            number: "${this.number}",
            multipleCode: "${this.multipleCode}",
            postcode: this.postalCode,
            street: this.street?->name.lowercase() ?? "",
            city: this.street?->city->name.lowercase() ?? "",
            coordinates: this.position,
        };
    }

    fn getStreet(): String? {
        return this.street?->name;
    }

    fn getCity(): String? {
        return this.street?->city->name;
    }

    fn getMunicipality(): String? {
        return this.street?->city->municipality->name;
    }

    fn getPostcode(): String? {
        return this.postalCode;
    }

    fn indexing(self: node<CaclrBuilding>) {
        var nStreet = this.street;
        if (nStreet != null) {
            var numKey = "${this.number}${this.multipleCode}";
            nStreet->buildings_by_number?.set(numKey, self);
            nStreet->buildings_by_id.set(this.id, self);
        }

        caclr_buildings_by_id.set(this.id, self);
    }
}

@volatile
type CaclrTokenResponse {
    access_token: String;
    token_type: String;
    expires_in: int;
    scope: String;
    iss: String;
}

private var caclr_token: node<CaclrToken?>;

type CaclrToken {
    access_token: String;
    token_type: String;
    expires_in: int;
    scope: String;
    iss: String;
    expiry_time: time;

    fn isValid(): bool {
        return (time::now() + 60_s) < this.expiry_time;
    }

    static fn renew(): CaclrToken {
        var clientId = System::getEnv("CACLR_API_CLIENT_ID");
        var clientSecret = System::getEnv("CACLR_API_CLIENT_SECRET");

        if (clientId == null || clientSecret == null) {
            throw "No credentials provided to conect to CACLR source.";
        }

        var endpoint = "https://oauth.api.etat.lu/api/oauth/token";
        var headers = Map<String, String> {
            "Content-Type": "application/x-www-form-urlencoded"
        };

        var params = Map<String, String> {
            "grant_type": "client_credentials",
            "client_id": clientId,
            "client_secret": clientSecret,
            "scope": "resource.READ",  //resource.WRITE
        };

        var request = HttpRequest {
            method: HttpMethod::POST,
            url: endpoint,
            headers: headers,
            body: Url::encode(params),
        };

        var httpClient = Http<CaclrTokenResponse> {};
        var response = httpClient.send(request);

        if (response.status_code != 200 || response.content == null) {
            error(response);
            throw "Error while retrieving token.";
        }
        var tokenData = response.content;
        var token = CaclrToken {
            token_type: tokenData.token_type,
            access_token: tokenData.access_token,
            scope: tokenData.scope,
            expires_in: tokenData.expires_in,
            iss: tokenData.iss,
            expiry_time: time::now() + duration::new(tokenData.expires_in, DurationUnit::seconds),
        };
        caclr_token.set(token);
        return token;
    }

    static fn get(): CaclrToken {
        var currentToken = *caclr_token;
        if (currentToken == null || !currentToken.isValid()) {
            return CaclrToken::renew();
        } else {
            return currentToken;
        }
    }
}

type CaclrSource extends DataSource {
    static NAME: String = "CACLR";
    static WEIGHT: float = 5.0;

    static fn init() {
        //Declare the source
        var source = sources_by_name.get(CaclrSource::NAME);
        if (source == null) {
            var source = CaclrSource {
                reconciliationReport: node<ReconciliationReport> { ReconciliationReport::init() }
            };
            sources_by_name.set(source.name(), node<DataSource> { source });
        }
    }

    fn name(): String {
        return CaclrSource::NAME;
    }

    fn getWeight(): float {
        return CaclrSource::WEIGHT;
    }

    fn getReconciliationReport(): ReconciliationReport? {
        return *this.reconciliationReport;
    }

    fn getIndex(): nodeIndex<String, node<POIRecordProvider>> {
        return caclr_buildings_by_id;
    }

    fn findLocalityScopes(name: String, max: int, distanceThreshold: int): Array<ScoredCity> {
        var byKey = Map<int, ScoredCity> {};

        var muniExact = caclr_municipalities_by_name.get(name);
        if (muniExact != null) {
            for (_, nCity in muniExact->cities_by_id) {
                byKey.set(nCity as int, ScoredCity { city: nCity, distance: 0.0 });
            }
        } else {
            var muniResults = caclr_municipalities_by_name.search(name, max);
            for (_, mr in muniResults) {
                if (mr.distance > distanceThreshold) {
                    continue;
                }
                for (_, nCity in mr.value->cities_by_id) {
                    var k = nCity as int;
                    if (byKey.get(k) == null) {
                        byKey.set(k, ScoredCity { city: nCity, distance: mr.distance });
                    }
                }
            }
        }

        var cityExact = caclr_cities_by_name.get(name);
        if (cityExact != null) {
            for (_, nCity in cityExact) {
                byKey.set(nCity as int, ScoredCity { city: nCity, distance: 0.0 });
            }
        } else {
            var cityResults = caclr_cities_by_name.search(name, max);
            for (_, cr in cityResults) {
                if (cr.distance > distanceThreshold) {
                    continue;
                }
                for (_, nCity in cr.value) {
                    var k = nCity as int;
                    if (byKey.get(k) == null) {
                        byKey.set(k, ScoredCity { city: nCity, distance: cr.distance });
                    }
                }
            }
        }

        var out = Array<ScoredCity> {};
        for (_, sc in byKey) {
            out.add(sc);
        }
        return out;
    }

    fn findStreetsInCity(sc: ScoredCity, road: String, max: int, distanceThreshold: int): Array<ScoredStreet> {
        var streets = Array<ScoredStreet> {};
        var nCity = sc.city as node<CaclrCity>;
        if (nCity->streets_by_name == null) {
            return streets;
        }
        var idx = nCity->streets_by_name;
        var exact = idx.get(road);
        if (exact != null) {
            streets.add(ScoredStreet { street: exact, distance: 0.0 });
            return streets;
        }
        var streetResults = idx.search(road, max);
        for (_, sr in streetResults) {
            if (sr.distance > distanceThreshold) {
                continue;
            }
            var jaroDist = 1.0 - sr.key.jaro(road);
            streets.add(ScoredStreet { street: sr.value, distance: jaroDist });
        }
        return streets;
    }

    fn findStreetsByName(road: String, max: int, distanceThreshold: int): Array<ScoredStreet> {
        var streets = Array<ScoredStreet> {};
        var exact = caclr_streets_by_name.get(road);
        if (exact != null) {
            for (_, nStreet in exact) {
                streets.add(ScoredStreet { street: nStreet, distance: 0.0 });
            }
            return streets;
        }
        var globalResults = caclr_streets_by_name.search(road, 100);
        for (_, gr in globalResults) {
            if (gr.distance > distanceThreshold) {
                continue;
            }
            var jaroDist = 1.0 - gr.key.jaro(road);
            for (_, nStreet in gr.value) {
                streets.add(ScoredStreet { street: nStreet, distance: jaroDist });
            }
        }
        return streets;
    }

    fn findPoisInStreet(ss: ScoredStreet, houseNumber: String?, postcode: String?, max: int, distanceThreshold: int): Array<ScoredPoi> {
        var results = Array<ScoredPoi> {};
        var nStreet = ss.street as node<CaclrStreet>;
        if (houseNumber == null) {
            for (_, nPoi in nStreet->buildings_by_id) {
                if (postcode == null || nPoi->getPostcode() == postcode) {
                    results.add(ScoredPoi { poi: nPoi, distance: 4.0 });
                }
            }
            return results;
        }
        var exact = nStreet->buildings_by_number?.get(houseNumber);
        if (exact != null) {
            if (postcode == null || exact->getPostcode() == postcode) {
                results.add(ScoredPoi { poi: exact, distance: 0.0 });
                return results;
            }
        }
        var poiResults = nStreet->buildings_by_number?.search(houseNumber, max);
        for (_, pr in poiResults?) {
            if (pr.distance > distanceThreshold) {
                continue;
            }
            results.add(ScoredPoi { poi: pr.value, distance: pr.distance });
        }
        return results;
    }
}
