var caclr_consistuency_by_code: nodeIndex<String, node<CaclrConstituency>>;
var caclr_cantons_by_id: nodeIndex<String, node<CaclrCanton>>;
var caclr_municipalities_by_id: nodeIndex<String, node<CaclrMunicipality>>;
var caclr_cities_by_id: nodeIndex<String, node<CaclrCity>>;
var caclr_streets_by_id: nodeIndex<String, node<CaclrStreet>>;
var caclr_buildings_by_id: nodeIndex<String, node<CaclrBuilding>>;

var caclr_buildings_by_geo: nodeGeo<node<CaclrBuilding>>;

enum CaclrDataStatus {
    ACTIVE("active");
    HISTORIC("historic");
    ALL("all");
}

enum CaclrAdminStatus {
    OFFICIAL("official");
}

type CaclrEurostatsIds {
    nuts3: String;
    lau1: String;
    lau2: String;
}

type CaclrConstituency {
    code: String;
    name: String;
    cantons_by_id: nodeIndex<String, node<CaclrCanton>>;
}

type CaclrCanton {
    id: String;
    code: String;
    name: String;
    lastUpdate: time;

    constituency: node<CaclrConstituency>;
    municipalities_by_id: nodeIndex<String, node<CaclrMunicipality>>;
}

type CaclrMunicipality {
    id: String;
    code: String;
    coficomCode: String;
    compoundCode: String;

    name: String;
    nameUpperCase: String;
    nameLu: String;

    status: CaclrDataStatus;
    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    eurostats: CaclrEurostatsIds;

    canton: node<CaclrCanton>;

    cities_by_id: nodeIndex<String, node<CaclrCity>>;
}

type CaclrCity {
    id: String;
    code: String;
    compoundCode: String;

    name: String;
    nameUpperCase: String;
    aliases: Array<Alias>;

    isTown: bool;

    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    municipality: node<CaclrMunicipality>;
    streets_by_id: nodeIndex<String, node<CaclrStreet>>;
}

type CaclrStreet {
    id: String;
    name: String;
    nameUpperCase: String;
    keyWord: String;

    aliases: Array<Alias>;

    administrativeStatus: CaclrAdminStatus;

    isPlace: bool;

    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    city: node<CaclrCity>;

    buildings_by_id: nodeIndex<String, node<CaclrBuilding>>;
}

@volatile
type CaclrPOIFullRecord {
    id: String;
    number: int;
    multipleCode: String;
    postalCode: String;
    locality: String?;
    streetAliases: Array<Alias>?;
    city: String?;
    cityAliases: Array<Alias>?;
    commune: String?;
    canton: String?;
    constituency: String?;

    primaryLocation: geo?;

    administrativeStatus: CaclrAdminStatus;

    validityStartDate: time;
    validityEndDate: time?;
    lastUpdate: time;

    sourceName: String;
    goldenRef: node<GoldenPointOfInterest>?;
}

type CaclrBuilding extends POIRecordProvider {
    private id: String;
    private number: int;
    private isNumberUndefined: bool;

    private postalCode: String;
    private multipleCode: String;

    private position: geo?;

    private administrativeStatus: CaclrAdminStatus;

    private validityStartDate: time;
    private validityEndDate: time?;
    private lastUpdate: time;

    private street: node<CaclrStreet>?;

    private goldenRef: node<GoldenPointOfInterest>?;

    fn linkToGolden(nGolden: node<GoldenPointOfInterest>) {
        this.goldenRef = nGolden;
    }

    fn unlinkGolden() {
        this.goldenRef = null;
    }

    fn getLinkedGolden(): node<GoldenPointOfInterest>? {
        return this.goldenRef;
    }

    fn promoteToGolden(streetIdx: String): node<GoldenPointOfInterest> {
        if (this.goldenRef != null) {
            throw "Record is linked to Golden";
        }
        var nGoldenStreet = golden_streets_by_id.get(streetIdx);
        if (nGoldenStreet == null) {
            throw "Could not find street";
        }

        var newUID: String;
        do {
            newUID = GoldenServices::generateUID();
        } while (golden_pois_by_id.get(newUID) != null);

        var ref = caclr_buildings_by_id.get(this.id)!!;

        var nGoldenPOI = node<GoldenPointOfInterest> {
            GoldenPointOfInterest {
                uid: newUID,
                number: this.number,
                multipleCode: this.multipleCode,
                postCode: this.postalCode,
                primaryLocation: this.position,
                secondaryLocations: Map<String, geo> {},
                lastUpdate: this.lastUpdate,
                linkedRecords: Array<LinkedRecordEntry> {},
                street: nGoldenStreet,
                quality: nodeTime<QualityEvent> {}
            }
        };
        nGoldenPOI->indexing(nGoldenPOI);

        return nGoldenPOI;
    }

    fn toFullRecord(): any {
        var record = CaclrPOIFullRecord {
            id: this.id,
            number: this.number,
            multipleCode: this.multipleCode,
            locality: this.street?->name,
            postalCode: this.postalCode,
            city: this.street?->city->name,
            commune: this.street?->city->municipality->name,
            canton: this.street?->city->municipality->canton->name,
            constituency: this.street?->city->municipality->canton->constituency->name,
            administrativeStatus: this.administrativeStatus,
            validityStartDate: this.validityStartDate,
            validityEndDate: this.validityEndDate,
            lastUpdate: this.lastUpdate,
            sourceName: CaclrSource::NAME,
            goldenRef: this.goldenRef,
            primaryLocation: this.position
        };

        if (this.street != null) {
            if (this.street->aliases.size() > 0) {
                record.streetAliases = this.street->aliases;
            }
            if (this.street->city->aliases.size() > 0) {
                record.cityAliases = this.street->city->aliases;
            }
        }

        return record;
    }

    fn toMengplazRecord(): POIRecord {
        var record = POIRecord {
            uid: this.id,
            number: "${this.number}${this.multipleCode}",
            street: this.street?->name,
            postcode: this.postalCode,
            locality: this.street?->city->name,
            commune: this.street?->city->municipality->name,
            primaryLocation: this.position,
            sourceName: CaclrSource::NAME,
            goldenRef: this.goldenRef,
        };

        if (this.street != null) {
            if (this.street->aliases.size() > 0) {
                record.streetAliases = this.street->aliases;
            }
            if (this.street->city->aliases.size() > 0) {
                record.localityAliases = this.street->city->aliases;
            }
        }
        return record;
    }

    fn getSource(): node<DataSource> {
        return sources_by_name.get(CaclrSource::NAME)!!;
    }

    fn getId(): String {
        return this.id;
    }

    fn getSourceName(): String {
        return CaclrSource::NAME;
    }

    fn toSearchItem(): SearchItem {
        return SearchItem {
            number: "${this.number}",
            multipleCode: "${this.multipleCode}",
            postcode: this.postalCode,
            street: this.street?->name.lowercase() ?? "",
            city: this.street?->city->name.lowercase() ?? "",
            coordinates: this.position,
        };
    }

    fn getStreet(): String? {
        return this.street?->name;
    }

    fn getCity(): String? {
        return this.street?->city->name;
    }
}

@volatile
type CaclrTokenResponse {
    access_token: String;
    token_type: String;
    expires_in: int;
    scope: String;
    iss: String;
}

private var caclr_token: node<CaclrToken?>;

type CaclrToken {
    access_token: String;
    token_type: String;
    expires_in: int;
    scope: String;
    iss: String;
    expiry_time: time;

    fn isValid(): bool {
        return (time::now() + 60_s) < this.expiry_time;
    }

    static fn renew(): CaclrToken {
        var clientId = System::getEnv("CACLR_API_CLIENT_ID");
        var clientSecret = System::getEnv("CACLR_API_CLIENT_SECRET");

        if (clientId == null || clientSecret == null) {
            throw "No credentials provided to conect to CACLR source.";
        }

        var endpoint = "https://oauth.api.etat.lu/api/oauth/token";
        var headers = Map<String, String> {
            "Content-Type": "application/x-www-form-urlencoded"
        };

        var params = Map<String, String> {
            "grant_type": "client_credentials",
            "client_id": clientId,
            "client_secret": clientSecret,
            "scope": "resource.READ",  //resource.WRITE
        };

        var request = HttpRequest {
            method: HttpMethod::POST,
            url: endpoint,
            headers: headers,
            body: Url::encode(params),
        };

        var httpClient = Http<CaclrTokenResponse> {};
        var response = httpClient.send(request);

        if (response.status_code != 200 || response.content == null) {
            error(response);
            throw "Error while retrieving token.";
        }
        var tokenData = response.content;
        var token = CaclrToken {
            token_type: tokenData.token_type,
            access_token: tokenData.access_token,
            scope: tokenData.scope,
            expires_in: tokenData.expires_in,
            iss: tokenData.iss,
            expiry_time: time::now() + duration::new(tokenData.expires_in, DurationUnit::seconds),
        };
        caclr_token.set(token);
        return token;
    }

    static fn get(): CaclrToken {
        var currentToken = *caclr_token;
        if (currentToken == null || !currentToken.isValid()) {
            return CaclrToken::renew();
        } else {
            return currentToken;
        }
    }
}

type CaclrSource extends DataSource {
    static NAME: String = "CACLR";
    static WEIGHT: float = 5.0;

    static fn init() {
        //Declare the source
        var source = sources_by_name.get(CaclrSource::NAME);
        if (source == null) {
            var source = CaclrSource {
                reconciliationReport: node<ReconciliationReport> { ReconciliationReport::init() }
            };
            sources_by_name.set(source.name(), node<DataSource> { source });
        }
    }

    fn name(): String {
        return CaclrSource::NAME;
    }

    fn getWeight(): float {
        return CaclrSource::WEIGHT;
    }

    fn getReconciliationReport(): ReconciliationReport? {
        return *this.reconciliationReport;
    }

    fn getIndex(): nodeIndex<String, node<POIRecordProvider>> {
        return caclr_buildings_by_id;
    }
}
