var osm_by_id: nodeIndex<String, node<OsmAddress>>;
var osm_partial_by_id: nodeList<node<OsmPartialAddress>>;
var osm_by_geo: nodeGeo<node<OsmAddress>>;
var osm_partial_by_geo: nodeGeo<node<OsmPartialAddress>>;

type OsmPartialAddress {
    id: int;
    position: geo?;
    city: String?;
    postcode: String?;
    street: String?;
    number: String?;
    ref_caclr: String?;
    map: Map;

    static fn parse(elem: Map): OsmPartialAddress {
        return OsmPartialAddress {
            id: elem.get("id") as int,
            map: elem,
        };
    }
}

@volatile
type OSMFullRecord {
    id: String;

    number: String;
    postcode: String;
    street: String;
    city: String;
    primaryLocation: geo?;

    sourceName: String;
    goldenRef: node<GoldenPointOfInterest>?;
}

type OsmAddress extends POIRecordProvider {
    private id: int;
    private position: geo;
    private city: String;
    private postcode: String;
    private street: String;
    private number: String;
    private ref_caclr: String?;
    private building: String?;

    private goldenRef: node<GoldenPointOfInterest>?;

    static fn parse(elem: Map): OsmAddress {
        var tags = elem.get("tags") as Map<String, String>;
        var kind = elem.get("type");
        var street = tags.get("addr:street") ?? tags.get("addr:place");
        if (street == null) {
            throw valueOf(AddrErr::STREET_MISSING);
        }
        var city = tags.get("addr:city");
        if (city == null) {
            throw valueOf(AddrErr::CITY_MISSING);
        }
        var postcode = tags.get("addr:postcode");
        if (postcode == null) {
            throw valueOf(AddrErr::POSTCODE_MISSING);
        }

        var lat = elem.get("lat") as float?;
        var lon = elem.get("lon") as float?;

        if (kind == "way") {
            lat = elem.get("center")?.get("lat") as float;
            lon = elem.get("center")?.get("lon") as float;
        }

        if (lat == null || lon == null) {
            throw "Can't read geo coordinates";
        }

        return OsmAddress {
            id: elem.get("id") as int,
            position: geo { lat, lon },
            city: city,
            postcode: postcode,
            street: street,
            number: tags.get("addr:housenumber") as String,
            ref_caclr: tags.get("ref:caclr"),
            building: tags.get("building")
        };
    }

    fn linkToGolden(nGolden: node<GoldenPointOfInterest>) {
        this.goldenRef = nGolden;
    }

    fn unlinkGolden() {
        this.goldenRef = null;
    }

    fn promoteToGolden(streetIdx: String): node<GoldenPointOfInterest> {
        if (this.goldenRef != null) {
            throw "Record is linked to Golden";
        }

        var nGoldenStreet = golden_streets_by_id.get(streetIdx);
        if (nGoldenStreet == null) {
            throw "Could not find street";
        }

        var newUID: String;
        do {
            newUID = GoldenServices::generateUID();
        } while (golden_pois_by_id.get(newUID) != null);
        var alphaNum = extractAlphaCharsFromStreetNumber(this.number);
        var nGoldenPOI = node<GoldenPointOfInterest> {
            GoldenPointOfInterest {
                uid: newUID,
                number: alphaNum.numerical,
                multipleCode: alphaNum.alpha,
                postCode: this.postcode,
                primaryLocation: this.position,
                secondaryLocations: Map<String, geo> {},
                lastUpdate: time::now(),
                linkedRecords: Array<LinkedRecordEntry> {},
                street: nGoldenStreet,
                quality: nodeTime<QualityEvent> {}
            }
        };
        nGoldenStreet->pois_by_id.set(nGoldenPOI->uid, nGoldenPOI);
        golden_pois_by_id.set(nGoldenPOI->uid, nGoldenPOI);
        if (nGoldenPOI->primaryLocation != null) {
            golden_pois_by_geo.set(nGoldenPOI->primaryLocation, nGoldenPOI);
        }
        return nGoldenPOI;
    }

    fn getLinkedGolden(): node<GoldenPointOfInterest>? {
        return this.goldenRef;
    }

    fn toFullRecord(): OSMFullRecord {
        return OSMFullRecord {
            id: "${this.id}",
            number: "${this.number}",
            street: this.street,
            postcode: this.postcode,
            city: this.city,
            primaryLocation: this.position,
            sourceName: OsmSource::NAME,
            goldenRef: this.goldenRef,
        };
    }

    fn toMengplazRecord(): POIRecord {
        var record = POIRecord {
            uid: "${this.id}",
            number: "${this.number}",
            street: this.street,
            postcode: this.postcode,
            city: this.city,
            primaryLocation: this.position,
            sourceName: OsmSource::NAME,
            goldenRef: this.goldenRef,
        };
        return record;
    }

    fn getSource(): node<DataSource> {
        return sources_by_name.get(OsmSource::NAME)!!;
    }

    fn getSourceName(): String {
        return OsmSource::NAME;
    }

    fn getId(): String {
        return "${this.id}";
    }

    fn toSearchItem(): SearchItem {
        var number = this.number;
        var multipleCode = "";
        try {
            var parse = extractAlphaCharsFromStreetNumber(this.number);
            number = "${parse.numerical}";
            multipleCode = parse.alpha;
        } catch (_) {}
        return SearchItem {
            number: number,
            multipleCode: multipleCode,
            postcode: this.postcode,
            street: this.street.lowercase(),
            city: this.city.lowercase(),
            coordinates: this.position
        };
    }
    fn getStreet(): String? {
        return this.street;
    }

    fn getCity(): String? {
        return this.city;
    }
}

type OsmSource extends DataSource {
    static NAME: String = "OSM";
    static WEIGHT: float = 2.0;

    static fn init() {
        //Declare the source
        var source = sources_by_name.get(OsmSource::NAME);
        if (source == null) {
            var source = OsmSource {
                reconciliationReport: node<ReconciliationReport> { ReconciliationReport::init() }
            };
            sources_by_name.set(source.name(), node<DataSource> { source });
        }
    }

    fn name(): String {
        return OsmSource::NAME;
    }

    fn getWeight(): float {
        return OsmSource::WEIGHT;
    }

    fn getReconciliationReport(): ReconciliationReport? {
        return *this.reconciliationReport;
    }

    fn search(req: SearchRequest): mengplaz::SearchResult {}

    fn getIndex(): nodeIndex<String, node<POIRecordProvider>> {
        return osm_by_id;
    }
}
