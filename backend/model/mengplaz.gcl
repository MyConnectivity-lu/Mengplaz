var sources_by_name: nodeIndex<String, node<DataSource>>;

enum QualityEventType {
    link;
    unlink;
    update;
}

type QualityEvent {
    @precision(0.01)
    score: float;
    sourceRecord: node<AddressRecordProvider>?;
    eventType: QualityEventType;
}

type SourceCountSnapshot {
    total: int;
    active: int;
    linked: int;
}

type LinkedRecordEntry {
    record: node<AddressRecordProvider>;
    @precision(0.01)
    score: float;
    detailedScore: node<ReconciliationCandidateScore>?;
}

abstract type DataSource {
    private reconciliationReport: node<ReconciliationReport>;
    private isReconciling: node<bool>?;

    lastUpdate: time?;

    countHistory: nodeTime<SourceCountSnapshot>?;

    abstract fn name(): String;
    abstract fn getWeight(): float;
    abstract fn getReconciliationReport(): ReconciliationReport?;
    abstract fn getIndex(): nodeIndex<String, node<AddressRecordProvider>>;

    static fn countRecords(nSource: node<DataSource>): SourceCountSnapshot {
        var total = 0;
        var active = 0;
        var linked = 0;
        for (_, nRecord in nSource->getIndex()) {
            total++;
            if (!nRecord->isDeprecated()) {
                active++;
            }
            if (nRecord->isLinked()) {
                linked++;
            }
        }
        return SourceCountSnapshot { total: total, active: active, linked: linked };
    }

    static fn countHistoryOrCreate(nSource: node<DataSource>): nodeTime<SourceCountSnapshot> {
        var history = nSource->countHistory;
        if (history == null) {
            history = nodeTime<SourceCountSnapshot> {};
            nSource->countHistory = history;
        }
        return history;
    }

    static fn recordCounts(nSource: node<DataSource>, snapshot: SourceCountSnapshot) {
        DataSource::countHistoryOrCreate(nSource).setAt(time::now(), snapshot);
    }

    static fn reconcile(
        nSource: node<DataSource>,
        searchParams: SearchParameters?,
        pois: Array<node<AddressRecordProvider>>?
    ): ReconciliationReport {
        if (searchParams == null) {
            searchParams = SearchParameters::default();
        }
        var workers = Runtime::info().bg_threads;
        var jobs = Array<Job> {};
        for (var i = 0; i < workers; i++) {
            jobs.add(Job<any?> {
                function: GoldenServices::search,
                arguments: [SearchRequest { items: Array<node<AddressRecordProvider>> {}, params: searchParams }],
            });
        }

        var count = 0;
        for (_, sourceRecord in pois ?? nSource->getIndex()) {
            if (sourceRecord->getLinkedGolden() == null) {
                jobs[count % workers].arguments!![0]!!.items.add(sourceRecord);
                count++;
            }
        }

        await(jobs, MergeStrategy::last_wins);

        var report = nSource->reconciliationReport.resolve();
        for (_, job in jobs) {
            for (_, searchResult in job.result() as Array<mengplaz::SearchResult>) {
                var candidates = searchResult.candidates;
                var results = Array<ReconciliationCandidate> {};
                var perfectMatch = 0;
                for (_, candidate in candidates) {
                    var reconCandidate = ReconciliationCandidate {
                        candidateRecord: candidate.elem,
                        mismatch: null,
                        score: ReconciliationCandidateScore {
                            cityScore: candidate.cityScore,
                            numberScore: candidate.numberScore,
                            postcodeScore: candidate.postcodeScore,
                            streetScore: candidate.streetScore,
                            geoScore: candidate.realGeoScore,
                            overallScore: candidate.realOverallScore
                        }
                    };
                    if (candidate.searchOverallScore != 1) {
                        var reason = MengplazMismatch::COMPLEX_MISMATCH;
                        if (candidate.cityScore == 1) {
                            if (candidate.postcodeScore == 1) {
                                if (candidate.streetScore == 1) {
                                    reason = MengplazMismatch::NUMBER_MISMATCH;
                                } else if (candidate.numberScore == 1) {
                                    reason = MengplazMismatch::STREET_MISMATCH;
                                }
                            } else if (candidate.streetScore == 1 && candidate.numberScore == 1) {
                                reason = MengplazMismatch::POSTCODE_MISMATCH;
                            }
                        }
                        reconCandidate.mismatch = reason;
                    } else {
                        perfectMatch++;
                    }
                    results.add(reconCandidate);
                }
                if (perfectMatch > 1) {
                    for (_, res in results) {
                        res.mismatch = MengplazMismatch::MULTIPLE_MATCHES;
                    }
                }
                report.unlinked.set(searchResult.sourceRecord, results);
            }
        }
        return report;
    }

    fn setIsReconciling() {
        if (this.isReconciling == null) {
            this.isReconciling = node<bool> { true };
        } else {
            this.isReconciling.set(true);
        }
    }

    fn clearIsReconciling() {
        this.isReconciling?.set(false);
    }
}

type ReconciliationCandidateScore {
    @precision(0.01)
    cityScore: float;
    @precision(0.01)
    streetScore: float;
    @precision(0.01)
    numberScore: float;
    @precision(0.01)
    postcodeScore: float;
    @precision(0.01)
    geoScore: float?;
    @precision(0.01)
    overallScore: float;
}

type ReconciliationCandidate {
    candidateRecord: node<AddressRecordProvider>;
    /// Null means 1.0; left unset to save space.
    score: ReconciliationCandidateScore?;
    mismatch: MengplazMismatch?;
    /// Linked records only: an unlinked score is temporary and never persisted.
    detailedScore: node<ReconciliationCandidateScore>?;
}

type ReconciliationReport {
    date: time;
    linked: nodeIndex<node<AddressRecordProvider>, ReconciliationCandidate>;
    unlinked: nodeIndex<node<AddressRecordProvider>, Array<ReconciliationCandidate>>;

    static fn init(): ReconciliationReport {
        return ReconciliationReport {
            date: time::now(),
            linked: nodeIndex<node<AddressRecordProvider>, ReconciliationCandidate> {},
            unlinked: nodeIndex<node<AddressRecordProvider>, Array<ReconciliationCandidate>> {}
        };
    }
}

@volatile
type StreetRecordRef {
    ref: node<StreetRecordProvider>;
    id: String;
    record: StreetRecord;
    score: float;
}

@volatile
type AddressRecordRef {
    ref: node<AddressRecordProvider>;
    record: AddressRecord;
}

@volatile
type AddressFullRecordRef {
    ref: node<AddressRecordProvider>;
    id: String;
    record: any;
    matchScore: float?;
}

@volatile
type AddressRecord {
    uid: String?;
    number: String?;
    postcode: String?;
    street: String?;
    streetAliases: Array<Alias>?;
    locality: String?;
    localityAliases: Array<Alias>?;
    commune: String?;
    primaryLocation: geo?;
    secondaryLocations: Map<String, geo>?;
    sourceName: String;
    goldenRef: node<GoldenAddress>?;
    quality: float?;
}

abstract type AddressRecordProvider {
    abstract fn linkToGolden(nGolden: node<GoldenAddress>);
    abstract fn unlinkGolden();
    abstract fn getLinkedGolden(): node<GoldenAddress>?;
    abstract fn isDeprecated(): bool;
    abstract fn isLinked(): bool;
    abstract fn toAddressRecord(): AddressRecord;
    abstract fn toFullRecord(): any;
    abstract fn promoteToGolden(streetIdx: String): node<GoldenAddress>;
    abstract fn getSource(): node<DataSource>;
    abstract fn getSourceName(): String;
    abstract fn getId(): String;
    abstract fn toSearchItem(): SearchItem;
    abstract fn getStreet(): String?;
    abstract fn getCity(): String?;
    abstract fn getMunicipality(): String?;
    abstract fn getPostcode(): String?;
}

/// What the three external sources share: which golden record this one corroborates, and
/// whether the last load still saw it. Golden records are never loaded, so they implement
/// `AddressRecordProvider` directly instead.
abstract type ExternalAddressRecord extends AddressRecordProvider {
    private goldenRef: node<GoldenAddress>?;

    createdAt: time?;
    lastSeenAt: time?;
    deprecated: bool;

    fn linkToGolden(nGolden: node<GoldenAddress>) {
        this.goldenRef = nGolden;
    }

    fn unlinkGolden() {
        this.goldenRef = null;
    }

    fn getLinkedGolden(): node<GoldenAddress>? {
        return this.goldenRef;
    }

    fn isDeprecated(): bool {
        return this.deprecated;
    }

    fn isLinked(): bool {
        return this.goldenRef != null;
    }

    /// A record the current load still sees: heals one deprecated by a missed run.
    fn markSeen() {
        this.lastSeenAt = time::now();
        this.deprecated = false;
    }
}

@volatile
type StreetRecord {
    street: String?;
    streetAliases: Array<Alias>?;
    postcode: String?;
    city: String?;
    cityAliases: Array<Alias>?;
    sourceName: String?;
}

abstract type StreetRecordProvider {
    abstract fn toRecord(): StreetRecord;
    abstract fn getAddresses(): Array<AddressRecordRef>;
}

@volatile
type SearchRequest {
    items: Array<node<AddressRecordProvider>>;
    params: SearchParameters;
}

@volatile
type SearchItem {
    number: String;
    street: String;
    streetAliases: Array<Alias>?;
    multipleCode: String;
    postcode: String;
    city: String;
    cityAliases: Array<Alias>?;
    coordinates: geo?;
}

@volatile
type ScoringWeights {
    cityWeight: float;
    streetWeight: float;
    postcodeWeight: float;
    numberWeight: float;
    geoWeight: float;

    static fn default(): ScoringWeights {
        return ScoringWeights {
            cityWeight: 4.0,
            streetWeight: 3.0,
            postcodeWeight: 3.0,
            numberWeight: 1.0,
            geoWeight: 3.0,
        };
    }

    fn total(): float {
        return this.cityWeight + this.streetWeight + this.postcodeWeight + this.numberWeight + this.geoWeight;
    }
}

@volatile
type GeoParameters {
    /// Distance in meters below which geo score is 1.0 (perfect match)
    minDistance: int;
    /// Distance in meters above which geo score is 0.0 (no match)
    maxDistance: int;

    static fn default(): GeoParameters {
        return GeoParameters {
            minDistance: 0,
            maxDistance: 1000,
        };
    }
}

@volatile
type SearchParameters {
    citySimilarityThreshold: float;
    streetSimilarityThreshold: float;
    postcodeSimilarityThreshold: float;
    coordinatesSimilarityThreshold: float;
    maxCandidatesPerItem: int;
    postcodeMaxDistance: int;
    weights: ScoringWeights;
    geoParams: GeoParameters;
    /// Falls back to a global POI search when no street-level candidate is found. Heavy.
    deepSearch: bool;

    static fn default(): SearchParameters {
        return SearchParameters {
            citySimilarityThreshold: 0.7,
            streetSimilarityThreshold: 0.7,
            postcodeSimilarityThreshold: 0.4,
            coordinatesSimilarityThreshold: 0.7,
            maxCandidatesPerItem: 10,
            postcodeMaxDistance: 200,
            weights: ScoringWeights::default(),
            geoParams: GeoParameters::default(),
            deepSearch: false,
        };
    }
}

@volatile
type SearchResult {
    sourceRecord: node<AddressRecordProvider>;
    candidates: Array<CandidateMatch<node<AddressRecordProvider>>>;
}

@volatile
type Match<T> {
    score: float;
    elem: T;
}

@volatile
type CandidateMatch<T> {
    cityScore: float;
    streetScore: float;
    numberScore: float;
    postcodeScore: float;
    searchGeoScore: float?;
    realGeoScore: float?;
    searchOverallScore: float;
    realOverallScore: float;
    elem: T;
}

type Alias {
    value: String;
    id: String;
}
