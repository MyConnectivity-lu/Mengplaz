var bda_municipalities_by_name: nodeIndex<String, node<BDAMunicipality>>;
var bda_street_by_cacrid: nodeList<node<BDAStreet>>;
var bda_address_by_geo: nodeGeo<node<BDAddress>>;
var bda_address_by_cacrid: nodeList<node<BDAddress>>;
var bda_address_by_geoportalid: nodeIndex<String, node<BDAddress>>;

type BDAMunicipality {
    name: String;
    cities: nodeIndex<String, node<BDACity>>;
}

type BDACity {
    name: String;
    streets: nodeIndex<String, node<BDAStreet>>;
}

type BDAStreet {
    name: String;
    id_caclr: int;
    addresses: nodeIndex<String, node<BDAddress>>;
}

@volatile
type BDAddressFullRecord {
    id_geoportail: String;
    id_caclr: int;

    number: String;
    postcode: String;
    street: String;
    city: String;
    municipatlity: String;
    primaryLocation: geo?;

    sourceName: String;
    goldenRef: node<GoldenPointOfInterest>?;
}

type BDAddress extends POIRecordProvider {
    private number: String;
    private postcode: String;
    private position: geo;

    private id_caclr: int;
    private id_geoportail: String;

    private municipatlity: node<BDAMunicipality>;
    private city: node<BDACity>;
    private street: node<BDAStreet>;

    private goldenRef: node<GoldenPointOfInterest>?;

    fn linkToGolden(nGolden: node<GoldenPointOfInterest>) {
        this.goldenRef = nGolden;
    }

    fn unlinkGolden() {
        this.goldenRef = null;
    }

    fn getLinkedGolden(): node<GoldenPointOfInterest>? {
        return this.goldenRef;
    }
    fn promoteToGolden(streetIdx: String): node<GoldenPointOfInterest> {
        if (this.goldenRef != null) {
            throw "Record is linked to Golden";
        }
        var nGoldenStreet = golden_streets_by_id.get(streetIdx);
        if (nGoldenStreet == null) {
            throw "Could not find street";
        }
        var newUID: String;
        do {
            newUID = GoldenServices::generateUID();
        } while (golden_pois_by_id.get(newUID) != null);
        //TODO How to handle when we cant parse number
        var alphaNum = extractAlphaCharsFromStreetNumber(this.number);
        var nGoldenPOI = node<GoldenPointOfInterest> {
            GoldenPointOfInterest {
                uid: newUID,
                number: alphaNum.numerical,
                multipleCode: alphaNum.alpha,
                postCode: this.postcode,
                primaryLocation: this.position,
                secondaryLocations: Map<String, geo> {},
                lastUpdate: time::now(),
                linkedRecords: Array<LinkedRecordEntry> {},
                street: nGoldenStreet,
                quality: nodeTime<QualityEvent> {}
            }
        };
        nGoldenStreet->pois_by_id.set(nGoldenPOI->uid, nGoldenPOI);
        golden_pois_by_id.set(nGoldenPOI->uid, nGoldenPOI);
        if (nGoldenPOI->primaryLocation != null) {
            golden_pois_by_geo.set(nGoldenPOI->primaryLocation, nGoldenPOI);
        }
        return nGoldenPOI;
    }

    fn toFullRecord(): BDAddressFullRecord {
        return BDAddressFullRecord {
            id_geoportail: this.id_geoportail,
            id_caclr: this.id_caclr,
            number: this.number,
            postcode: this.postcode,
            primaryLocation: this.position,
            municipatlity: this.municipatlity->name,
            city: this.city->name,
            street: this.street->name,
            sourceName: BDAddressSource::NAME,
            goldenRef: this.goldenRef,
        };
    }

    fn toMengplazRecord(): POIRecord {
        var record = POIRecord {
            uid: "${this.id_caclr}",
            number: "${this.number}",
            street: this.street->name,
            postcode: this.postcode,
            city: this.city->name,
            primaryLocation: this.position,
            sourceName: BDAddressSource::NAME,
            goldenRef: this.goldenRef,
        };
        return record;
    }

    fn getSource(): node<DataSource> {
        return sources_by_name.get(BDAddressSource::NAME)!!;
    }

    fn getId(): String {
        return this.id_geoportail;
    }

    fn getSourceName(): String {
        return BDAddressSource::NAME;
    }

    fn toSearchItem(): SearchItem {
        var number = this.number;
        var multipleCode = "";
        try {
            var parse = extractAlphaCharsFromStreetNumber(this.number);
            number = "${parse.numerical}";
            multipleCode = parse.alpha;
        } catch (_) {}
        return SearchItem {
            number: number,
            multipleCode: multipleCode,
            postcode: this.postcode,
            street: this.street->name.lowercase(),
            city: this.city->name.lowercase(),
            coordinates: this.position
        };
    }

    fn getStreet(): String {
        return this.street->name;
    }

    fn getCity(): String {
        return this.city->name;
    }
}

type BDAddressSource extends DataSource {
    static NAME: String = "BDA";
    static WEIGHT: float = 3.0;

    static fn init() {
        //Declare the source
        var source = sources_by_name.get(BDAddressSource::NAME);
        if (source == null) {
            var source = BDAddressSource {
                reconciliationReport: node<ReconciliationReport> { ReconciliationReport::init() }
            };
            sources_by_name.set(source.name(), node<DataSource> { source });
        }
    }

    fn name(): String {
        return BDAddressSource::NAME;
    }

    fn getWeight(): float {
        return BDAddressSource::WEIGHT;
    }

    fn getReconciliationReport(): ReconciliationReport? {
        return *this.reconciliationReport;
    }

    fn search(req: SearchRequest): mengplaz::SearchResult {}

    fn getIndex(): nodeIndex<String, node<POIRecordProvider>> {
        return bda_address_by_geoportalid;
    }
}
