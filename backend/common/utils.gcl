@volatile
type SplitAlphaNumericalString {
    alpha: String;
    numerical: int;
}

/// Best Effort to transform 7-8, into 7 , -8 , as done by CACLR
fn extractAlphaCharsFromStreetNumber(number: String): SplitAlphaNumericalString {
    var idx = -1;
    for (var i = 0; i < number.size(); i++) {
        var c = number.get(i);
        if (c >= 'A' && c <= 'Z') {
            idx = i;
            break;
        }
    }

    if (idx != -1) {
        var numPart = number.slice(0, idx);
        if (numPart.indexOf('-') == -1) {
            return SplitAlphaNumericalString {
                alpha: number.slice(idx, number.size()),
                numerical: parseNumber(numPart) as int
            };
        }
    }

    var hyphenIdx = number.indexOf('-');
    if (hyphenIdx != -1) {
        return SplitAlphaNumericalString {
            alpha: number.slice(hyphenIdx, number.size()),
            numerical: parseNumber(number.slice(0, hyphenIdx)) as int
        };
    }

    return SplitAlphaNumericalString { alpha: "", numerical: parseNumber(number) as int };
}
