@volatile
type BdaAddressLine {
    /* CSV Headers
    rue;numero;localite;code_postal;id_caclr_rue;id_caclr_bat;lat_wgs84;lon_wgs84;coord_est_luref;coord_nord_luref;id_geoportail;commune;lau2
    */
    rue: String;
    numero: String;
    localite: String;
    code_postal: String;
    id_caclr_rue: int;
    id_caclr_bat: int;
    lat_wgs84: float;
    lon_wgs84: float;
    coord_est_luref: null;
    coord_nord_luref: null;
    id_geoportail: String;
    commune: String;
    lau2: null;
}

abstract type BdaLoader {
    static fn load(): int {
        var total = 0;
        // Records created by this run, handed to the text index in one batch at the end.
        var newAddresses = Array<node<AddressRecordProvider>> {};
        var httpClient = Http<Array<BdaAddressLine>> {};
        var httpRequest = HttpRequest {
            url: "https://data.public.lu/fr/datasets/r/5cadc5b8-6a7d-4283-87bc-f9e58dd771f7",
            method: HttpMethod::GET,
        };

        var response = httpClient.send(httpRequest);
        if (response.status_code == 302 && response.headers.get("location") != null) {
            httpRequest.url = response.headers.get("location")!!;
        }

        var path = "${File::workingDir()}/bd_addresses.csv";
        httpClient.getFile(httpRequest.url, path, null);

        var csvFormat = CsvFormat { header_lines: 1, separator: ';' };
        var reader = CsvReader<BdaAddressLine> { path: path, format: csvFormat };

        while (reader.can_read()) {
            var record = reader.read();

            var munKey = record.commune.lowercase();
            var nMunicipality = bda_municipalities_by_name.get(munKey);
            if (nMunicipality == null) {
                var municipality = BdaMunicipality {
                    name: record.commune,
                    cities_by_name: nodeIndex<String, node<BdaCity>> {},
                };
                nMunicipality = node<BdaMunicipality> { municipality };
                nMunicipality->indexing(nMunicipality);
                info("Created new municipality: ${record.commune}");
            }

            var cityKey = record.localite.lowercase();
            var nCity = nMunicipality->cities_by_name?.get(cityKey);
            if (nCity == null) {
                var city = BdaCity {
                    name: record.localite,
                    municipality: nMunicipality,
                    streets_by_name: nodeIndex<String, node<BdaStreet>> {},
                };
                nCity = node<BdaCity> { city };
                nCity->indexing(nCity);
                info("Created new city: ${record.localite} (${record.commune})");
            }

            var nStreet = bda_streets_by_caclr_id.get(record.id_caclr_rue);
            if (nStreet == null) {
                var street = BdaStreet {
                    name: record.rue,
                    id_caclr: record.id_caclr_rue,
                    city: nCity,
                    addresses_by_id: nodeIndex<String, node<BdaAddress>> {},
                    addresses_by_number: nodeIndex<String, node<BdaAddress>> {},
                };
                nStreet = node<BdaStreet> { street };
                nStreet->indexing(nStreet);
                info("Created new street: ${record.rue} (${record.localite})");
            }

            var nAddress = bda_addresses_by_geoportail_id.get(record.id_geoportail);
            if (nAddress == null) {
                var address = BdaAddress {
                    number: record.numero,
                    postcode: record.code_postal,
                    position: geo { record.lat_wgs84, record.lon_wgs84 },
                    id_caclr: record.id_caclr_bat,
                    id_geoportail: record.id_geoportail,
                    street: nStreet,
                    city: nCity,
                    municipality: nMunicipality,
                    createdAt: time::now(),
                    deprecated: false,
                };
                nAddress = node<BdaAddress> { address };
                nAddress->indexing(nAddress);
                newAddresses.add(nAddress);
                info("Created new address: ${record.numero} ${record.rue}, ${record.code_postal} ${record.localite}");
            }
            nAddress->markSeen();

            total++;
        }
        File::delete(path);

        var nSource = sources_by_name.get(BdaSource::NAME);
        if (nSource != null) {
            SourceTextSearch::appendAll(nSource, newAddresses);
        }

        info("Processed ${total} records.");
        return total;
    }
}
