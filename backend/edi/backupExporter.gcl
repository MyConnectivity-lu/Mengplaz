// Full graph backup: every persisted root dumped to portable text under `files/backup/`.
// NDJSON for anything nested, optional or `geo`; CSV for flat tabular and time-series data.
//
// Relations are exported as business keys, never node references, so the dump stays valid
// across store rebuilds. Name-keyed roots (BDA/OSM cities and streets) accumulate duplicate
// bucket entries across reloads, so those exports deduplicate on node identity.
//
// Deliberately not exported: `caclr_token` (a credential), reconciliation reports and
// `golden_records_geo_recompute` (recomputable), users and groups (they live in the security
// store). For a byte-exact restore use `runtime::Runtime::backup_full` instead.

// Golden DTOs

@volatile
type BkGoldenLinkedRecordDTO {
    sourceName: String;
    id: String;
    score: float;
    detailedScore: ReconciliationCandidateScore?;
}

@volatile
type BkGoldenQualityDTO {
    t: time;
    score: float;
    id: String?;
    sourceName: String?;
    eventType: QualityEventType;
}

@volatile
type BkGoldenConstituencyDTO {
    code: String;
    name: String;
    nameAliases: Array<Alias>;
}

@volatile
type BkGoldenCantonDTO {
    id: String;
    name: String;
    nameAliases: Array<Alias>;
    constituencyId: String;
    lastUpdate: time;
}

@volatile
type BkGoldenMunicipalityDTO {
    id: String;
    name: String;
    nameAliases: Array<Alias>;
    cantonId: String;
    lastUpdate: time;
}

@volatile
type BkGoldenCityDTO {
    id: String;
    name: String;
    nameAliases: Array<Alias>;
    municipalityId: String;
    lastUpdate: time;
}

@volatile
type BkGoldenStreetDTO {
    id: String;
    name: String;
    nameAliases: Array<Alias>;
    cityId: String;
    lastUpdate: time;
}

@volatile
type BkGoldenPoiDTO {
    uid: String;
    number: int;
    multipleCode: String;
    postCode: String;
    primaryLocation: geo?;
    secondaryLocations: Map<String, geo>;
    streetId: String?;
    lastUpdate: time;
    createdAt: time?;

    linkedRecords: Array<BkGoldenLinkedRecordDTO>?;

    quality: Array<BkGoldenQualityDTO>?;
}

@volatile
type BkGoldenQualityHistoryDTO {
    t: time;
    score: float;
}

@volatile
type BkSourceCountHistoryDTO {
    sourceName: String;
    t: time;
    total: int;
    active: int;
    linked: int;
}

