@volatile
type OsmOverpassResponse {
    elements: Array<Map<String, any?>>;
}

abstract type OSMLoader {
    static fn load(): bool {
        var endpoint = "http://overpass-api.de/api/interpreter";
        var request = "[out:\"json\"][timeout:300]; 
                                area[\"ISO3166-1\"=\"LU\"][\"admin_level\"=\"2\"]->.a; 
                                ( 
                                nwr[\"addr:housenumber\"](area.a); 
                                node[\"entrance\"][\"addr:housenumber\"](area.a); 
                                nwr[\"addr:housename\"](area.a); 
                                nwr[\"addr:place\"](area.a); 
                                ) ; 
                                out body center qt;";

        var headers = Map<String, String> {
            "Accept": "*/*",
            "Connection": "keep-alive",
            "Content-Type": "application/text",
            "User-Agent": "MengPlaz/1.0"
        };

        var httpClient = Http<OsmOverpassResponse> {};
        var req = HttpRequest {
            method: HttpMethod::POST,
            url: endpoint,
            headers: headers,
            body: request,
            timeout: 5_min
        };
        var response = httpClient.send(req);
        if (response.status_code == 200 && response.content != null) {
            var elements = response.content.elements;
            info("Collected ${elements.size()} addresses.");

            var issues = Map<String, int> {};
            // Records created by this run, handed to the text index in one batch at the end.
            var newAddresses = Array<node<POIRecordProvider>> {};

            for (_, elem in elements) {
                try {
                    var parsed = OsmAddress::parse(elem);

                    var cityKey = parsed.city.lowercase();
                    var nCity = osm_cities_by_name.get(cityKey);
                    if (nCity == null) {
                        nCity = node<OsmCity> {
                            OsmCity {
                                name: parsed.city,
                                streets_by_name: nodeIndex<String, node<OsmStreet>> {},
                            }
                        };
                        nCity->indexing(nCity);
                        info("Created new city: ${parsed.city}");
                    }

                    var streetKey = parsed.street.lowercase();
                    var nStreet = nCity->streets_by_name.get(streetKey);
                    if (nStreet == null) {
                        nStreet = node<OsmStreet> {
                            OsmStreet {
                                name: parsed.street,
                                city: nCity,
                                addresses_by_id: nodeIndex<String, node<OsmAddress>> {},
                                addresses_by_number: nodeIndex<String, node<OsmAddress>> {},
                            }
                        };
                        nStreet->indexing(nStreet);
                        info("Created new street: ${parsed.street} (${parsed.city})");
                    }
                    var nAddr = osm_by_id.get("${parsed.id}");
                    if (nAddr == null) {
                        nAddr = node<OsmAddress> {
                            OsmAddress {
                                id: parsed.id,
                                position: parsed.position,
                                city: parsed.city,
                                postcode: parsed.postcode,
                                street: parsed.street,
                                number: parsed.number,
                                ref_caclr: parsed.ref_caclr,
                                building: parsed.building,
                                streetRef: nStreet,
                                kind: parsed.kind,
                                createdAt: time::now(),
                            }
                        };
                        nAddr->indexing(nAddr);
                        newAddresses.add(nAddr);
                        info(
                            "Created new address: ${parsed.number} ${parsed.street}, ${parsed.postcode} ${parsed.city}"
                        );
                    }
                    if (nAddr->kind == null && parsed.kind != null) {
                        nAddr->kind = parsed.kind;
                    }
                    nAddr->markSeen();
                } catch (e) {
                    issues.set(e.message!!, (issues.get(e.message) ?? 0) + 1);
                    var addr = OsmPartialAddress::parse(elem);
                    var nAddr = node<OsmPartialAddress> { addr };
                    osm_partial_by_id.set(addr.id, nAddr);
                    if (addr.position != null) {
                        osm_partial_by_geo.set(addr.position, nAddr);
                    }
                    warn("Could not parse: ${elem}\n${e}");
                }
            }
            var nSource = sources_by_name.get(OsmSource::NAME);
            if (nSource != null) {
                SourceTextSearch::appendAll(nSource, newAddresses);
            }

            info("Parsed ${(osm_by_id).size()} addresses.");
            info("Parsed ${(osm_partial_by_id).size()} partial addresses.");
            // info("Issues ${issues}.");
            // Overpass answers 200 with an empty `elements` array when it is overloaded. Read
            // that as a failed load: a caller that took it for a good one would deprecate the
            // whole index and write a false cliff into the append-only growth series.
            if (elements.size() == 0) {
                warn("Overpass returned 200 with no elements, treating as a failed load");
                return false;
            }
            return true;
        } else {
            error(response);
            return false;
        }
    }
}
