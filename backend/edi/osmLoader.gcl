

@volatile
type OsmOverpassResponse {
    elements: Array<Map<String, any?>>;
}

abstract type OSMLoader {
    static fn load() {
        var endpoint = "http://overpass-api.de/api/interpreter";
        var request = "[out:json];area[\"ISO3166-1\"=\"LU\"][admin_level=2];(node[\"addr:housenumber\"](area);way[\"addr:housenumber\"](area);relation[\"addr:housenumber\"](area););out body;>;out skel qt;";
        
        var headers = Map<String, String>{
        "Accept": "*/*",
        "Connection": "keep-alive",
        "Content-Type": "application/text",
        };

        var httpClient = Http<OsmOverpassResponse> {};
        var req = HttpRequest {
            method: HttpMethod::POST,
            url: endpoint,
            headers: headers,
            body: request,
        };
        var response = httpClient.send(req);
        if(response.status_code == 200 && response.content != null) {
            var elements = response.content.elements;
            info("Collected ${elements.size()} addresses.");

            var issues = Map<String, int>{};
            
            for(_, elem in elements) {
                try {

                    var addr = OsmAddress::parse(elem);
                    var nAddr = node<OsmAddress>{addr};
                    osm_by_id.set(addr.id, nAddr);
                    osm_by_geo.set(addr.position, nAddr);

                } catch(e) {
                    issues.set(e.message!!, (issues.get(e.message)??0)+1);
                    var addr = OsmPartialAddress::parse(elem);
                    var nAddr = node<OsmPartialAddress>{addr};
                    osm_partial_by_id.set(addr.id, nAddr);
                    if(addr.position != null) {
                        osm_partial_by_geo.set(addr.position, nAddr);
                    }
                    //warn("Could not parse: ${elem}\n${e}");
                }
            }
            info("Parsed ${(osm_by_id).size()} addresses.");
            info("Parsed ${(osm_partial_by_id).size()} partial addresses.");
            info("Issues ${issues}.");
        } else {
            error(response);
        }        
    }
}
