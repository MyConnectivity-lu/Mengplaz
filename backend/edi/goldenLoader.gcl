type GoldenLoader {
    static fn loadAll() {
        //GoldenSource::init();
        info("Loading All Golden Records from dump");
        GoldenLoader::loadGoldenConstituency();
        GoldenLoader::loadGoldenCantons();
        GoldenLoader::loadGoldenMunicipalities();
        GoldenLoader::loadGoldenCities();
        GoldenLoader::loadGoldenStreets();
        GoldenLoader::loadGoldenPOIs();
        try {
            GoldenLoader::loadGoldenQualityHistory();
        } catch (err) {}
        info("Loading finished");
    }

    static fn loadGoldenConstituency() {
        var fr = JsonReader<GoldenConstituencyDTO> { path: GoldenExporter::constituencyPath };
        while (fr.can_read()) {
            var l = fr.read();
            if (golden_constituency_by_code.get(l.code) == null) {
                var nGoldenConstituency = node<GoldenConstituency> {
                    GoldenConstituency {
                        code: l.code,
                        name: l.name,
                        nameAliases: l.nameAliases,
                        cantons_by_id: nodeIndex<String, node<GoldenCanton>> {},
                    }
                };
                golden_constituency_by_code.set(nGoldenConstituency->code, nGoldenConstituency);
            }
        }
    }

    static fn loadGoldenCantons() {
        var fr = JsonReader<GoldenCantonDTO> { path: GoldenExporter::cantonsPath };
        while (fr.can_read()) {
            var l = fr.read();
            if (golden_cantons_by_id.get(l.id) == null) {
                var nGoldenConstituency = golden_constituency_by_code.get(l.constituencyId)!!;
                var nGoldenCanton = node<GoldenCanton> {
                    GoldenCanton {
                        id: l.id,
                        name: l.name,
                        nameAliases: l.nameAliases,
                        lastUpdate: l.lastUpdate,
                        constituency: nGoldenConstituency,
                        municipalities_by_id: nodeIndex<String, node<GoldenMunicipality>> {},
                    }
                };
                nGoldenConstituency->cantons_by_id.set(nGoldenCanton->id, nGoldenCanton);
                golden_cantons_by_id.set(nGoldenCanton->id, nGoldenCanton);
            }
        }
    }

    static fn loadGoldenMunicipalities() {
        var fr = JsonReader<GoldenMunicipalityDTO> { path: GoldenExporter::municipalityPath };
        while (fr.can_read()) {
            var l = fr.read();
            if (golden_municipalities_by_id.get(l.id) == null) {
                var nGoldenCanton = golden_cantons_by_id.get(l.cantonId)!!;
                var nGoldenMunicipality = node<GoldenMunicipality> {
                    GoldenMunicipality {
                        id: l.id,
                        name: l.name,
                        nameAliases: l.nameAliases,
                        lastUpdate: l.lastUpdate,
                        canton: nGoldenCanton,
                        cities_by_id: nodeIndex<String, node<GoldenCity>> {},
                    }
                };
                nGoldenCanton->municipalities_by_id.set(nGoldenMunicipality->id, nGoldenMunicipality);
                golden_municipalities_by_id.set(nGoldenMunicipality->id, nGoldenMunicipality);
            }
        }
    }

    static fn loadGoldenCities() {
        var fr = JsonReader<GoldenCityDTO> { path: GoldenExporter::cityPath };
        while (fr.can_read()) {
            var l = fr.read();
            if (golden_cities_by_id.get(l.id) == null) {
                var nGoldenMunicipality = golden_municipalities_by_id.get(l.municipalityId)!!;
                var nGoldenCity = node<GoldenCity> {
                    GoldenCity {
                        id: l.id,
                        name: l.name,
                        nameAliases: l.nameAliases,
                        lastUpdate: l.lastUpdate,
                        municipality: nGoldenMunicipality,
                        streets_by_id: nodeIndex<String, node<GoldenStreet>> {},
                    }
                };
                nGoldenMunicipality->cities_by_id.set(nGoldenCity->id, nGoldenCity);
                golden_cities_by_id.set(nGoldenCity->id, nGoldenCity);
            }
        }
    }

    static fn loadGoldenStreets() {
        var fr = JsonReader<GoldenStreetDTO> { path: GoldenExporter::streetPath };
        while (fr.can_read()) {
            var l = fr.read();
            if (golden_streets_by_id.get(l.id) == null) {
                var nGoldenCity = golden_cities_by_id.get(l.cityId)!!;
                var nGoldenStreet = node<GoldenStreet> {
                    GoldenStreet {
                        id: l.id,
                        name: l.name,
                        nameAliases: l.nameAliases,
                        lastUpdate: l.lastUpdate,
                        city: nGoldenCity,
                        pois_by_id: nodeIndex<String, node<GoldenPointOfInterest>> {},
                    }
                };
                nGoldenCity->streets_by_id.set(nGoldenStreet->id, nGoldenStreet);
                golden_streets_by_id.set(nGoldenStreet->id, nGoldenStreet);
            }
        }
    }

    static fn loadGoldenPOIs() {
        var fr = JsonReader<GoldenPOIDTO> { path: GoldenExporter::poiPath };
        while (fr.can_read()) {
            var l = fr.read();
            if (golden_pois_by_id.get(l.uid) != null) {
                continue;
            }
            var nGoldenStreet: node<GoldenStreet>?;
            if (l.streetId != null) {
                nGoldenStreet = golden_streets_by_id.get(l.streetId);
            }
            var nGoldenPOI = node<GoldenPointOfInterest> {
                GoldenPointOfInterest {
                    uid: l.uid,
                    number: l.number,
                    multipleCode: l.multipleCode,
                    postCode: l.postCode,
                    lastUpdate: l.lastUpdate,
                    street: nGoldenStreet,
                    linkedRecords: Array<LinkedRecordEntry> {},
                    primaryLocation: l.primaryLocation,
                    secondaryLocations: l.secondaryLocations,
                    quality: nodeTime<QualityEvent> {}
                }
            };

            for (_, linkedRecord in l.linkedRecords?) {
                var ref: node<POIRecordProvider>?;
                if (linkedRecord.sourceName == OsmSource::NAME) {
                    ref = osm_by_id.get(linkedRecord.id);
                } else if (linkedRecord.sourceName == CaclrSource::NAME) {
                    ref = caclr_buildings_by_id.get(linkedRecord.id);
                } else if (linkedRecord.sourceName == BDAddressSource::NAME) {
                    ref = bda_address_by_geoportalid.get(linkedRecord.id);
                }
                if (ref != null) {
                    ref->linkToGolden(nGoldenPOI);
                    nGoldenPOI->linkedRecords.add(LinkedRecordEntry {
                            record: ref,
                            score: linkedRecord.score
                        });
                }
            }

            for (_, value in l.quality?) {
                var ref: node<POIRecordProvider>?;
                if (value.sourceName == OsmSource::NAME) {
                    ref = osm_by_id.get(value.id);
                } else if (value.sourceName == CaclrSource::NAME) {
                    ref = caclr_buildings_by_id.get(value.id);
                } else if (value.sourceName == BDAddressSource::NAME) {
                    ref = bda_address_by_geoportalid.get(value.id);
                }
                if (ref != null) {
                    nGoldenPOI->quality.setAt(value.t, QualityEvent {
                            eventType: value.eventType,
                            score: value.score,
                            sourceRecord: ref
                        });
                }
            }

            nGoldenStreet?->pois_by_id.set(nGoldenPOI->uid, nGoldenPOI);
            golden_pois_by_id.set(nGoldenPOI->uid, nGoldenPOI);

            if (nGoldenPOI->primaryLocation != null) {
                golden_pois_by_geo.set(nGoldenPOI->primaryLocation, nGoldenPOI);
            }
        }
    }

    static fn loadGoldenQualityHistory() {
        var fr = CsvReader<GoldenQualityHistoryDTO> { path: GoldenExporter::qualityHistory };
        var goldenSource = sources_by_name.get(GoldenSource::NAME);
        if (goldenSource is node<GoldenSource>) {
            while (fr.can_read()) {
                var l = fr.read();
                goldenSource->qualityHistory.setAt(l.t, l.score);
            }
        }
    }
}
