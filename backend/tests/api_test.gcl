/// The public read endpoints in `backend/api/api.gcl`, plus `getSources`.
///
/// The contract the frontend and the OpenAPI consumers are written against, so what is
/// asserted is shape and filtering rather than scoring. Two behaviours that read as
/// surprises from the outside are pinned deliberately: the `"UNKNOWN"` sentinel filtered out
/// of every index listing, and `getGoldenLocalities` taking a commune *name*.
fn here(): geo {
    return geo { 49.6116, 6.1319 };
}

/// Two localities in one commune, one street each, and two POIs on the first street.
fn seedWorld(): node<GoldenStreet> {
    fixtures_test::reset();
    fixtures_test::seedSources();
    var nCity = fixtures_test::goldenCity("Luxembourg", "Gasperich");
    var nStreet = fixtures_test::goldenStreet(nCity, "Rue de la Gare");
    fixtures_test::goldenPoi(nStreet, 12, "", "1234", here());
    fixtures_test::goldenPoi(nStreet, 14, "", "1234", geo { 49.6117, 6.1319 });
    return nStreet;
}

// ----------------------------------------------------------- street lookup

@test
fn poisInStreetReturnsEveryRecordOnTheStreet() {
    var nStreet = seedWorld();
    var pois = api::getPoisInStreet(nStreet);

    Assert::equals(pois.size(), 2);
    Assert::equals(pois[0].record.street, "Rue de la Gare");
    Assert::equals(pois[0].record.locality, "Gasperich");
    Assert::equals(pois[0].record.commune, "Luxembourg");
}

@test
fn streetSearchReturnsRankedStreetRecords() {
    seedWorld();
    buildGoldenStreetIndex();
    var results = api::searchStreet("rue de la gare");

    Assert::equals(results.size(), 1);
    Assert::equals(results[0].record.street, "Rue de la Gare");
    Assert::equals(results[0].record.city, "Gasperich");
    // BM25 relevance, not a [0, 1] similarity: unbounded and only comparable within one
    // result set, so a hit can only be asserted to have scored at all.
    Assert::isTrue(results[0].score > 0.0);
}

@test
fn streetSearchIsCaseAndWhitespaceInsensitive() {
    seedWorld();
    buildGoldenStreetIndex();
    Assert::equals(api::searchStreet("  RUE de La Gare ").size(), 1);
    Assert::equals(api::searchStreet("").size(), 0);
    Assert::equals(api::searchStreet("   ").size(), 0);
}

@test
fn streetSearchAnswersBeforeTheIndexIsBuilt() {
    // Between a fresh restore and the first build there is no index: the endpoint degrades to
    // an empty list rather than throwing at an anonymous visitor.
    seedWorld();
    Assert::isNull(GoldenStreetSearch::ready());
    Assert::equals(api::searchStreet("rue de la gare").size(), 0);
}

@test
fn streetSearchReturnsEveryLocalityCarryingTheName() {
    // A name-only query answers with every locality, not one of them.
    fixtures_test::reset();
    fixtures_test::seedSources();
    fixtures_test::goldenStreet(fixtures_test::goldenCity("Luxembourg", "Gasperich"), "Rue de la Gare");
    fixtures_test::goldenStreet(fixtures_test::goldenCity("Wiltz", "Wiltz"), "Rue de la Gare");
    buildGoldenStreetIndex();

    Assert::equals(api::searchStreet("rue de la gare").size(), 2);
}

@test
fn streetSearchNarrowsToOneLocalityWhenTheQueryNamesIt() {
    // The city is in the document, so naming it ranks that locality first. A signal, not a
    // filter - both streets still come back.
    fixtures_test::reset();
    fixtures_test::seedSources();
    fixtures_test::goldenStreet(fixtures_test::goldenCity("Luxembourg", "Gasperich"), "Rue de la Gare");
    fixtures_test::goldenStreet(fixtures_test::goldenCity("Wiltz", "Wiltz"), "Rue de la Gare");
    buildGoldenStreetIndex();

    var results = api::searchStreet("rue de la gare wiltz");
    Assert::isTrue(results.size() > 0);
    Assert::equals(results[0].record.city, "Wiltz");
}

@test
fn streetSearchToleratesATypoInTheDistinctiveTerm() {
    // The query shares NO correctly-spelt term with its target, so only typo tolerance can
    // find it. "rue de la gar" would prove nothing - the intact "rue" alone would match.
    fixtures_test::reset();
    fixtures_test::seedSources();
    var nCity = fixtures_test::goldenCity("Luxembourg", "Gasperich");
    fixtures_test::goldenStreet(nCity, "Rue de la Gare");
    fixtures_test::goldenStreet(nCity, "Avenue Monterey");
    buildGoldenStreetIndex();

    var results = api::searchStreet("monterrey");
    Assert::isTrue(results.size() > 0);
    Assert::equals(results[0].record.street, "Avenue Monterey");
}

@test
fn streetSearchRanksByRelevanceBestFirst() {
    fixtures_test::reset();
    fixtures_test::seedSources();
    var nCity = fixtures_test::goldenCity("Luxembourg", "Gasperich");
    fixtures_test::goldenStreet(nCity, "Rue de la Gare");
    fixtures_test::goldenStreet(nCity, "Rue de la Gare Haute");
    fixtures_test::goldenStreet(nCity, "Avenue Monterey");
    buildGoldenStreetIndex();

    var results = api::searchStreet("rue de la gare");
    Assert::isTrue(results.size() > 1);
    // Length normalization puts the name that IS the query above the one containing it.
    Assert::equals(results[0].record.street, "Rue de la Gare");
    for (var i = 1; i < results.size(); i++) {
        Assert::isTrue(results[i].score <= results[i - 1].score);
    }
}

@test
fn streetSearchIsCappedAtThirty() {
    // Sixty streets under one name, bounded by the `maxResults` the endpoint asks for.
    fixtures_test::reset();
    fixtures_test::seedSources();
    var nCity = fixtures_test::goldenCity("Luxembourg", "Gasperich");
    for (var i = 0; i < 60; i++) {
        fixtures_test::goldenStreet(nCity, "Rue de la Gare");
    }
    buildGoldenStreetIndex();

    Assert::equals(api::searchStreet("rue de la gare").size(), 30);
}

@test
fn streetSearchKeepsTheBestNamesWhenTheRankingOverflows() {
    // Sixty-one names all match to some degree: what comes back is the top slice, best first,
    // with the exact name at the head.
    fixtures_test::reset();
    fixtures_test::seedSources();
    var nCity = fixtures_test::goldenCity("Luxembourg", "Gasperich");
    fixtures_test::goldenStreet(nCity, "Rue de la Gare");
    for (var i = 0; i < 60; i++) {
        fixtures_test::goldenStreet(nCity, "Rue de la Gare ${i}");
    }
    buildGoldenStreetIndex();

    var results = api::searchStreet("rue de la gare");
    Assert::equals(results.size(), 30);
    Assert::equals(results[0].record.street, "Rue de la Gare");
    for (var i = 1; i < results.size(); i++) {
        Assert::isTrue(results[i].score <= results[i - 1].score);
    }
}

@test
fn streetSearchReturnsNothingForAnUnknownName() {
    seedWorld();
    buildGoldenStreetIndex();
    Assert::equals(api::searchStreet("zzzzzzzzzzzz").size(), 0);
}

// -------------------------------------------------------------- geo lookup

@test
fn poisListsEveryGeolocatedRecord() {
    var nStreet = seedWorld();
    // A POI without coordinates is absent from the geo index and therefore from this listing.
    fixtures_test::goldenPoi(nStreet, 16, "", "1234", null);

    var feats = api::getPois();
    Assert::equals(feats.size(), 2);
}

@test
fn poiByGeoResolvesAnExactCoordinate() {
    seedWorld();
    var found = api::getPoisByGeo(here());

    Assert::isNotNull(found);
    Assert::equals(found!!.record.number, "12 ");
    Assert::isNull(api::getPoisByGeo(geo { 49.9, 6.9 }));
}

@test
fn geoJsonCarriesTheSourceIdsOfEveryLinkedRecord() {
    // The GeoJSON export is how downstream GIS consumers join back to the source registries,
    // so the per-source external id map is the part that matters.
    var nStreet = seedWorld();
    var nGolden = nStreet->pois_by_number?.get("12")!!;
    var nOsm = fixtures_test::osmAddress(1, "12", "Rue de la Gare", "Gasperich", "1234", here());
    privateApi::linkRecords(nOsm, nGolden, null);

    var geojson = api::getGoldenRecordsGeoJson();
    Assert::equals(geojson.type, "FeatureCollection");
    Assert::equals(geojson.features.size(), 2);

    var withLink = 0;
    for (_, feature in geojson.features) {
        Assert::equals(feature.type, "Feature");
        Assert::equals(feature.geometry.type, "Point");
        Assert::equals(feature.geometry.coordinates.size(), 2);
        var externalIds = feature.properties.get("externalIds") as Map<String, any>;
        if (externalIds.size() > 0) {
            withLink++;
            Assert::equals(externalIds.get(OsmSource::NAME), "1");
            Assert::equals(feature.properties.get("goldenRecordId"), nGolden->uid);
        }
    }
    Assert::equals(withLink, 1);
}

// ---------------------------------------------------------- record lookup

@test
fn recordDetailsCarryTheGoldenRowAndEveryLinkedSourceRow() {
    var nStreet = seedWorld();
    var nGolden = nStreet->pois_by_number?.get("12")!!;
    var nOsm = fixtures_test::osmAddress(1, "12", "Rue de la Gare", "Gasperich", "1234", here());
    privateApi::linkRecords(nOsm, nGolden, null);

    var details = api::getGoldenRecordDetails(nGolden->uid);
    Assert::equals(details.golden.ref, nGolden as node<POIRecordProvider>);
    Assert::equals(details.associated.size(), 1);
    Assert::equals(details.associated[0].id, "1");
    Assert::equals(details.associated[0].ref, nOsm as node<POIRecordProvider>);
    Assert::equals(details.associated[0].matchScore, 1.0);
}

@test
fn recordDetailsRefuseAnUnknownUid() {
    seedWorld();
    var threw = false;
    try {
        api::getGoldenRecordDetails("no-such-uid");
    } catch (_) {
        threw = true;
    }
    Assert::isTrue(threw);
}

@test
fn recordRefByUidReturnsNullRatherThanThrowing() {
    // Unlike `getGoldenRecordDetails`, the OpenAPI-tagged lookup answers with null for an
    // unknown uid — consumers treat it as "not found", not as an error.
    var nStreet = seedWorld();
    var nGolden = nStreet->pois_by_number?.get("12")!!;

    Assert::equals(api::getGoldenRecordRefByUid(nGolden->uid)!!.ref, nGolden as node<POIRecordProvider>);
    Assert::isNull(api::getGoldenRecordRefByUid("no-such-uid"));
}

@test
fn lookupByGeoportailIdFollowsTheLinkToGolden() {
    // The BDA cross-reference endpoint: given a geoportail id, hand back the golden record it
    // corroborates — and nothing at all while it is still unlinked.
    var nStreet = seedWorld();
    var nGolden = nStreet->pois_by_number?.get("12")!!;
    var nBda = fixtures_test::bdaAddress(
        "GP-1",
        900,
        "12",
        "Rue de la Gare",
        "Gasperich",
        "Luxembourg",
        "1234",
        here()
    );

    Assert::isNull(api::getRecordByGeoportailID("GP-1"));
    Assert::isNull(api::getRecordByGeoportailID("no-such-id"));

    privateApi::linkRecords(nBda, nGolden, null);
    Assert::equals(api::getRecordByGeoportailID("GP-1")!!.ref, nGolden as node<POIRecordProvider>);
}

@test
fn goldenRecordsListsEveryPoiIncludingTheGeolessOnes() {
    var nStreet = seedWorld();
    fixtures_test::goldenPoi(nStreet, 16, "", "1234", null);

    // Unlike `getPois`, this walks the uid index, so a POI without coordinates is included.
    Assert::equals(api::getGoldenRecords().size(), 3);
}

// --------------------------------------------------------- index listings

@test
fn localitiesAreListedAlphabeticallyAndSkipTheUnknownSentinel() {
    // Loaders park records they cannot place under the id "UNKNOWN"; that bucket is an
    // internal holding pen and must never surface in a public listing.
    fixtures_test::reset();
    fixtures_test::seedSources();
    fixtures_test::goldenCity("Luxembourg", "Weimerskirch");
    fixtures_test::goldenCity("Luxembourg", "Bonnevoie");
    var nUnknown = fixtures_test::goldenCity("Luxembourg", "Placeholder");
    golden_cities_by_id.set("UNKNOWN", nUnknown);

    var localities = api::getGoldenLocalities(null);
    Assert::equals(localities.size(), 3);
    Assert::equals(localities[0].name, "Bonnevoie");
    Assert::equals(localities[1].name, "Placeholder");
    Assert::equals(localities[2].name, "Weimerskirch");
}

@test
fn localitiesCanBeFilteredButByCommuneNameNotCommuneId() {
    // Pinned inconsistency: `getGoldenCommunes` hands out `{id, name}` pairs, and the natural
    // reading of `getGoldenLocalities(communeId)` is that it takes the id — it compares
    // against the commune's *name*. Passing the id returns nothing.
    fixtures_test::reset();
    fixtures_test::seedSources();
    fixtures_test::goldenCity("Luxembourg", "Gasperich");
    fixtures_test::goldenCity("Wiltz", "Wiltz");

    var communes = api::getGoldenCommunes();
    Assert::equals(communes.size(), 2);
    Assert::equals(communes[0].name, "Luxembourg");

    Assert::equals(api::getGoldenLocalities("Luxembourg").size(), 1);
    Assert::equals(api::getGoldenLocalities("Luxembourg")[0].name, "Gasperich");
    Assert::equals(api::getGoldenLocalities(communes[0].id).size(), 0);
}

@test
fn communesSkipTheUnknownSentinelToo() {
    fixtures_test::reset();
    fixtures_test::seedSources();
    var nCity = fixtures_test::goldenCity("Luxembourg", "Gasperich");
    golden_municipalities_by_id.set("UNKNOWN", nCity->municipality);

    Assert::equals(api::getGoldenCommunes().size(), 1);
}

@test
fn streetsAreListedPerLocalityAlphabetically() {
    fixtures_test::reset();
    fixtures_test::seedSources();
    var nCity = fixtures_test::goldenCity("Luxembourg", "Gasperich");
    fixtures_test::goldenStreet(nCity, "Rue de la Gare");
    fixtures_test::goldenStreet(nCity, "Avenue Monterey");

    var streets = api::getGoldenStreetsByLocalityId(nCity->id);
    Assert::equals(streets.size(), 2);
    Assert::equals(streets[0].name, "Avenue Monterey");
    Assert::equals(streets[1].name, "Rue de la Gare");
}

@test
fn streetListingRefusesAnUnknownLocality() {
    seedWorld();
    var threw = false;
    try {
        api::getGoldenStreetsByLocalityId("no-such-city");
    } catch (_) {
        threw = true;
    }
    Assert::isTrue(threw);
}

@test
fn numbersAreListedPerStreet() {
    var nStreet = seedWorld();
    var numbers = api::getGoldenNumbersByStreetId(nStreet->id);

    Assert::equals(numbers.size(), 2);
    Assert::equals(numbers[0].name, "12 ");
    Assert::equals(numbers[1].name, "14 ");
