// -------------------------------------------------------- quality history

@test
fn qualityHistoryReportsTheSeriesAsPercentagesAndEveryRecordsScore() {
    var nStreet = seedWorld();
    var nGolden = nStreet->pois_by_number?.get("12")!!;
    var nOsm = fixtures_test::osmAddress(1, "12", "Rue de la Gare", "Gasperich", "1234", here());
    privateApi::linkRecords(nOsm, nGolden, null);
    privateApi::computeGlobalQuality();

    var history = api::getGlobalQualityHistory(null, null);

    // One POI at 0.2 and one at 0.0 over two POIs; the series is scaled to a percentage while
    // `current` stays on the 0-1 scale.
    Assert::equals(history.history.size(), 1);
    Assert::equalsd(history.history[0].averageQuality, 10.0, 0.01);
    Assert::equalsd(history.current, 0.1, 0.01);
}

// --------------------------------------------------- golden record scores

/// `seedWorld`'s two POIs plus a third, with 1, 0 and 2 source records linked to them
/// respectively. Scores rise with the number of linked records, so #16 ranks first on
/// either sortable column and #14 last. Returns the street.
fn seedScoredWorld(): node<GoldenStreet> {
    var nStreet = seedWorld();
    var nPoi12 = nStreet->pois_by_number?.get("12")!!;
    var nPoi16 = fixtures_test::goldenPoi(nStreet, 16, "", "1234", here());

    privateApi::linkRecords(
        fixtures_test::osmAddress(1, "12", "Rue de la Gare", "Gasperich", "1234", here()),
        nPoi12,
        null
    );
    privateApi::linkRecords(
        fixtures_test::osmAddress(2, "16", "Rue de la Gare", "Gasperich", "1234", here()),
        nPoi16,
        null
    );
    privateApi::linkRecords(
        fixtures_test::bdaAddress("GP-16", 316, "16", "Rue de la Gare", "Gasperich", "Luxembourg", "1234", here()),
        nPoi16,
        null
    );
    return nStreet;
}

@test
fn goldenRecordScoresReportEveryRecordsAddressAndScore() {
    var nStreet = seedWorld();
    var nGolden = nStreet->pois_by_number?.get("12")!!;
    var nOsm = fixtures_test::osmAddress(1, "12", "Rue de la Gare", "Gasperich", "1234", here());
    privateApi::linkRecords(nOsm, nGolden, null);

    var page = api::getGoldenRecordScores(0, 100, null, null);

    Assert::equals(page.total, 2);
    Assert::equals(page.offset, 0);
    Assert::equals(page.rows.size(), 2);
    for (_, record in page.rows) {
        if (record.uid == nGolden->uid) {
            Assert::equals(record.linkedCount, 1);
            Assert::equalsd(record.quality, 0.2, 0.01);
            Assert::equals(record.street, "Rue de la Gare");
            Assert::equals(record.city, "Gasperich");
        } else {
            Assert::equals(record.linkedCount, 0);
            Assert::equals(record.quality, 0.0);
        }
    }
}

@test
fn goldenRecordScoresPageThroughTheIndexWithoutRepeatingARecord() {
    seedScoredWorld();

    var first = api::getGoldenRecordScores(0, 2, null, null);
    var second = api::getGoldenRecordScores(2, 2, null, null);

    Assert::equals(first.total, 3);
    Assert::equals(first.rows.size(), 2);
    Assert::equals(second.offset, 2);
    Assert::equals(second.rows.size(), 1);

    var seen = Map<String, bool> {};
    for (_, record in first.rows) {
        seen.set(record.uid, true);
    }
    for (_, record in second.rows) {
        seen.set(record.uid, true);
    }
    Assert::equals(seen.size(), 3);
}

@test
fn goldenRecordScoresAnswerAnOffsetPastTheEndWithAnEmptyPage() {
    seedScoredWorld();

    var page = api::getGoldenRecordScores(50, 1000, null, null);

    Assert::equals(page.total, 3);
    Assert::equals(page.rows.size(), 0);
}

@test
fn goldenRecordScoresRankByQualityInBothDirections() {
    var nStreet = seedScoredWorld();
    var best = nStreet->pois_by_number?.get("16")!!->uid;
    var worst = nStreet->pois_by_number?.get("14")!!->uid;

    var desc = api::getGoldenRecordScores(0, 100, "quality", "desc");
    var asc = api::getGoldenRecordScores(0, 100, "quality", "asc");

    Assert::equals(desc.rows[0].uid, best);
    Assert::equals(desc.rows[2].uid, worst);
    Assert::equals(asc.rows[0].uid, worst);
    Assert::equals(asc.rows[2].uid, best);
}

@test
fn goldenRecordScoresRankByLinkedCountAcrossPages() {
    var nStreet = seedScoredWorld();
    var best = nStreet->pois_by_number?.get("16")!!->uid;
    var worst = nStreet->pois_by_number?.get("14")!!->uid;

    // The ranking is over the whole index, so the second page continues the first one's
    // order rather than sorting a page in isolation.
    var first = api::getGoldenRecordScores(0, 1, "linkedCount", "desc");
    var last = api::getGoldenRecordScores(2, 1, "linkedCount", "desc");

    Assert::equals(first.rows.size(), 1);
    Assert::equals(first.rows[0].uid, best);
    Assert::equals(first.rows[0].linkedCount, 2);
    Assert::equals(last.rows[0].uid, worst);
    Assert::equals(last.rows[0].linkedCount, 0);
}

@test
fn goldenRecordScoresRefuseAnUnknownSortKey() {
    seedScoredWorld();

    var threw = false;
    try {
        api::getGoldenRecordScores(0, 100, "postcode", null);
    } catch (_) {
        threw = true;
    }
    Assert::isTrue(threw);
}

@test
fn goldenRecordScoresCapThePageSizeAndClampANegativeOffset() {
    seedScoredWorld();

    // A caller asking for more than the cap gets the cap, not the whole index, and a
    // negative offset reads as the start rather than throwing.
    var page = api::getGoldenRecordScores(-5, 100000, null, null);

    Assert::equals(page.offset, 0);
    Assert::equals(page.rows.size(), 3);
    Assert::equals(page.limit, GoldenRecordPage::MAX_PAGE);
}

@test
fn qualityHistoryRefusesToAnswerWithoutTheGoldenSource() {
    fixtures_test::reset();
    OsmSource::init();

    var threw = false;
    try {
        api::getGlobalQualityHistory(null, null);
    } catch (_) {
        threw = true;
    }
    Assert::isTrue(threw);
}

// -------------------------------------------------------------- meta

@test
fn attributionNamesOpenStreetMapAndItsLicence() {
    // The ODbL requires this notice to be conveyed with the data; it is served verbatim by the
    // API and by the map UI, so its content is part of the contract, not decoration.
    var attribution = api::attribution();

    Assert::isTrue(attribution.notice.contains("OpenStreetMap"));
    Assert::isTrue(attribution.notice.contains("ODbL"));
    Assert::equals(attribution.sources.size(), 2);
    Assert::isTrue(attribution.sources[0].contains("OpenStreetMap"));
    Assert::isTrue(attribution.sources[1].contains("CACLR"));
}

@test
fn sourcesListsEverySourceAndItsLockState() {
    fixtures_test::reset();
    fixtures_test::seedSources();

    var sources = privateApi::getSources();
    Assert::equals(sources.size(), 4);
    for (_, source in sources) {
        // Never reconciled, so the flag has not been created yet.
        Assert::isNull(source.locked);
    }

    privateApi::lockDatasource(OsmSource::NAME);
    for (_, source in privateApi::getSources()) {
        if (source.name == OsmSource::NAME) {
            Assert::equals(source.locked, true);
        }
    }
}

// ------------------------------------------------------ traffic accounting

@test
fn everyEndpointCallIsRecordedAgainstItsOwnTrafficSeries() {
    // `Traffic_Service` wraps every endpoint and is what the usage dashboard reads; an
    // endpoint that forgets to close its span records nothing at all.
    seedWorld();
    Assert::equals(endpoints_by_name.size(), 0);

    api::getGoldenRecords();
    api::getGoldenRecords();
    api::getGoldenCommunes();

    // The key is the module-qualified function reference stringified, not the bare name.
    var nRecords = endpoints_by_name.get("api::getGoldenRecords");
    Assert::isNotNull(nRecords);
    Assert::equals(nRecords!!->traffic.size(), 2);
    Assert::isNotNull(endpoints_by_name.get("api::getGoldenCommunes"));
    Assert::isNotNull(nRecords->traffic.last()!!.executionTime);
}
