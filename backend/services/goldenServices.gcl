type GoldenServices {
    static UID_CHARS: String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRDTUVWXYZ";
    static fn generateUID(): String {
        var res = "";
        var rand = Random {};
        for (var i = 0; i < 6; i++) {
            res = "${res}${GoldenServices::UID_CHARS.get(rand.uniform(0, 62))}";
        }
        return res;
    }

    static fn computeGeoScore(sourceGeo: geo?, candidateGeo: geo?, geoParams: GeoParameters): float? {
        if (sourceGeo == null || candidateGeo == null) {
            return null;
        }
        var geoDistance = sourceGeo.distance(candidateGeo);
        if (geoDistance > geoParams.maxDistance) {
            return 0_f;
        }
        if (geoDistance <= geoParams.minDistance) {
            return 1_f;
        }
        // Decay from 1.0 to 0.0 between minDistance and maxDistance
        var effectiveDistance = geoDistance - geoParams.minDistance;
        var effectiveRange = geoParams.maxDistance - geoParams.minDistance;
        return pow(1 - (effectiveDistance / effectiveRange), 2.0);
    }

    static fn computeCityScore(sourceCityName: String, nCandidateCity: node<GoldenCity>): float {
        var d = sourceCityName.jarowinkler(nCandidateCity->name.lowercase());
        if (d == 1) {
            return d;
        }
        for (_, alias in nCandidateCity->nameAliases) {
            var d2 = sourceCityName.jarowinkler(alias.value.lowercase());
            if (d2 > d) {
                d = d2;
            }
        }
        return d;
    }

    static fn computeOverallScore(cityScore: float, streetScore: float, numberScore: float, postcodeScore: float, geoScore: float?, weights: ScoringWeights): float {
        var total = weights.total();
        return (cityScore * weights.cityWeight
            + streetScore * weights.streetWeight
            + postcodeScore * weights.postcodeWeight
            + numberScore * weights.numberWeight
            + (geoScore ?? 1.0) * weights.geoWeight) / total;
    }

    static fn computeNumberScore(sourceNumber: String, sourceMultipleCode: String, candidateNumber: int, candidateMultipleCode: String): float {
        if ("${sourceNumber}" != "${candidateNumber}") {
            return 0.0;
        }
        if (sourceMultipleCode == candidateMultipleCode) {
            return 1.0;
        }
        return 0.8;
    }

    static fn computePostcodeScore(sourcePostcode: String, candidatePostcode: String, maxDistance: int): float {
        try {
            var srcVal = parseNumber(sourcePostcode) as int;
            var candVal = parseNumber(candidatePostcode) as int;
            var diff = abs(srcVal - candVal);
            if (diff >= maxDistance) {
                return 0.0;
            }
            return 1.0 - (diff * 1.0 / maxDistance);
        } catch (_) {
            return sourcePostcode.jarowinkler(candidatePostcode);
        }
    }

    static fn computeStreetScore(sourceStreet: String, candidateStreetName: String): float {
        return sourceStreet.jarowinkler(candidateStreetName.lowercase());
    }

    static fn computeStreetScoreGlobal(sourceStreet: String, candidateStreetName: String): float {
        var sizes = sourceStreet.size() + candidateStreetName.size();
        return (sizes - sourceStreet.levenshtein(candidateStreetName.lowercase())) / (sizes * 1.0);
    }

    static fn computeCityNameScore(sourceCityName: String, candidateCityName: String): float {
        return sourceCityName.jarowinkler(candidateCityName.lowercase());
    }

    static fn searchCity(cityName: String, threshold: float): Array<Match<node<GoldenCity>>> {
        var citiesMatches = Array<Match<node<GoldenCity>>> {};
        for (_, nCity in golden_cities_by_id) {
            var hit: node<GoldenCity>?;
            var d = GoldenServices::computeCityNameScore(cityName, nCity->name);
            if (d >= threshold) {
                hit = nCity;
            }
            for (_, alias in nCity->nameAliases) {
                var d2 = GoldenServices::computeCityNameScore(cityName, alias.value);
                if (d >= threshold && d2 > d) {
                    hit = nCity;
                    d = d2;
                }
            }
            if (hit != null) {
                citiesMatches.add(Match<node<GoldenCity>> { score: d, elem: hit });
            }
        }
        citiesMatches.sort_by(Match::score, SortOrder::desc);
        return citiesMatches;
    }

    /// Tries to find matches and computes similarity with street names.
    /// If nCity is provided, restricts the search to the streets of the given city.
    /// Otherwise, global search. 
    static fn searchStreet(streetName: String, threshold: float, nCity: node<GoldenCity>?): Array<Match<node<GoldenStreet>>> {
        var streetsMatches = Array<Match<node<GoldenStreet>>> {};
        var collection = golden_streets_by_id;
        if (nCity != null) {
            collection = nCity->streets_by_id;
        }
        for (_, nStreet in collection) {
            var d: float;
            var hit: node<GoldenStreet>?;
            if (nCity == null) {
                d = GoldenServices::computeStreetScoreGlobal(streetName, nStreet->name);
            } else {
                d = GoldenServices::computeStreetScore(streetName, nStreet->name);
            }
            if (d >= threshold) {
                hit = nStreet;
            }
            for (_, alias in nStreet->nameAliases) {
                var d2: float;
                if (nCity == null) {
                    d2 = GoldenServices::computeStreetScoreGlobal(streetName, alias.value);
                } else {
                    d2 = GoldenServices::computeStreetScore(streetName, alias.value);
                }
                if (d2 >= threshold && d2 > d) {
                    hit = nStreet;
                    d = d2;
                }
            }
            if (hit != null) {
                streetsMatches.add(Match<node<GoldenStreet>> { score: d, elem: hit });
            }
        }
        streetsMatches.sort_by(Match::score, SortOrder::desc);
        return streetsMatches;
    }

    /// Adds a candidate to the bounded candidates list, keeping only the top maxCandidatesPerItem entries.
    static fn addCandidate(candidates: Array<CandidateMatch<node<POIRecordProvider>>>, candidate: CandidateMatch<node<POIRecordProvider>>, maxCandidates: int) {
        if (candidates.size() < maxCandidates) {
            candidates.add(candidate);
        } else if (candidate.overallScore > candidates[candidates.size() - 1].overallScore) {
            candidates.set(candidates.size() - 1, candidate);
        } else {
            return;
        }
        candidates.sort_by(CandidateMatch::overallScore, SortOrder::desc);
    }

    /// Searches POIs for matches, populates candidates, and returns perfect matches.
    /// If nStreet is provided, restricts the search to that street's POIs.
    /// Otherwise, searches globally and computes city/street scores from each POI's own street.
    static fn searchPOIForItem(
        item: SearchItem,
        nStreet: node<GoldenStreet>?,
        params: SearchParameters,
        candidates: Array<CandidateMatch<node<POIRecordProvider>>>,
        cityScore: float?,
        streetScore: float?
    ): Array<CandidateMatch<node<POIRecordProvider>>> {
        var perfectMatches = Array<CandidateMatch<node<POIRecordProvider>>> {};
        var collection = golden_pois_by_id;
        if (nStreet != null) {
            collection = nStreet->pois_by_id;
        }
        for (_, nBuilding in collection) {
            var dPostcode = GoldenServices::computePostcodeScore(item.postcode, nBuilding->postCode, params.postcodeMaxDistance);
            if (dPostcode < params.postcodeSimilarityThreshold) {
                continue;
            }
            var dNumber = GoldenServices::computeNumberScore(item.number, item.multipleCode, nBuilding->number, nBuilding->multipleCode);

            if (dNumber == 0.0) {
                continue;
            }
            var geoScore = GoldenServices::computeGeoScore(item.coordinates, nBuilding->primaryLocation, params.geoParams);

            // Compute city/street scores: use provided values, or derive from the POI's street
            var cScore = cityScore ?? 0.0;
            var sScore = streetScore ?? 0.0;
            if (cityScore == null && nBuilding->street != null) {
                cScore = GoldenServices::computeCityScore(item.city, nBuilding->street->city);
                sScore = GoldenServices::computeStreetScoreGlobal(item.street, nBuilding->street->name);
            }

            var overallScore = GoldenServices::computeOverallScore(cScore, sScore, dNumber, dPostcode, geoScore, params.weights);

            var candidate = CandidateMatch<node<POIRecordProvider>> {
                cityScore: cScore,
                streetScore: sScore,
                numberScore: dNumber,
                postcodeScore: dPostcode,
                geoScore: geoScore,
                overallScore: overallScore,
                elem: nBuilding,
            };
            GoldenServices::addCandidate(candidates, candidate, params.maxCandidatesPerItem);
            if (overallScore == 1.0) {
                perfectMatches.add(candidate);
            }
        }
        return perfectMatches;
    }

    static fn search(req: SearchRequest): Array<mengplaz::SearchResult> {
        var results = Array<mengplaz::SearchResult> {};
        for (_, nRecord in req.items) {
            try {
                results.add(GoldenServices::searchItem(nRecord, req.params));
            } catch (err) {
                error(err);
            }
        }
        return results;
    }

    /// Searches streets and POIs within a city (or globally if nCity is null).
    /// Returns a SearchResult if a perfect match is found, otherwise returns null and populates candidates.
    static fn searchStreetsForItem(
        nRecord: node<POIRecordProvider>,
        item: SearchItem,
        nCity: node<GoldenCity>?,
        params: SearchParameters,
        candidates: Array<CandidateMatch<node<POIRecordProvider>>>
    ): mengplaz::SearchResult? {
        var bestByStreetId = Map<node<GoldenStreet>, Match<node<GoldenStreet>>> {};
        var sourceNames = Array<String> { item.street };
        if (item.streetAliases != null) {
            for (_, alias in item.streetAliases) {
                sourceNames.add(alias.value.lowercase());
            }
        }
        for (_, sourceName in sourceNames) {
            var matches = GoldenServices::searchStreet(
                sourceName,
                params.streetSimilarityThreshold,
                nCity
            );
            for (_, m in matches) {
                var existing = bestByStreetId.get(m.elem);
                if (existing == null || m.score > existing.score) {
                    bestByStreetId.set(m.elem, m);
                }
            }
        }
        var streetsMatches = Array<Match<node<GoldenStreet>>> {};
        for (_, m in bestByStreetId) {
            streetsMatches.add(m);
        }
        streetsMatches.sort_by(Match::score, SortOrder::desc);
        var perfectMatchCandidates = Array<CandidateMatch<node<POIRecordProvider>>> {};
        for (_, streetMatch in streetsMatches) {
            var cityScore = GoldenServices::computeCityScore(item.city, streetMatch.elem->city);
            var perfectMatches = GoldenServices::searchPOIForItem(item, streetMatch.elem, params, candidates, cityScore, streetMatch.score);
            for (_, pm in perfectMatches) {
                perfectMatchCandidates.add(pm);
            }
        }
        if (perfectMatchCandidates.size() > 0) {
            return mengplaz::SearchResult {
                sourceRecord: nRecord,
                candidates: perfectMatchCandidates
            };
        }
        return null;
    }

    static fn searchItem(nRecord: node<POIRecordProvider>, params: SearchParameters): mengplaz::SearchResult {
        var candidates = Array<CandidateMatch<node<POIRecordProvider>>> {};
        var item = nRecord->toSearchItem();

        // Search city first to scope street search
        var cityMatches = GoldenServices::searchCity(item.city, params.citySimilarityThreshold);
        if (cityMatches.size() == 0) {
            // No city matches - do global street search
            var result = GoldenServices::searchStreetsForItem(nRecord, item, null, params, candidates);
            if (result != null) {
                return result;
            }
        } else {
            for (_, cityMatch in cityMatches) {
                var result = GoldenServices::searchStreetsForItem(nRecord, item, cityMatch.elem, params, candidates);
                if (result != null) {
                    return result;
                }
            }
        }

        // Deep search: global POI search when no street-level candidates found (heavy)
        if (params.deepSearch && candidates.size() == 0) {
            var perfectMatches = GoldenServices::searchPOIForItem(item, null, params, candidates, null, null);
            if (perfectMatches.size() > 0) {
                return mengplaz::SearchResult {
                    sourceRecord: nRecord,
                    candidates: perfectMatches,
                };
            }
        }

        // Still no candidates - try geo-circle fallback
        if (candidates.size() == 0 && item.coordinates != null) {
            var shape = GeoCircle { center: item.coordinates, radius: params.geoParams.maxDistance as float };
            for (candidateGeo, nCandidate in golden_pois_by_geo[shape.sw()..shape.ne()]) {
                if (shape.contains(candidateGeo)) {
                    var geoScore = GoldenServices::computeGeoScore(item.coordinates, candidateGeo, params.geoParams) ?? 0.0;
                    if (geoScore > params.coordinatesSimilarityThreshold) {
                        var cityScore = 0.0;
                        var streetScore = 0.0;
                        if (nCandidate->street != null) {
                            cityScore = GoldenServices::computeCityScore(item.city, nCandidate->street->city);
                            streetScore = GoldenServices::computeStreetScore(item.street, nCandidate->street->name);
                        }
                        var postcodeScore = GoldenServices::computePostcodeScore(item.postcode, nCandidate->postCode, params.postcodeMaxDistance);
                        var numberScore = GoldenServices::computeNumberScore(item.number, item.multipleCode, nCandidate->number, nCandidate->multipleCode);
                        var overallScore = GoldenServices::computeOverallScore(cityScore, streetScore, numberScore, postcodeScore, geoScore, params.weights);
                        var candidate = CandidateMatch<node<POIRecordProvider>> {
                            cityScore: cityScore,
                            streetScore: streetScore,
                            numberScore: numberScore,
                            postcodeScore: postcodeScore,
                            geoScore: geoScore,
                            overallScore: overallScore,
                            elem: nCandidate,
                        };
                        GoldenServices::addCandidate(candidates, candidate, params.maxCandidatesPerItem);
                    }
                }
            }
        }

        return mengplaz::SearchResult {
            sourceRecord: nRecord,
            candidates: candidates,
        };
    }

    static fn fillFromCaclr() {
        for (constCode, nConstituency in caclr_consistuency_by_code) {
            var nGoldenConstituency = nConstituency->goldenConstituency;
            if (nGoldenConstituency == null) {
                nGoldenConstituency = node<GoldenConstituency> {
                    GoldenConstituency {
                        code: nConstituency->code,
                        name: nConstituency->name,
                        nameAliases: Array<Alias> {},
                        cantons_by_id: nodeIndex<String, node<GoldenCanton>> {},
                    }
                };
                golden_constituency_by_code.set(constCode, nGoldenConstituency);
                nConstituency->goldenConstituency = nGoldenConstituency;
                nGoldenConstituency->caclrConstituency = nConstituency;
                info("New GoldenConstituency added: code=${nGoldenConstituency->code} name=${nGoldenConstituency->name}");
            }

            for (cantonId, nCanton in nConstituency->cantons_by_id) {
                var nGoldenCanton = nCanton->goldenCanton;
                if (nGoldenCanton == null) {
                    var newCantonUID: String;
                    do {
                        newCantonUID = GoldenServices::generateUID();
                    } while (golden_cantons_by_id.get(newCantonUID) != null);
                    nGoldenCanton = node<GoldenCanton> {
                        GoldenCanton {
                            id: newCantonUID,
                            name: nCanton->name,
                            nameAliases: Array<Alias> {},
                            lastUpdate: nCanton->lastUpdate,
                            constituency: nGoldenConstituency,
                            municipalities_by_id: nodeIndex<String, node<GoldenMunicipality>> {},
                        }
                    };
                    nGoldenConstituency->cantons_by_id.set(newCantonUID, nGoldenCanton);
                    golden_cantons_by_id.set(newCantonUID, nGoldenCanton);
                    nCanton->goldenCanton = nGoldenCanton;
                    nGoldenCanton->caclrCanton = nCanton;
                    info("New GoldenCanton added: id=${nGoldenCanton->id} name=${nGoldenCanton->name}");
                }

                for (municipalityId, nMunicipality in nCanton->municipalities_by_id) {
                    var nGoldenMunicipality = nMunicipality->goldenMunicipality;
                    if (nGoldenMunicipality == null) {
                        var newMunicipalityUID: String;
                        do {
                            newMunicipalityUID = GoldenServices::generateUID();
                        } while (golden_municipalities_by_id.get(newMunicipalityUID) != null);
                        nGoldenMunicipality = node<GoldenMunicipality> {
                            GoldenMunicipality {
                                id: newMunicipalityUID,
                                name: nMunicipality->name,
                                nameAliases: Array<Alias> {},
                                lastUpdate: nMunicipality->lastUpdate,
                                canton: nGoldenCanton,
                                cities_by_id: nodeIndex<String, node<GoldenCity>> {},
                            }
                        };
                        nGoldenMunicipality->indexing(nGoldenMunicipality);
                        nMunicipality->goldenMunicipality = nGoldenMunicipality;
                        nGoldenMunicipality->caclrMunicipality = nMunicipality;
                        info("New GoldenMunicipality added: id=${nGoldenMunicipality->id} name=${nGoldenMunicipality->name}");
                    }

                    for (cityId, nCity in nMunicipality->cities_by_id) {
                        var nGoldenCity = nCity->goldenCity;
                        if (nGoldenCity == null) {
                            var newCityUID: String;
                            do {
                                newCityUID = GoldenServices::generateUID();
                            } while (golden_municipalities_by_id.get(newCityUID) != null);
                            nGoldenCity = node<GoldenCity> {
                                GoldenCity {
                                    id: newCityUID,
                                    name: nCity->name,
                                    nameAliases: Array<Alias> {},
                                    lastUpdate: nCity->lastUpdate,
                                    municipality: nGoldenMunicipality,
                                    streets_by_id: nodeIndex<String, node<GoldenStreet>> {},
                                }
                            };
                            for (_, alias in nCity->aliases) {
                                nGoldenCity->nameAliases.add(clone(alias));
                            }
                            nGoldenMunicipality->cities_by_id.set(newCityUID, nGoldenCity);
                            nGoldenCity->indexing(nGoldenCity);
                            nCity->goldenCity = nGoldenCity;
                            nGoldenCity->caclrCity = nCity;
                            info("New GoldenCity added: id=${nGoldenCity->id} name=${nGoldenCity->name}");
                        }

                        for (streetId, nStreet in nCity->streets_by_id) {
                            var nGoldenStreet = nStreet->goldenStreet;
                            if (nGoldenStreet == null) {
                                var newStreetUID: String;
                                do {
                                    newStreetUID = GoldenServices::generateUID();
                                } while (golden_municipalities_by_id.get(newStreetUID) != null);
                                nGoldenStreet = node<GoldenStreet> {
                                    GoldenStreet {
                                        id: newStreetUID,
                                        name: nStreet->name,
                                        nameAliases: Array<Alias> {},
                                        lastUpdate: nStreet->lastUpdate,
                                        city: nGoldenCity,
                                        pois_by_id: nodeIndex<String, node<GoldenPointOfInterest>> {},
                                    }
                                };
                                for (_, alias in nStreet->aliases) {
                                    nGoldenStreet->nameAliases.add(clone(alias));
                                }
                                nGoldenStreet->indexing(nGoldenStreet);
                                nStreet->goldenStreet = nGoldenStreet;
                                nGoldenStreet->caclrStreet = nStreet;
                                info("New GoldenStreet added: id=${nGoldenStreet->id} name=${nGoldenStreet->name}");
                            }

                            // for (buildingId, nBuilding in nStreet->buildings_by_id) {
                            //     var newUID: String;
                            //     do {
                            //         newUID = GoldenServices::generateUID();
                            //     } while (golden_pois_by_id.get(newUID) != null);

                            //     var nGoldenPOI = node<GoldenPointOfInterest> {
                            //         GoldenPointOfInterest {
                            //             uid: newUID,
                            //             number: nBuilding->number,
                            //             multipleCode: nBuilding->multipleCode,
                            //             postCode: nBuilding->postalCode,
                            //             secondaryLocations: Map<String, geo> {},
                            //             lastUpdate: nBuilding->lastUpdate,
                            //             street: nGoldenStreet,
                            //             linkedRecords: Array<LinkedRecordEntry> {},
                            //             quality: nodeTime<QualityEvent> {}
                            //         }
                            //     };
                            //     nGoldenPOI->indexing(nGoldenPOI);
                            // }
                        }
                    }
                }
            }
        }
    }

    static fn createBbackup() {
        var writer = GcbWriter<GoldenConstituency> { path: "./backups/${time::now()}.gcb" };
        for (k, v in golden_constituency_by_code) {
            writer.write(*v);
        }
        writer.flush();
    }

    static fn restoreFromBackup(path: String) {
        var reader = GcbReader<GoldenConstituency> { path: path };
        while (reader.can_read()) {
            var constutiency = reader.read();
            golden_constituency_by_code.set(constutiency.code, node<GoldenConstituency> { constutiency });
        }
    }

    static fn computeQuality(linkedRecords: Array<LinkedRecordEntry>): float {
        if (linkedRecords.size() == 0) {
            return 0.0;
        }

        // Calculate total weight of all available sources
        var totalAvailableWeight = 0.0;
        for (_, nSource in sources_by_name) {
            totalAvailableWeight = totalAvailableWeight + nSource->getWeight();
        }

        if (totalAvailableWeight == 0.0) {
            return 0.0;
        }
        // Group records by source and average scores for same-source records
        var scoresBySource = Map<node<DataSource>, Array<float>> {};
        for (_, entry in linkedRecords) {
            var nSource = entry.record->getSource();
            var scores = scoresBySource.get(nSource);
            var s = entry.detailedScore?.resolve().overallScore;
            if (s == null) {
                continue;
            }
            if (scores == null) {
                var arr = Array<float> {};
                arr.add(s);
                scoresBySource.set(nSource, arr);
            } else {
                scores.add(s);
            }
        }
        var weightedSum = 0.0;
        for (nSource, scores in scoresBySource) {
            var avgScore = 0.0;
            for (_, score in scores) {
                avgScore = avgScore + score;
            }
            avgScore = avgScore / scores.size();
            weightedSum = weightedSum + (nSource->getWeight() * avgScore);
        }

        return weightedSum / totalAvailableWeight;
    }

    /// Computes and records the global quality score by looping over all golden POIs.
    /// This should be called periodically to update the global quality history.
    static fn computeAndRecordGlobalQuality() {
        var nSource = sources_by_name.get(GoldenSource::NAME);
        if (nSource == null) {
            return;
        }

        var total = 0.0;
        for (_, nGolden in golden_pois_by_id) {
            var quality = GoldenServices::computeQuality(nGolden->linkedRecords);
            total = total + quality;
        }

        var avg = 0.0;
        if (total > 0) {
            avg = total / golden_pois_by_id.size();
        }

        var source = *nSource;
        if (source is GoldenSource) {
            source.qualityHistory.setAt(time::now(), avg);
        }
    }
}

