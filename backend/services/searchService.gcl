type AddressSearchInput {
    input: String;
    source: String?;
    results: Array<node<POIRecordProvider>>;
}

var address_searches: nodeTime<AddressSearchInput>;

@volatile
type ScoredCity {
    city: any;
    distance: float;
}

@volatile
type ScoredStreet {
    street: any;
    distance: float;
}

@volatile
type ScoredPoi {
    poi: node<POIRecordProvider>;
    distance: float;
}
