type AddressSearchInput {
    input: String;
    source: String?;
    results: Array<node<POIRecordProvider>>;
}

var address_searches: nodeTime<AddressSearchInput>;

type ScoredCity {
    city: any;
    distance: float;
}

type ScoredStreet {
    street: any;
    distance: float;
}

type ScoredPoi {
    poi: node<POIRecordProvider>;
    distance: float;
}

fn iter(arr: Array<String>?): Array<String> {
    var out = Array<String> {};
    if (arr == null) {
        return out;
    }
    for (_, v in arr) {
        var s = v.trim().lowercase();
        if (s.size() > 0) {
            out.add(s);
        }
    }
    return out;
}
