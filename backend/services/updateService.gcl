@permission("admin")
@expose
fn updateCACLR() {
    info("Started CACLR Import");
    CACLRLoader::loadCantons();
    CACLRLoader::loadMunicipalities();
    CACLRLoader::loadCities();
    CACLRLoader::loadStreets();
    var errored = CACLRLoader::loadBuildings();

    info("Filling Golden from fresh CACLR Import");
    GoldenServices::fillFromCaclr();

    var s = sources_by_name.get(CaclrSource::NAME);
    if (s == null) {
        return;
    }
    var report = s->reconciliationReport;
    var toReconcile = Array<node<POIRecordProvider>> {};
    for (_, nBuilding in caclr_buildings_by_id) {
        if (nBuilding->getLinkedGolden() == null && report->unlinked.get(nBuilding) == null) {
            toReconcile.add(nBuilding);
        }
    }
    info("Found ${toReconcile.size()} Records to reconcile");
    // `!= true`, not `== false`: `isReconciling` is null before the first reconcile.
    if (s->isReconciling?.resolve() != true) {
        DataSource::reconcile(s, null, toReconcile);
    }

    var lastT = s->lastUpdate ?? time::parse("2025-12-15", null); // Date of the last manual import
    var toPromote = Array<node<CaclrBuilding>> {};
    if (golden_pois_by_id.size() == 0) {
        // Empty Golden index, we are in a fresh bootstrap promote all CACLR to golden
        for (record: node<CaclrBuilding>, _ in report->unlinked) {
            toPromote.add(record);
        }
    } else {
        for (record: node<CaclrBuilding>, _ in report->unlinked) {
            if (record->validityStartDate > lastT || record->lastUpdate > lastT) {
                toPromote.add(record);
            }
        }
    }

    info("Found ${toPromote.size()} Records to promote");

    var skipped = 0;
    var failed = 0;
    for (_, record in toPromote) {
        try {
            if (record->street != null) {
                var streetIdx = record->street->goldenStreet?.resolve().id;
                if (streetIdx != null) {
                    promoteRecord(record, streetIdx);
                } else {
                    skipped++;
                }
            } else {
                skipped++;
            }
        } catch (err) {
            error("Failed promoting ${record->id}  \n ${err}");
            failed++;
        }
    }
    if (skipped + failed > 0) {
        warn("Promotion: ${skipped} skipped (no golden street), ${failed} failed");
    }

    // TODO Handle Golden Records for whom the associated Caclr record doesn't exists anymore
    var c = 0;
    if (errored == false) {
        for (_, nRecord in caclr_buildings_by_id) {
            if (nRecord->lastSeenAt == null || lastT > nRecord->lastSeenAt) {
                nRecord->deprecated = true;
                c++;
            }
        }
        info("${c} Addresses marked as deprecated");
    }
    StatsService::finalizeUpdate(s, errored == false);

    info("Updating Golden street index");
    buildGoldenStreetIndex();
    info("Updating Golden address index");
    buildGoldenTextIndex();
    info("Updating CACLR address index");
    buildSourceTextIndex(CaclrSource::NAME);
    info("Caclr Update finished");
}

/// Run this once CACLR has finished, so linked records update against a current CACLR.
@permission("admin")
@expose
fn updateBDA() {
    info("Started BDA Import");
    var loaded = BDAddressLoader::load();

    var s = sources_by_name.get(BDAddressSource::NAME);
    if (s == null) {
        return;
    }
    var lastT = s->lastUpdate ?? time::parse("2025-12-15", null); // Date of the last manual import
    var report = s->reconciliationReport;
    var toReconcile = Array<node<POIRecordProvider>> {};
    for (_, nBuilding in bda_address_by_geoportalid) {
        if (nBuilding->getLinkedGolden() == null && report->unlinked.get(nBuilding) == null) {
            toReconcile.add(nBuilding);
        }
    }
    info("Found ${toReconcile.size()} Records to reconcile");
    // `!= true`, not `== false`: `isReconciling` is null before the first reconcile.
    if (s->isReconciling?.resolve() != true) {
        try {
            DataSource::reconcile(s, null, toReconcile);
        } catch (err) {
            error(err);
        }
    }

    var toLink = Array<node<BDAddress>> {};
    var ids = Array<String> {};
    for (record: node<BDAddress>, _ in report->unlinked) {
        var caclrRecord = caclr_buildings_by_id.get("${record->id_caclr}");
        if (caclrRecord != null && caclrRecord->getLinkedGolden() != null) {
            toLink.add(record);
            ids.add(record->getId());
        }
    }

    for (_, value in toLink) {
        var caclrRecord = caclr_buildings_by_id.get("${value->id_caclr}");
        if (caclrRecord != null) {
            linkRecords(value, caclrRecord->getLinkedGolden()!!, null);
        }
    }
    mergePositionsToGolden(s, ids);
    info("Linked ${toLink.size()} Records");

    // An empty CSV is indistinguishable from a good one until it is counted, and deprecating
    // on it would flag the whole index.
    var c = 0;
    if (loaded > 0) {
        for (_, nRecord in bda_address_by_geoportalid) {
            if (nRecord->lastSeenAt == null || lastT > nRecord->lastSeenAt) {
                nRecord->deprecated = true;
                c++;
            }
        }
        info("${c} Addresses marked as deprecated");
    }

    StatsService::finalizeUpdate(s, loaded > 0);

    info("Updating BDA address index");
    buildSourceTextIndex(BDAddressSource::NAME);

    info("BDA import finished");
}

@permission("admin")
@expose
fn updateOSM() {
    info("Started OSM Import");
    var success = OSMLoader::load();
    if (success == false) {
        return;
    }

    var s = sources_by_name.get(OsmSource::NAME);
    if (s == null) {
        return;
    }
    var lastT = s->lastUpdate ?? time::parse("2025-12-15", null); // Date of the last manual import

    var report = s->reconciliationReport;
    var toReconcile = Array<node<POIRecordProvider>> {};
    for (_, nBuilding in osm_by_id) {
        if (nBuilding->getLinkedGolden() == null && report->unlinked.get(nBuilding) == null) {
            toReconcile.add(nBuilding);
        }
    }
    info("Found ${toReconcile.size()} Records to reconcile");
    // `!= true`, not `== false`: `isReconciling` is null before the first reconcile.
    if (s->isReconciling?.resolve() != true) {
        try {
            DataSource::reconcile(s, null, toReconcile);
        } catch (err) {
            error(err);
        }
    }

    var toLink = Array<node<OsmAddress>> {};
    var ids = Array<String> {};
    for (record: node<OsmAddress>, _ in report->unlinked) {
        var caclrRecord = caclr_buildings_by_id.get("${record->ref_caclr}");
        if (caclrRecord != null && caclrRecord->getLinkedGolden() != null) {
            toLink.add(record);
            ids.add(record->getId());
        }
    }

    for (_, value in toLink) {
        var caclrRecord = caclr_buildings_by_id.get("${value->ref_caclr}");
        if (caclrRecord != null) {
            linkRecords(value, caclrRecord->getLinkedGolden()!!, null);
        }
    }

    mergePositionsToGolden(s, ids);

    info("Linked ${toLink.size()} Records");

    var c = 0;
    for (_, nRecord in osm_by_id) {
        if (nRecord->lastSeenAt == null || lastT > nRecord->lastSeenAt) {
            nRecord->deprecated = true;
            c++;
        }
    }
    info("${c} Addresses marked as deprecated");

    StatsService::finalizeUpdate(s, true);

    info("Updating OSM address index");
    buildSourceTextIndex(OsmSource::NAME);

    info("OSM import finished");
}
