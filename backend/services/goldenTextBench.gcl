/// Latency benchmark for the golden text index.
///
///     greycat run goldenTextBench::bench
///
/// Every case carries the row the client meant, and the table reports the RANK it came back
/// at: the cheapest response of all is a confident page of wrong rows. Every rep is printed
/// rather than averaged, because the spread between the first and the rest IS the cache
/// effect. `println` rather than the logger, which never reaches the terminal - a table to
/// read is the CLI dump `println` is for; each case also emits a `BENCH,` CSV line so two
/// configurations can be diffed.
@volatile
type GoldenBenchCase {
    name: String;
    query: String;
    /// Must appear in the indexed body of the row the client meant.
    want: String;
}

/// Cases known to come back rank-0, each kept to document a real limit rather than to be
/// quietly fixed:
///
///   `typing 5 *`      `AddressIndex` matches whole terms, so a half-typed word is neither a
///                     term nor within the edit budget of one. Search-as-you-type needs a
///                     prefix pass layered back on top.
///   `commune only`    The query names no street in Walferdange, so the wanted row is not in
///                     the top k. Correct: hits > 0 and "found what was meant" differ.
///   `elision omitted` "5 rue de lindus" - the preset splits on an apostrophe the client did
///                     not type; it cannot split what is not there.
///   `abbreviated`     Some golden street names are stored abbreviated ("av. Grand Duc
///                     Jean"), so "av" is a rare term while "avenue" is common and BM25
///                     weights it far above the word it abbreviates. Fix it in the data.
fn cases(): Array<GoldenBenchCase> {
    var gare = "Avenue de la Gare";
    var elter = "Elterstrachen";
    var indus = "Rue de l'Industrie";
    return Array<GoldenBenchCase> {
        GoldenBenchCase { name: "full address", query: "4 Avenue de la Gare, 1610 Luxembourg", want: gare },
        GoldenBenchCase { name: "number + street", query: "4 avenue de la gare luxembourg", want: gare },
        GoldenBenchCase { name: "street + town", query: "avenue de la gare luxembourg", want: gare },
        GoldenBenchCase { name: "street only", query: "avenue de la gare", want: gare },
        GoldenBenchCase { name: "abbreviated", query: "av de la gare luxembourg", want: gare },
        GoldenBenchCase { name: "postcode only", query: "1610", want: gare },
        GoldenBenchCase { name: "postcode + town", query: "7260 bereldange", want: elter },
        GoldenBenchCase { name: "street + town 2", query: "elterstrachen bereldange", want: elter },
        GoldenBenchCase { name: "town only", query: "bereldange", want: elter },
        GoldenBenchCase { name: "commune only", query: "walferdange", want: elter },
        GoldenBenchCase { name: "typo one word", query: "elterstrahen bereldange", want: elter },
        GoldenBenchCase { name: "typo sole word", query: "bereldanje", want: elter },
        GoldenBenchCase { name: "typo street", query: "avenue de la garre luxembourg", want: gare },
        GoldenBenchCase { name: "typo street only", query: "avenue de la garre", want: gare },
        GoldenBenchCase { name: "word prefix", query: "bereldang", want: elter },
        GoldenBenchCase { name: "number + typo", query: "5 industrye", want: indus },
        GoldenBenchCase { name: "transposed typo", query: "5 indsutrye", want: indus },
        GoldenBenchCase { name: "typing 5 i", query: "5 i", want: indus },
        GoldenBenchCase { name: "typing 5 ind", query: "5 ind", want: indus },
        GoldenBenchCase { name: "typing 5 indus", query: "5 indus", want: indus },
        GoldenBenchCase { name: "typing 5 industr", query: "5 industr", want: indus },
        GoldenBenchCase { name: "typing full elided", query: "5 rue de l'indus", want: indus },
        GoldenBenchCase { name: "elision omitted", query: "5 rue de lindus", want: indus },
        GoldenBenchCase { name: "noise word", query: "zzzeldange", want: elter },
    };
}

fn ms(us: int): String {
    return float::to_string((us as float) / 1000.0, '.', null, 2, false);
}

fn col(b: Buffer, v: any?, w: int) {
    b.add_and_pad(v, w, ' ');
    b.add(" ");
}

/// 1-based position of the first hit carrying `want`, 0 when it is not in the results.
/// Reads the indexed document rather than resolving the payload, so it costs no graph
/// lookup - and it runs after the clock is read, never inside the timed window.
fn rank_of(idx: AddressIndex<String>, hits: Array<AddressSearchHit>, want: String): int {
    var needle = want.lowercase();
    for (var i = 0; i < hits.size(); i++) {
        var doc = idx.doc_of(hits[i]);
        if (doc != null) {
            if (
                "${doc.houseNumberText} ${doc.street}  ${doc.cityText}  ${doc.postalCodeText}  ${doc.country}"
                    .lowercase()
                    .contains(needle)
            ) {
                return i + 1;
            }
        }
    }
    return 0;
}

/// Runs the exact call `searchAddress` makes, `reps` times per query.
fn bench(k: int?, reps: int?) {
    var kk = k ?? 20;
    var n = reps ?? 3;
    var idx = GoldenTextSearch::require();

    // The first parse loads ~3 GB of NLP models, so warm up rather than billing that to
    // whichever case runs first.
    GoldenTextSearch::search(idx, "warmup", kk);

    var s = idx.index.stats();
    println("");
    println("golden text index benchmark  k=${kk} reps=${n}");
    println(
        "docs=${s.totalEntries} terms=${s.totalTerms} avgTokens=${float::to_string(s.avgTokenCount, '.', null, 2, false)}"
    );
    println("");

    var head = Buffer {};
    col(head, "case", 16);
    col(head, "query", 38);
    col(head, "hits", 4);
    col(head, "rank", 4);
    for (var i = 0; i < n; i++) {
        col(head, "run${i + 1}", 8);
    }
    col(head, "best", 8);
    println(head.toString());

    var cs = cases();
    for (var ci = 0; ci < cs.size(); ci++) {
        var c = cs[ci];
        var runs = Array<int> {};
        var hits = 0;
        var rank = 0;

        for (var r = 0; r < n; r++) {
            var t0 = time::now().to(DurationUnit::microseconds);
            var rows = GoldenTextSearch::search(idx, c.query, kk);
            var t1 = time::now().to(DurationUnit::microseconds);
            runs.add(t1 - t0);
            hits = rows.size();
            rank = rank_of(idx, rows, c.want);
        }

        var best = runs[0];
        for (var i = 1; i < runs.size(); i++) {
            if (runs[i] < best) {
                best = runs[i];
            }
        }

        var line = Buffer {};
        col(line, c.name, 16);
        col(line, c.query, 38);
        col(line, hits, 4);
        col(line, rank, 4);
        for (var i = 0; i < runs.size(); i++) {
            col(line, ms(runs[i]), 8);
        }
        col(line, ms(best), 8);
        println(line.toString());
        println("BENCH,${c.name},${c.query},${hits},${rank},${ms(best)}");
    }
}

/// Why a case regressed, where the bench only says that it did: the query's tokens, what
/// BM25 returns, what the last token completes to, and what a prefix pass returns.
///
///     greycat run goldenTextBench::probe "av de la gare luxembourg"
fn probe(q: String) {
    var ai = GoldenTextSearch::require();
    var idx = ai.index;
    var toks = TextTokenizer::tokenize(q, idx.config);
    var b = Buffer {};
    for (var i = 0; i < toks.size(); i++) {
        if (i > 0) {
            b.add(" | ");
        }
        b.add(toks[i].text);
    }
    println("query '${q}' tokens: ${b.toString()}");

    var last = toks[toks.size() - 1].text;
    var bm = GoldenTextSearch::search(ai, q, 5);
    println("  search -> ${bm.size()} hits");
    for (var i = 0; i < bm.size(); i++) {
        var r = bm[i].result;
        println(
            "    [${float::to_string(r.score, '.', null, 3, false)}] houseNumberMatch=${bm[i].houseNumberMatch} ${r.text}"
        );
    }
    var sug = idx.suggest(last, 10);
    var sb = Buffer {};
    for (var i = 0; i < sug.size(); i++) {
        if (i > 0) {
            sb.add(", ");
        }
        sb.add("${sug[i].term}(df=${sug[i].df})");
    }
    println("  suggest('${last}') -> ${sug.size()}: ${sb.toString()}");

    var pre = idx.search_prefix(last, 5);
    println("  prefix('${last}') -> ${pre.size()} hits");
    for (var i = 0; i < pre.size(); i++) {
        println("    [${float::to_string(pre[i].score, '.', null, 3, false)}] ${pre[i].text}");
    }
}
