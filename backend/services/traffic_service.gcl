type Traffic_Service {
    start: time;
    endPoint: node<Endpoint>;

    static fn start(func: function): Traffic_Service {
        var nodeEp = endpoints_by_name.get("${func}");
        if (nodeEp == null) {
            nodeEp = node<Endpoint> { Endpoint { name: "${func}", traffic: nodeTime<Traffic> {} } };
            endpoints_by_name.set(nodeEp->name, nodeEp);
        }
        return Traffic_Service {
            start: time::now(),
            endPoint: nodeEp
        };
    }

    fn end() {
        var traffic = Traffic {
            user: User::current(),
            executionTime: time::now() - this.start
        };
        this.endPoint->traffic.setAt(this.start, traffic);
    }
}
