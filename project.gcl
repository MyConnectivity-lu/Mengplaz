@include("backend");

@library("std", "8.2.85-dev");
@library("explorer", "8.2.2-dev");
@library("http", "8.2.18-dev");
@library("postal", "8.2.47-dev");
@library("text_search", "8.2.10-dev");

@role("public", "api");


fn main() {
    createAdmin();
    info("MengPlaz Ready !");

    Scheduler::add(BackupExporter::exportAll, DailyPeriodicity { hour: 23, minute: 55 }, PeriodicOptions {
        immediate: false
    });
    Scheduler::add(computeGlobalQuality, DailyPeriodicity { hour: 6 }, PeriodicOptions { immediate: false });

    Scheduler::add(runtime::Runtime::backup_full, DailyPeriodicity { hour: 1 }, PeriodicOptions { immediate: false });

    Scheduler::add(runtime::RuntimeUsage::collect, FixedPeriodicity { every: 30_s }, PeriodicOptions {
        immediate: false,
        start: time::now() + 10s
    });

    Scheduler::add(updateCACLR, DailyPeriodicity { hour: 23 }, PeriodicOptions { immediate: false });
    Scheduler::add(updateBDA, DailyPeriodicity { hour: 23, minute: 15 }, PeriodicOptions { immediate: false });
    Scheduler::add(updateOSM, DailyPeriodicity { hour: 23, minute: 30 }, PeriodicOptions { immediate: false });
}

fn bootstrap() {
    createAdmin();

    // loadCaclr();
    // loadBda();
    // loadOsm();

    GoldenSource::init();

    try {
        BackupImporter::importAll();
    } catch (err) {
        error("Restore From Backup Failed : ${err.message}");
    }
}

fn dump() {
    BackupExporter::exportAll();
}

private fn createAdmin() {
    var admLogin = System::getEnv("MENGPLAZ_ADMIN_LOGIN");
    if (admLogin != null && Identity::get_by_name(admLogin) == null) {
        // create is idempotent on the name: it returns the existing identity untouched
        var user = Identity::create(admLogin, "admin");
        if (!Identity::set_password(user.name, System::getEnv("MENGPLAZ_ADMIN_PASS") as String)) {
            throw "Unexpected error: password could not be set for user '${user.name}'";
        }
        info("MengPlaz Admin user created.");
    }
}

@permission("admin")
@expose
fn loadOsm() {
    OsmSource::init();
    try {
        OSMLoader::load();
    } catch (err) {
        error("OSM Failed : ${err.message}");
    }
}
@permission("admin")
@expose
fn loadBda() {
    BDAddressSource::init();
    try {
        BDAddressLoader::load();
    } catch (err) {
        error("BDA Failed : ${err.message}");
    }
}
@permission("admin")
@expose
fn loadCaclr() {
    CaclrSource::init();
    try {
        CACLRLoader::load();
    } catch (err) {
        error("CACLR Failed : ${err.message}");
    }
}
