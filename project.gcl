@include("backend");

@library("std", "8.2.179-stable");
@library("explorer", "8.2.9-stable");
@library("http", "8.3.5-dev");
@library("text_search", "8.3.8-dev");
@library("postal", "8.3.26-dev");

@role("public", "api");


fn main() {
    createAdmin();
    info("MengPlaz Ready !");

    Scheduler::add(computeGlobalQuality, DailyPeriodicity { hour: 6 }, PeriodicOptions { immediate: false });

    Scheduler::add(runtime::Runtime::backup_full, DailyPeriodicity { hour: 1 }, PeriodicOptions { immediate: false });

    Scheduler::add(
        runtime::RuntimeUsage::collect,
        FixedPeriodicity { every: 30_s },
        PeriodicOptions {
            immediate: false,
            start: time::now() + 10s
        }
    );

    Scheduler::add(UpdateService::caclr, DailyPeriodicity { hour: 23 }, PeriodicOptions { immediate: false });
    Scheduler::add(UpdateService::bda, DailyPeriodicity { hour: 23, minute: 15 }, PeriodicOptions { immediate: false });
    Scheduler::add(UpdateService::osm, DailyPeriodicity { hour: 23, minute: 30 }, PeriodicOptions { immediate: false });
    Scheduler::add(
        BackupExporter::exportAll,
        DailyPeriodicity { hour: 23, minute: 55 },
        PeriodicOptions {
            immediate: false
        }
    );
}

fn bootstrap() {
    createAdmin();

    GoldenSource::init();

    try {
        BackupImporter::importAll();
    } catch (err) {
        error("Restore From Backup Failed : ${err.message}");
    }

    // A missing or empty files/backup leaves the graph untouched, and a restore that threw
    // half way may have written nothing at all. Either way a fresh install must not end up// with an empty store, so fall back to the live sources. Same order as the restore's// dependency chain: CACLR, then BDA, then OSM. Each load* catches its own failure, so one// unreachable source does not stop the others.
    if (BackupImporter::isGraphEmpty()) {
        warn("Backup restored nothing: loading from the live sources instead.");
        CaclrSource::init();
        UpdateService::caclr();
        BdaSource::init();
        UpdateService::bda();
        OsmSource::init();
        UpdateService::osm();
    } else {
        info("Updating Golden street index");
        GoldenStreetSearch::rebuild();
        info("Updating Golden address index");
        GoldenTextSearch::rebuild();
        info("Updating Sources address index");
        SourceTextSearch::rebuildAll();
    }
}

private fn createAdmin() {
    var admLogin = System::getEnv("MENGPLAZ_ADMIN_LOGIN");
    if (admLogin != null && Identity::get_by_name(admLogin) == null) {
        // create is idempotent on the name: it returns the existing identity untouched
        var user = Identity::create(admLogin, "admin");
        if (!Identity::set_password(user.name, System::getEnv("MENGPLAZ_ADMIN_PASS") as String)) {
            throw "Unexpected error: password could not be set for user '${user.name}'";
        }
        info("MengPlaz Admin user created.");
    }
}
