@include("backend");

@library("std", "7.8.173-stable");
@library("explorer", "7.8.19-stable");
@library("postal");

@role("public", "files", "api");

@format_line_width(180);

fn main() {
    createAdmin();
    info("MengPlaz Ready !");

    Scheduler::add(GoldenExporter::exportAll, DailyPeriodicity { hour: 23 }, PeriodicOptions { immediate: false });
    Scheduler::add(computeGlobalQuality, DailyPeriodicity { hour: 22 }, PeriodicOptions { immediate: false });
}

fn bootstrap() {
    createAdmin();

    // loadCaclr();
    // loadBda();
    // loadOsm();

    GoldenSource::init();

    try {
        GoldenLoader::loadAll();
    } catch (err) {
        error("Load From Dumped Data Failed : ${err.message}");
    }
}

fn dump() {
    GoldenExporter::exportAll();
}

private fn createAdmin() {
    var admLogin = System::getEnv("MENGPLAZ_ADMIN_LOGIN");
    if (admLogin != null && User::getByName(admLogin) == null) {
        var user = User {
            id: 0,  // will be overwritten after 
            name: admLogin,
            full_name: "Administrator",
            email: "admin@mengplaz.lu",
            activated: true,
            role: "admin",
            external: false
        };

        var id = SecurityEntity::set(user); // for updates: get user and set again (name is the key)
        if (id == null) {
            throw "Unexpected error: user could not be created in Greycat";
        } else {
            User::setPassword(user.name, System::getEnv("MENGPLAZ_ADMIN_PASS") as String);
        }
        info("MengPlaz Admin user created.");
    }
}

@expose
fn loadOsm() {
    OsmSource::init();
    try {
        OSMLoader::load();
    } catch (err) {
        error("OSM Failed : ${err.message}");
    }
}

@expose
fn loadBda() {
    BDAddressSource::init();
    try {
        BDAddressLoader::load();
    } catch (err) {
        error("BDA Failed : ${err.message}");
    }
}

@expose
fn loadCaclr() {
    CaclrSource::init();
    try {
        CACLRLoader::load();
    } catch (err) {
        error("CACLR Failed : ${err.message}");
    }
}

@permission("admin")
@expose
fn populateGoldenIndexes() {
    for (_, nMun in golden_municipalities_by_id) {
        var munKey = nMun->name.lowercase();

        if (nMun->cities_by_name == null) {
            nMun->cities_by_name = nodeIndex<String, node<GoldenCity>> {};
        }

        golden_municipalities_by_name.set(munKey, nMun);
    }

    for (_, nCity in golden_cities_by_id) {
        var cityKey = nCity->name.lowercase();
        var cities = golden_cities_by_name.get(cityKey);
        if (cities == null) {
            cities = Array<node<GoldenCity>> {};
        }
        cities.add(nCity);
        golden_cities_by_name.set(cityKey, cities);

        if (nCity->streets_by_name == null) {
            nCity->streets_by_name = nodeIndex<String, node<GoldenStreet>> {};
        }
        nCity->municipality->cities_by_name?.set(cityKey, nCity);
    }

    for (_, nStreet in golden_streets_by_id) {
        var streetKey = nStreet->name.lowercase();
        var streets = golden_streets_by_name.get(streetKey);
        if (streets == null) {
            streets = Array<node<GoldenStreet>> {};
        }
        streets.add(nStreet);
        golden_streets_by_name.set(streetKey, streets);

        nStreet->city->streets_by_name!!.set(streetKey, nStreet);
        if (nStreet->pois_by_number == null) {
            nStreet->pois_by_number = nodeIndex<String, node<GoldenPointOfInterest>> {};
        }
    }

    for (_, nPoi in golden_pois_by_id) {
        var nStreet = nPoi->street;
        if (nStreet != null) {
            var numKey = "${nPoi->number}${nPoi->multipleCode}".lowercase();
            nStreet->pois_by_number?.set(numKey, nPoi);
        }
    }

    info("Golden indexes populated");
}

