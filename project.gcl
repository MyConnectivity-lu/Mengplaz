@include("backend");

@library("std", "7.8.175-stable");
@library("explorer", "7.8.19-stable");
@library("postal");

@role("public", "files", "api");

@format_line_width(180);

fn main() {
    createAdmin();
    info("MengPlaz Ready !");

    Scheduler::add(GoldenExporter::exportAll, DailyPeriodicity { hour: 23 }, PeriodicOptions { immediate: false });
    Scheduler::add(computeGlobalQuality, DailyPeriodicity { hour: 22 }, PeriodicOptions { immediate: false });

    Scheduler::add(runtime::Runtime::backup_full, DailyPeriodicity { hour: 20 }, PeriodicOptions { immediate: false });

    Scheduler::add(runtime::RuntimeUsage::collect, FixedPeriodicity { every: 20_s }, PeriodicOptions {
        immediate: false,
        start: time::now() + 10s
    });

    Scheduler::add(updateCACLR, DailyPeriodicity { hour: 23 }, PeriodicOptions { immediate: false });
    Scheduler::add(updateBDA, DailyPeriodicity { hour: 23, minute: 30 }, PeriodicOptions { immediate: false });
}

fn bootstrap() {
    createAdmin();

    // loadCaclr();
    // loadBda();
    // loadOsm();

    GoldenSource::init();

    try {
        GoldenLoader::loadAll();
    } catch (err) {
        error("Load From Dumped Data Failed : ${err.message}");
    }
}

fn dump() {
    GoldenExporter::exportAll();
}

private fn createAdmin() {
    var admLogin = System::getEnv("MENGPLAZ_ADMIN_LOGIN");
    if (admLogin != null && User::getByName(admLogin) == null) {
        var user = User {
            id: 0,
            name: admLogin,
            full_name: "Administrator",
            email: "admin@mengplaz.lu",
            activated: true,
            role: "admin",
            external: false
        };

        var id = SecurityEntity::set(user); // for updates: get user and set again (name is the key)
        if (id == null) {
            throw "Unexpected error: user could not be created in Greycat";
        } else {
            User::setPassword(user.name, System::getEnv("MENGPLAZ_ADMIN_PASS") as String);
        }
        info("MengPlaz Admin user created.");
    }
}

@expose
fn loadOsm() {
    OsmSource::init();
    try {
        OSMLoader::load();
    } catch (err) {
        error("OSM Failed : ${err.message}");
    }
}

@expose
fn loadBda() {
    BDAddressSource::init();
    try {
        BDAddressLoader::load();
    } catch (err) {
        error("BDA Failed : ${err.message}");
    }
}

@expose
fn loadCaclr() {
    CaclrSource::init();
    try {
        CACLRLoader::load();
    } catch (err) {
        error("CACLR Failed : ${err.message}");
    }
}


@expose
fn tmp_up() {
    var s = sources_by_name.get(CaclrSource::NAME);
    if (s == null) {
        return;
    }
    var report = s->reconciliationReport;
    var lastT = time::parse("2026-01-01", null); // Date of the last manual import

    var toPromote = Array<node<CaclrBuilding>> {};
    for (record: node<CaclrBuilding>, _ in report->unlinked) {
        if (record->lastUpdate > lastT) {
            toPromote.add(record);
        }
    }
    info("Found ${toPromote.size()} Records to promote");

    for (_, record in toPromote) {
        try {
            if (record->street != null) {
                var streetIdx = record->street->goldenStreet?.resolve().id;
                if (streetIdx != null) {
                    promoteRecord(record, streetIdx);
                }
            }
        } catch (err) {
            error("Failed promoting ${record->id}  \n ${err}");
        }
    }
}
