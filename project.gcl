@include("backend");

@library("std", "7.8.175-stable");
@library("explorer", "7.8.19-stable");
@library("postal");

@role("public", "files", "api");

@format_line_width(180);

fn main() {
    createAdmin();
    info("MengPlaz Ready !");

    Scheduler::add(GoldenExporter::exportAll, DailyPeriodicity { hour: 23 }, PeriodicOptions { immediate: false });
    Scheduler::add(computeGlobalQuality, DailyPeriodicity { hour: 22 }, PeriodicOptions { immediate: false });

    Scheduler::add(runtime::Runtime::backup_full, DailyPeriodicity { hour: 20 }, PeriodicOptions { immediate: false });

    Scheduler::add(runtime::RuntimeUsage::collect, FixedPeriodicity { every: 10_s }, PeriodicOptions { immediate: false, start: time::now() + 10s });
}

fn bootstrap() {
    createAdmin();

    // loadCaclr();
    // loadBda();
    // loadOsm();

    GoldenSource::init();

    try {
        GoldenLoader::loadAll();
    } catch (err) {
        error("Load From Dumped Data Failed : ${err.message}");
    }
}

fn dump() {
    GoldenExporter::exportAll();
}

private fn createAdmin() {
    var admLogin = System::getEnv("MENGPLAZ_ADMIN_LOGIN");
    if (admLogin != null && User::getByName(admLogin) == null) {
        var user = User {
            id: 0,  // will be overwritten after 
            name: admLogin,
            full_name: "Administrator",
            email: "admin@mengplaz.lu",
            activated: true,
            role: "admin",
            external: false
        };

        var id = SecurityEntity::set(user); // for updates: get user and set again (name is the key)
        if (id == null) {
            throw "Unexpected error: user could not be created in Greycat";
        } else {
            User::setPassword(user.name, System::getEnv("MENGPLAZ_ADMIN_PASS") as String);
        }
        info("MengPlaz Admin user created.");
    }
}

@expose
fn loadOsm() {
    OsmSource::init();
    try {
        OSMLoader::load();
    } catch (err) {
        error("OSM Failed : ${err.message}");
    }
}

@expose
fn loadBda() {
    BDAddressSource::init();
    try {
        BDAddressLoader::load();
    } catch (err) {
        error("BDA Failed : ${err.message}");
    }
}

@expose
fn loadCaclr() {
    CaclrSource::init();
    try {
        CACLRLoader::load();
    } catch (err) {
        error("CACLR Failed : ${err.message}");
    }
}

@permission("admin")
@expose
fn linkCaclrToGolden() {
    var constLinked = 0;
    var constMissed = 0;
    var cantonLinked = 0;
    var cantonMissed = 0;
    var munLinked = 0;
    var munMissed = 0;
    var cityLinked = 0;
    var cityMissed = 0;
    var streetLinked = 0;
    var streetMissed = 0;

    for (constCode, nCaclrConst in caclr_consistuency_by_code) {
        if (constCode == "UNKNOWN") {
            continue;
        }

        var nGoldenConst = golden_constituency_by_code.get(constCode);
        if (nGoldenConst == null) {
            constMissed++;
            warn("No GoldenConstituency found for CACLR code:${constCode} name:${nCaclrConst->name}");
            continue;
        }

        nCaclrConst->goldenConstituency = nGoldenConst;
        nGoldenConst->caclrConstituency = nCaclrConst;
        constLinked++;

        for (cantonId, nCaclrCanton in nCaclrConst->cantons_by_id) {
            if (cantonId == "UNKNOWN") {
                continue;
            }

            var caclrCantonName = nCaclrCanton->name.lowercase();
            var nGoldenCanton: node<GoldenCanton>? = null;
            for (_, nCandidate in nGoldenConst->cantons_by_id) {
                if (nCandidate->name.lowercase() == caclrCantonName) {
                    nGoldenCanton = nCandidate;
                    break;
                }
            }

            if (nGoldenCanton == null) {
                cantonMissed++;
                warn("No GoldenCanton found for CACLR id:${cantonId} name:${nCaclrCanton->name}");
                continue;
            }

            nCaclrCanton->goldenCanton = nGoldenCanton;
            nGoldenCanton->caclrCanton = nCaclrCanton;
            cantonLinked++;
        }
    }

    for (munId, nCaclrMun in caclr_municipalities_by_id) {
        if (munId == "UNKNOWN") {
            continue;
        }

        var nGoldenMun = golden_municipalities_by_name.get(nCaclrMun->name.lowercase());
        if (nGoldenMun == null) {
            munMissed++;
            warn("No GoldenMunicipality found for CACLR id:${munId} name:${nCaclrMun->name}");
            continue;
        }

        nCaclrMun->goldenMunicipality = nGoldenMun;
        nGoldenMun->caclrMunicipality = nCaclrMun;
        munLinked++;

        for (cityId, nCaclrCity in nCaclrMun->cities_by_id) {
            var nGoldenCity = nGoldenMun->cities_by_name?.get(nCaclrCity->name.lowercase());
            if (nGoldenCity == null) {
                cityMissed++;
                continue;
            }

            nCaclrCity->goldenCity = nGoldenCity;
            nGoldenCity->caclrCity = nCaclrCity;
            cityLinked++;

            for (streetId, nCaclrStreet in nCaclrCity->streets_by_id) {
                var nGoldenStreet = nGoldenCity->streets_by_name?.get(nCaclrStreet->name.lowercase());
                if (nGoldenStreet == null) {
                    warn("No Street found for CACLR id:${streetId} name:${nCaclrStreet->name}");
                    streetMissed++;
                    continue;
                }

                nCaclrStreet->goldenStreet = nGoldenStreet;
                nGoldenStreet->caclrStreet = nCaclrStreet;
                streetLinked++;
            }
        }
    }

    info("Constituencies linked: ${constLinked}, missed: ${constMissed}");
    info("Cantons linked: ${cantonLinked}, missed: ${cantonMissed}");
    info("Municipalities linked: ${munLinked}, missed: ${munMissed}");
    info("Cities linked: ${cityLinked}, missed: ${cityMissed}");
    info("Streets linked: ${streetLinked}, missed: ${streetMissed}");
}

@permission("admin")
@expose
fn populateGoldenIndexes() {
    for (_, nMun in golden_municipalities_by_id) {
        var munKey = nMun->name.lowercase();

        if (nMun->cities_by_name == null) {
            nMun->cities_by_name = nodeIndex<String, node<GoldenCity>> {};
        }

        golden_municipalities_by_name.set(munKey, nMun);
    }

    for (_, nCity in golden_cities_by_id) {
        var cityKey = nCity->name.lowercase();
        var cities = golden_cities_by_name.get(cityKey);
        if (cities == null) {
            cities = Array<node<GoldenCity>> {};
        }
        cities.add(nCity);
        golden_cities_by_name.set(cityKey, cities);

        if (nCity->streets_by_name == null) {
            nCity->streets_by_name = nodeIndex<String, node<GoldenStreet>> {};
        }
        nCity->municipality->cities_by_name?.set(cityKey, nCity);
    }

    for (_, nStreet in golden_streets_by_id) {
        var streetKey = nStreet->name.lowercase();
        var streets = golden_streets_by_name.get(streetKey);
        if (streets == null) {
            streets = Array<node<GoldenStreet>> {};
        }
        streets.add(nStreet);
        golden_streets_by_name.set(streetKey, streets);

        nStreet->city->streets_by_name!!.set(streetKey, nStreet);
        if (nStreet->pois_by_number == null) {
            nStreet->pois_by_number = nodeIndex<String, node<GoldenPointOfInterest>> {};
        }
    }

    for (_, nPoi in golden_pois_by_id) {
        var nStreet = nPoi->street;
        if (nStreet != null) {
            var numKey = "${nPoi->number}${nPoi->multipleCode}".lowercase();
            nStreet->pois_by_number?.set(numKey, nPoi);
        }
    }

    info("Golden indexes populated");
}

@permission("admin")
@expose
fn populateCaclrIndexes() {
    for (_, nMun in caclr_municipalities_by_id) {
        if (nMun->id == "UNKNOWN") {
            continue;
        }
        var munKey = nMun->name.lowercase();

        if (nMun->cities_by_name == null) {
            nMun->cities_by_name = nodeIndex<String, node<CaclrCity>> {};
        }

        caclr_municipalities_by_name.set(munKey, nMun);
    }

    for (_, nCity in caclr_cities_by_id) {
        if (nCity->id == "UNKNOWN") {
            continue;
        }
        var cityKey = nCity->name.lowercase();
        var cities = caclr_cities_by_name.get(cityKey);
        if (cities == null) {
            cities = Array<node<CaclrCity>> {};
        }
        cities.add(nCity);
        caclr_cities_by_name.set(cityKey, cities);

        if (nCity->streets_by_name == null) {
            nCity->streets_by_name = nodeIndex<String, node<CaclrStreet>> {};
        }
        nCity->municipality->cities_by_name?.set(cityKey, nCity);
    }

    for (_, nStreet in caclr_streets_by_id) {
        if (nStreet->id == "UNKNOWN") {
            continue;
        }
        var streetKey = nStreet->name.lowercase();
        var streets = caclr_streets_by_name.get(streetKey);
        if (streets == null) {
            streets = Array<node<CaclrStreet>> {};
        }
        streets.add(nStreet);
        caclr_streets_by_name.set(streetKey, streets);

        nStreet->city->streets_by_name?.set(streetKey, nStreet);

        if (nStreet->buildings_by_number == null) {
            nStreet->buildings_by_number = nodeIndex<String, node<CaclrBuilding>> {};
        }
    }

    for (_, nBuilding in caclr_buildings_by_id) {
        var nStreet = nBuilding->street;
        if (nStreet != null) {
            var numKey = "${nBuilding->number}${nBuilding->multipleCode}";
            nStreet->buildings_by_number?.set(numKey, nBuilding);
        }
    }

    info("CACLR indexes populated");
}

@permission("admin")
@expose
fn populateBdaIndexes() {
    for (_, nAddress in bda_address_by_geoportalid) {
        var munKey = nAddress->municipatlity->name.lowercase();
        bda_municipalities_by_name.set(munKey, nAddress->municipatlity);
        if (nAddress->municipatlity->cities_by_name == null) {
            nAddress->municipatlity->cities_by_name = nodeIndex<String, node<BDACity>> {};
        }

        var cityKey = nAddress->city->name.lowercase();
        if (nAddress->municipatlity->cities_by_name?.get(cityKey) == null) {
            nAddress->municipatlity->cities_by_name?.set(cityKey, nAddress->city);
            var cities = bda_cities_by_name.get(cityKey);
            if (cities == null) {
                cities = Array<node<BDACity>> {};
            }
            if (nAddress->city->municipality == null) {
                nAddress->city->municipality = nAddress->municipatlity;
            }
            cities.add(nAddress->city);
            bda_cities_by_name.set(cityKey, cities);
        }

        var streetKey = nAddress->street->name.lowercase();

        if (nAddress->city->streets_by_name == null) {
            nAddress->city->streets_by_name = nodeIndex<String, node<BDAStreet>> {};
        }

        if (nAddress->city->streets_by_name.get(streetKey) == null) {
            nAddress->city->streets_by_name.set(streetKey, nAddress->street);
            var streets = bda_streets_by_name.get(streetKey);
            if (streets == null) {
                streets = Array<node<BDAStreet>> {};
            }
            streets.add(nAddress->street);
            bda_streets_by_name.set(streetKey, streets);
            bda_street_by_cacrid.set(nAddress->street->id_caclr, nAddress->street);

            if (nAddress->street->city == null) {
                nAddress->street->city = nAddress->city;
            }
            if (nAddress->street->addresses_by_id == null) {
                nAddress->street->addresses_by_id = nodeIndex<String, node<BDAddress>> {};
            }
            if (nAddress->street->addresses_by_number == null) {
                nAddress->street->addresses_by_number = nodeIndex<String, node<BDAddress>> {};
            }
        }
        nAddress->street->addresses_by_id?.set(nAddress->id_geoportail, nAddress);
        nAddress->street->addresses_by_number?.set(nAddress->number, nAddress);
    }

    info("BDA indexes populated");
}

@permission("admin")
@expose
fn populateOsmIndexes() {
    for (_, nAddress in osm_by_id) {
        var cityName = nAddress->getCity()!!;
        var cityKey = cityName.lowercase();
        if (osm_cities_by_name.get(cityKey) == null) {
            var nCity = node<OsmCity> {
                OsmCity {
                    name: cityName,
                    streets_by_name: nodeIndex<String, node<OsmStreet>> {},
                }
            };
            nCity->indexing(nCity);
        }
    }

    for (_, nAddress in osm_by_id) {
        var cityKey = nAddress->getCity()!!.lowercase();
        var streetName = nAddress->getStreet()!!;
        var streetKey = streetName.lowercase();
        var nCity = osm_cities_by_name.get(cityKey)!!;
        if (nCity->streets_by_name.get(streetKey) == null) {
            var nStreet = node<OsmStreet> {
                OsmStreet {
                    name: streetName,
                    city: nCity,
                    addresses_by_id: nodeIndex<String, node<OsmAddress>> {},
                    addresses_by_number: nodeIndex<String, node<OsmAddress>> {},
                }
            };
            nStreet->indexing(nStreet);
        }
    }

    for (_, nAddress in osm_by_id) {
        var cityKey = nAddress->getCity()!!.lowercase();
        var streetKey = nAddress->getStreet()!!.lowercase();
        var nStreet = osm_cities_by_name.get(cityKey)!!->streets_by_name.get(streetKey)!!;
        nStreet->addresses_by_id.set("${nAddress->id}", nAddress);
        nStreet->addresses_by_number.set(nAddress->number, nAddress);
    }

    for (_, v in osm_streets_by_name) {
        for (_, s in v) {
            for (_, a in s->addresses_by_id) {
                a->streetRef = s;
            }
        }
    }

    info("OSM indexes populated");
}

@permission("admin")
@expose
fn tmpFillIndex() {
    for (key, value in golden_pois_by_id) {
        golden_records_geo_recompute.add(value);
    }
}

@permission("admin")
@expose
fn tmpFillScore() {
    for (_, s in sources_by_name) {
        for (r, c in s->reconciliationReport->linked) {
            if (c.detailedScore == null) {
                var reconScore: node<ReconciliationCandidateScore>;
                if (c.score == null) {
                    reconScore = node<ReconciliationCandidateScore> {
                        ReconciliationCandidateScore { cityScore: 1.0, numberScore: 1.0, overallScore: 1.0, postcodeScore: 1.0, streetScore: 1.0 }
                    };
                } else {
                    reconScore = node<ReconciliationCandidateScore> { clone(c.score) };
                }
                c.detailedScore = reconScore;
                for (_, l in (c.candidateRecord as node<GoldenPointOfInterest>)->linkedRecords) {
                    if (l.record == r) {
                        l.detailedScore = reconScore;
                    }
                }
            }
        }
    }
}

